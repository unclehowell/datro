INSERT INTO messages_fts VALUES ('m-8bf656e1d279','Automatic reply: Great House Farm, Llandough','Thank you for contacting HM Land Registry. This is an automated response to confirm that we have received your correspondence. We aim to formally provide an acknowledgement within three working days. If you have any special requirements that mean you would like us to communicate with you in a specific way, please let us know and we will make adjustments if we can.

