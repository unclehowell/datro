INSERT INTO messages VALUES ('m-862ef2aa9858','mod','2026-10-10T19:14:00Z','sent','FOI2026/09019 — clarification of the non-Special-Forces remainder and existing retention/search records','Dear Ministry of Defence FOI Team,

