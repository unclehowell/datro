INSERT INTO qa VALUES ('qa-2b0a6bd71225','hmlr','HM Land Registry','hm-land-registry-email-correspondence-catalogue#t2','2026-02-05','*Unresolved Ownership Claims:* In 1982, there was an active, adjourned ownership dispute (from 1974) that I believe should have been disclosed to the Land Registry before a clean title was granted to BP Properties Ltd.

