INSERT INTO messages VALUES ('m-4c4229d721bd','swp','2026-05-14T08:36:00Z','received','Our Reference: LPB/26/0781','Dear Mr Buckler,

Thank you for your e-mail received 10 May 2026, addressed to the South Wales Police and Crime Commissioner.

