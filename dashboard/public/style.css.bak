:root {
    --bg-dark: #0f172a;
    --bg-card: #1e293b;
    --bg-panel: #111827;
    --text-main: #f8fafc;
    --text-dim: #94a3b8;
    --primary: #3b82f6;
    --secondary: #6366f1;
    --success: #22c55e;
    --error: #ef4444;
    --border: #334155;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: var(--bg-dark);
    color: var(--text-main);
    display: flex;
    flex-direction: column;
    height: 100vh;
    overflow: hidden;
}

header {
    background-color: var(--bg-panel);
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border);
}

header h1 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--primary);
}

#status-bar span {
    font-size: 0.875rem;
    margin-left: 1rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    background-color: var(--bg-card);
}

main {
    flex: 1;
    display: grid;
    grid-template-columns: 250px 1fr 1fr;
    gap: 1.5rem;
    padding: 1.5rem;
    overflow: hidden;
}

#stats-panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.card {
    background-color: var(--bg-card);
    padding: 1rem;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
}

.card h3 {
    font-size: 0.875rem;
    color: var(--text-dim);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

#release-counts {
    font-size: 0.875rem;
    line-height: 1.5;
}

#content-panel {
    grid-column: span 2;
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 1.5rem;
    overflow: hidden;
}

.panel {
    background-color: var(--bg-panel);
    border-radius: 0.5rem;
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
}

.panel-header {
    padding: 0.75rem 1rem;
    background-color: rgba(255,255,255,0.05);
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border);
}

#log-content {
    flex: 1;
    padding: 1rem;
    font-family: 'Fira Code', 'Courier New', monospace;
    font-size: 0.75rem;
    color: var(--text-dim);
    overflow-y: auto;
    white-space: pre-wrap;
    background-color: #000;
}

#editor-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1rem;
    gap: 0.75rem;
    min-height: 200px;
}

#plan-editor {
    flex: 1;
    background-color: #000;
    color: var(--text-main);
    border: 1px solid var(--border);
    padding: 1rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    resize: none;
    outline: none;
    line-height: 1.5;
}

.btn {
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: all 0.2s;
    font-size: 0.875rem;
}

.btn.primary { background-color: var(--primary); color: white; }
.btn.secondary { background-color: var(--secondary); color: white; }
.btn.success { background-color: var(--success); color: white; }
.btn.error { background-color: var(--error); color: white; }
.btn.small { padding: 0.25rem 0.5rem; font-size: 0.75rem; }

.btn:hover:not(:disabled) { filter: brightness(1.1); }
.btn:active:not(:disabled) { transform: translateY(1px); }
.btn:disabled { opacity: 0.5; cursor: not-allowed; }

.button-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

select {
    background-color: var(--bg-card);
    color: var(--text-main);
    border: 1px solid var(--border);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
}

footer {
    padding: 0.5rem 2rem;
    font-size: 0.75rem;
    color: var(--text-dim);
    text-align: center;
    border-top: 1px solid var(--border);
}
