# Phone Compute Proxy Configuration
# Source this to offload LLM calls to phone

export PHONE_PROXY_URL="${PHONE_PROXY_URL:-https://phone-proxy.financecheque.uk}"
export ROUTE_PREFERRED="phone"
export LOCAL_FALLBACK=true

# API endpoints for phone proxy
export PHONE_CHAT_ENDPOINT="${PHONE_PROXY_URL}/v1/chat/completions"
export PHONE_PROXY_ENDPOINT="${PHONE_PROXY_URL}/api/proxy"

# Fallback list (phone first)
export COMPUTE_ENDPOINTS="${PHONE_CHAT_ENDPOINT},https://pirateclaw.datro.xyz/v1/chat/completions,http://localhost:6000/v1/chat/completions"

# Port for local child proxy (if phone offline)
export CHILD_PORT="${CHILD_PORT:-4001}"
export CHILD_ID="${CHILD_ID:-laptop-$(hostname)}"