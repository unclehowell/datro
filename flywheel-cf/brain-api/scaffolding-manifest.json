        "honchoWorkspace": "datro-flywheel-brain",
        "model": "openrouter/anthropic/claude-sonnet",
        "defaultTools": [
          "read_file",
          "write_file", 
          "search_code",
          "honcho_memory",
          "list_memories",
          "flywheel_config",
          "brain_recall",
          "brain_remember"
        ]
      }
    },
    "command": {
      "purpose": "Command Cockpit / Jarvis — centralized agent orchestration and task dispatch.",
      "category": "platform",
      "scaffolding": {
        "memoryEndpoint": "https://cnei.datro.xyz/api/brain/memory/command",
        "lessonsEndpoint": "https://cnei.datro.xyz/api/brain/lessons/command", 
        "honchoWorkspace": "datro-flywheel-brain",
        "model": "gpt-4o",
        "defaultTools": [
          "read_file",
          "write_file",
          "search_code",
          "run_agent",
          "dispatch_task",
          "brain_recall",
          "brain_remember"
        ]
      }
    },
    "financecheque": {
      "purpose": "Financial services dashboard with web3 payment UX, transaction tracking, and account management.",
