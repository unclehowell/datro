      "scaffolding": {
        "memoryEndpoint": "https://cnei.datro.xyz/api/brain/memory/financecheque",
        "lessonsEndpoint": "https://cnei.datro.xyz/api/brain/lessons/financecheque",
        "honchoWorkspace": "oSx32NCcWFHT7gRXWtrGo",
        "model": "gpt-4o-mini",
        "defaultTools": [
          "read_file",
          "write_file",
          "search_code",
          "web3_check",
          "transaction_analyze",
          "brain_recall",
          "brain_remember"
        ]
      }
    }
