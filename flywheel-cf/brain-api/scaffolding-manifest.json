{
  "schema": "https://cnei.datro.xyz/api/brain/config",
  "version": "1.0.0",
  
  "branches": {
    "cnei": {
      "purpose": "Metadata and dashboard for the flywheel itself. Documents architecture, configuration, and release history of the autonomous release pipeline.",
      "category": "platform",
      "scaffolding": {
        "memoryEndpoint": "https://cnei.datro.xyz/api/brain/memory/cnei",
