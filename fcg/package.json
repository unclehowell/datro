{
  "name": "fcg-wp",
  "version": "0.1.3",
  "private": true,
  "description": "Serverless WP-shaped GraphQL CMS on Cloudflare Workers + D1",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute fcg-wp-d1 --file=./schema.sql --remote",
    "db:init:local": "wrangler d1 execute fcg-wp-d1 --file=./schema.sql --local",
    "test": "node --test src/index.test.cjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
