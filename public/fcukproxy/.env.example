# FCUK Proxy — LLM API Keys for local routing
# Set at least one key to enable local LLM inference.
# The proxy tries providers in order: OpenAI → Anthropic → Gemini → local model.
# Without any keys, queries are forwarded to the parent proxy.

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# MISTRAL_API_KEY=...
# GROQ_API_KEY=gsk_...
# TOGETHER_API_KEY=...
# DEEPSEEK_API_KEY=...
# PERPLEXITY_API_KEY=...
