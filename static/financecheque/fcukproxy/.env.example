# FCUK Proxy — LLM API Keys for Parent Proxy
# These keys are used by the PARENT PROXY (financecheque.uk) to respond to 
# chat queries from child proxies. Set these in Cloudflare Worker secrets.

# Required: At least one of these keys enables chat responses
# The parent proxy routes chat-only queries to these providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
MISTRAL_API_KEY=...
GROQ_API_KEY=gsk_...
TOGETHER_API_KEY=...
DEEPSEEK_API_KEY=...
PERPLEXITY_API_KEY=...

# Optional: Local LLM endpoints (for child proxy fallback)
LOCAL_LLM_ENDPOINT=http://localhost:6000/v1/chat/completions
LOCAL_OLLAMA=http://localhost:11434/api/chat

# Agent Role Configuration
AGENT_ROLE=chat  # Default role for child proxies
# AGENT_ROLE=agent  # Set for phone/compute offload nodes