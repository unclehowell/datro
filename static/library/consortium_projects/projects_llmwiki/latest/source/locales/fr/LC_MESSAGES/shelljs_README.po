msgid "test(expression)"
msgstr ""

#: ../../source/shelljs_README.md:596
msgid "Available expression primaries:"
msgstr ""

#: ../../source/shelljs_README.md:598
msgid "`'-b', 'path'`: true if path is a block device"
msgstr ""

#: ../../source/shelljs_README.md:599
msgid "`'-c', 'path'`: true if path is a character device"
msgstr ""

#: ../../source/shelljs_README.md:600
msgid "`'-d', 'path'`: true if path is a directory"
msgstr ""

#: ../../source/shelljs_README.md:601
msgid "`'-e', 'path'`: true if path exists"
msgstr ""

#: ../../source/shelljs_README.md:602
msgid "`'-f', 'path'`: true if path is a regular file"
msgstr ""

#: ../../source/shelljs_README.md:603
msgid "`'-L', 'path'`: true if path is a symbolic link"
msgstr ""

#: ../../source/shelljs_README.md:604
msgid "`'-p', 'path'`: true if path is a pipe (FIFO)"
msgstr ""

#: ../../source/shelljs_README.md:605
msgid "`'-S', 'path'`: true if path is a socket"
