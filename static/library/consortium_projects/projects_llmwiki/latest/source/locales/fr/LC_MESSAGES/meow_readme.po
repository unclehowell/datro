msgid "Converts flags to [camelCase](https://github.com/sindresorhus/camelcase)"
msgstr ""

#: ../../source/meow_readme.md:12
msgid "Outputs version when `--version`"
msgstr ""

#: ../../source/meow_readme.md:13
