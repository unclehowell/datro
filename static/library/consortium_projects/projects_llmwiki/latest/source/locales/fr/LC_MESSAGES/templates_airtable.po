msgid "**Key Characteristics:**"
msgstr ""

#: ../../source/templates_airtable.md:21
msgid "White canvas with deep navy text (`#181d26`)"
msgstr ""

#: ../../source/templates_airtable.md:22
msgid "Airtable Blue (`#1b61c9`) as primary CTA and link color"
msgstr ""

#: ../../source/templates_airtable.md:23
msgid "Haas + Haas Groot Disp dual font system"
msgstr ""

#: ../../source/templates_airtable.md:24
msgid "Positive letter-spacing on body text (0.08px–0.28px)"
msgstr ""

#: ../../source/templates_airtable.md:25
msgid "12px radius buttons, 16px–32px for cards"
msgstr ""

#: ../../source/templates_airtable.md:26
