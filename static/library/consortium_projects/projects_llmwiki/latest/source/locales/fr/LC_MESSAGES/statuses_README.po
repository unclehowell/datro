msgstr ""

#: ../../source/statuses_README.md:30
msgid "API"
msgstr ""

#: ../../source/statuses_README.md:38
msgid "status(code)"
msgstr ""

#: ../../source/statuses_README.md:40
msgid ""
"Returns the status message string for a known HTTP status code. The code "
"may be a number or a string. An error is thrown for an unknown status "
"code."
msgstr ""

#: ../../source/statuses_README.md:51
msgid "status(msg)"
msgstr ""

#: ../../source/statuses_README.md:53
msgid ""
"Returns the numeric status code for a known HTTP status message. The "
"message is case-insensitive. An error is thrown for an unknown status "
"message."
msgstr ""

#: ../../source/statuses_README.md:64
msgid "status.codes"
msgstr ""

#: ../../source/statuses_README.md:66
msgid "Returns an array of all the status codes as `Integer`s."
msgstr ""

#: ../../source/statuses_README.md:68
msgid "status.code[msg]"
msgstr ""

#: ../../source/statuses_README.md:70
msgid ""
"Returns the numeric status code for a known status message (in lower-"
"case), otherwise `undefined`."
msgstr ""

#: ../../source/statuses_README.md:79
msgid "status.empty[code]"
msgstr ""

#: ../../source/statuses_README.md:81
msgid "Returns `true` if a status code expects an empty body."
msgstr ""

#: ../../source/statuses_README.md:91
msgid "status.message[code]"
msgstr ""

#: ../../source/statuses_README.md:93
msgid ""
"Returns the string message for a known numeric status code, otherwise "
"`undefined`. This object is the same format as the [Node.js http module "
"`http.STATUS_CODES`](https://nodejs.org/dist/latest/docs/api/http.html#http_http_status_codes)."
msgstr ""

#: ../../source/statuses_README.md:103
msgid "status.redirect[code]"
msgstr ""

#: ../../source/statuses_README.md:105
msgid "Returns `true` if a status code is a valid redirect status."
msgstr ""

#: ../../source/statuses_README.md:114
msgid "status.retry[code]"
msgstr ""

#: ../../source/statuses_README.md:116
msgid "Returns `true` if you should retry the rest."
msgstr ""

