#: ../../source/expand-brackets_README.md:191
msgid "POSIX Character classes"
msgstr ""

#: ../../source/expand-brackets_README.md:193
msgid "The following named POSIX bracket expressions are supported:"
msgstr ""

#: ../../source/expand-brackets_README.md:195
msgid "`[:alnum:]`: Alphanumeric characters (`a-zA-Z0-9]`)"
msgstr ""

#: ../../source/expand-brackets_README.md:196
msgid "`[:alpha:]`: Alphabetic characters (`a-zA-Z]`)"
msgstr ""

#: ../../source/expand-brackets_README.md:197
msgid "`[:blank:]`: Space and tab (`[ t]`)"
msgstr ""

#: ../../source/expand-brackets_README.md:198
msgid "`[:digit:]`: Digits (`[0-9]`)"
msgstr ""

#: ../../source/expand-brackets_README.md:199
msgid "`[:lower:]`: Lowercase letters (`[a-z]`)"
msgstr ""

#: ../../source/expand-brackets_README.md:200
#, python-brace-format
msgid ""
"`[:punct:]`: Punctuation and symbols. (`[!\"#$%&'()*+, -./:;<=>?@ "
"[\\]^_``{|}~]`)"
msgstr ""

#: ../../source/expand-brackets_README.md:201
msgid "`[:upper:]`: Uppercase letters (`[A-Z]`)"
msgstr ""

#: ../../source/expand-brackets_README.md:202
msgid ""
"`[:word:]`: Word characters (letters, numbers and underscores) "
"(`[A-Za-z0-9_]`)"
msgstr ""

#: ../../source/expand-brackets_README.md:203
msgid "`[:xdigit:]`: Hexadecimal digits (`[A-Fa-f0-9]`)"
msgstr ""

#: ../../source/expand-brackets_README.md:205
msgid ""
"See [posix-character-classes](https://github.com/jonschlinkert/posix-"
"character-classes) for more details."
msgstr ""

#: ../../source/expand-brackets_README.md:207
msgid "**Not supported**"
msgstr ""

#: ../../source/expand-brackets_README.md:209
msgid ""
"[equivalence classes](https://www.gnu.org/software/gawk/manual/html_node"
"/Bracket-Expressions.html) are not supported"
msgstr ""

#: ../../source/expand-brackets_README.md:210
msgid ""
"[POSIX.2 collating "
"symbols](https://www.gnu.org/software/gawk/manual/html_node/Bracket-"
"Expressions.html) are not supported"
msgstr ""

