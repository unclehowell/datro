#: ../../source/accepts_README.md:36
msgid "accepts(req)"
msgstr ""

#: ../../source/accepts_README.md:38
msgid "Create a new `Accepts` object for the given `req`."
msgstr ""

#: ../../source/accepts_README.md:40
msgid ".charset(charsets)"
msgstr ""

#: ../../source/accepts_README.md:42
msgid ""
"Return the first accepted charset. If nothing in `charsets` is accepted, "
"then `false` is returned."
msgstr ""

#: ../../source/accepts_README.md:45
msgid ".charsets()"
msgstr ""

#: ../../source/accepts_README.md:47
msgid ""
"Return the charsets that the request accepts, in the order of the "
"client's preference (most preferred first)."
msgstr ""

#: ../../source/accepts_README.md:50
msgid ".encoding(encodings)"
msgstr ""

#: ../../source/accepts_README.md:52
msgid ""
"Return the first accepted encoding. If nothing in `encodings` is "
"accepted, then `false` is returned."
msgstr ""

#: ../../source/accepts_README.md:55
msgid ".encodings()"
msgstr ""

#: ../../source/accepts_README.md:57
msgid ""
"Return the encodings that the request accepts, in the order of the "
"client's preference (most preferred first)."
msgstr ""

#: ../../source/accepts_README.md:60
msgid ".language(languages)"
msgstr ""

#: ../../source/accepts_README.md:62
msgid ""
"Return the first accepted language. If nothing in `languages` is "
"accepted, then `false` is returned."
msgstr ""

#: ../../source/accepts_README.md:65
msgid ".languages()"
msgstr ""

#: ../../source/accepts_README.md:67
msgid ""
"Return the languages that the request accepts, in the order of the "
"client's preference (most preferred first)."
msgstr ""

#: ../../source/accepts_README.md:70
msgid ".type(types)"
msgstr ""

#: ../../source/accepts_README.md:72
msgid ""
"Return the first accepted type (and it is returned as the same text as "
"what appears in the `types` array). If nothing in `types` is accepted, "
"then `false` is returned."
msgstr ""

#: ../../source/accepts_README.md:76
msgid ""
"The `types` array can contain full MIME types or file extensions. Any "
"value that is not a full MIME types is passed to `require('mime-"
"types').lookup`."
msgstr ""

#: ../../source/accepts_README.md:79
msgid ".types()"
msgstr ""

#: ../../source/accepts_README.md:81
msgid ""
"Return the types that the request accepts, in the order of the client's "
"preference (most preferred first)."
msgstr ""

