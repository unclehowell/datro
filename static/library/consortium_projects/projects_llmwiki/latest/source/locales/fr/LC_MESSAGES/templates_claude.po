#: ../../source/templates_claude.md:221
msgid "Comfortably rounded (8–8.5px): Standard buttons, cards, containers"
msgstr ""

#: ../../source/templates_claude.md:222
msgid "Generously rounded (12px): Primary buttons, input fields, nav elements"
