msgstr ""

#: ../../source/websocket-extensions_CHANGELOG.md:3
msgid ""
"Remove a ReDoS vulnerability in the header parser (CVE-2020-7662, "
"reported by Robert McLaughlin)"
msgstr ""

#: ../../source/websocket-extensions_CHANGELOG.md:5
msgid "Change license from MIT to Apache 2.0"
msgstr ""

#: ../../source/websocket-extensions_CHANGELOG.md:7
msgid "0.1.3 / 2017-11-11"
msgstr ""

#: ../../source/websocket-extensions_CHANGELOG.md:9
msgid "Accept extension names and parameters including uppercase letters"
msgstr ""

#: ../../source/websocket-extensions_CHANGELOG.md:10
msgid "Handle extension names that clash with `Object.prototype` properties"
msgstr ""

#: ../../source/websocket-extensions_CHANGELOG.md:12
msgid "0.1.2 / 2017-09-10"
msgstr ""

#: ../../source/websocket-extensions_CHANGELOG.md:14
msgid "Catch synchronous exceptions thrown when calling an extension"
msgstr ""

#: ../../source/websocket-extensions_CHANGELOG.md:15
msgid ""
"Fix race condition caused when a message is pushed after a cell has "
"stopped due to an error"
msgstr ""

#: ../../source/websocket-extensions_CHANGELOG.md:17
msgid ""
"Fix failure of `close()` to return if a message that's queued after one "
"that produces an error never finishes being processed"
msgstr ""

#: ../../source/websocket-extensions_CHANGELOG.md:20
msgid "0.1.1 / 2015-02-19"
msgstr ""

#: ../../source/websocket-extensions_CHANGELOG.md:22
msgid ""
"Prevent sessions being closed before they have finished processing "
"messages"
msgstr ""

#: ../../source/websocket-extensions_CHANGELOG.md:23
msgid ""
"Add a callback to `Extensions.close()` so the caller can tell when it's "
"safe to close the socket"
msgstr ""

#: ../../source/websocket-extensions_CHANGELOG.md:26
