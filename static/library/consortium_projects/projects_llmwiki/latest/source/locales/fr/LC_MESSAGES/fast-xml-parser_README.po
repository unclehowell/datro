#: ../../source/fast-xml-parser_README.md:94
msgid ""
"unpaired tags (Eg `<br>` in HTML), stop nodes (Eg `<script>` in HTML) are"
" supported."
msgstr ""

#: ../../source/fast-xml-parser_README.md:95
msgid "You can restore almost same XML from JSON"
msgstr ""

#: ../../source/fast-xml-parser_README.md:96
msgid "Supports comments"
msgstr ""

#: ../../source/fast-xml-parser_README.md:97
msgid "It can preserve Order of tags in JS object"
msgstr ""

#: ../../source/fast-xml-parser_README.md:98
msgid "You can control if a single tag should be parsed into array."
msgstr ""

#: ../../source/fast-xml-parser_README.md:99
msgid ""
"Supports parsing of PI (Processing Instruction) tags with XML declaration"
" tags"
msgstr ""

