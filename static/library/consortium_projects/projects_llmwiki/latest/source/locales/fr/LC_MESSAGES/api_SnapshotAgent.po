msgstr ""

#: ../../source/api_SnapshotAgent.md:29
msgid ""
"**matchBody** `Boolean` - Whether to include request body in matching. "
"Default: `true`"
msgstr ""

#: ../../source/api_SnapshotAgent.md:30
msgid ""
"**matchQuery** `Boolean` - Whether to include query parameters in "
"matching. Default: `true`"
msgstr ""

#: ../../source/api_SnapshotAgent.md:31
msgid ""
"**caseSensitive** `Boolean` - Whether header matching is case-sensitive. "
"Default: `false`"
msgstr ""

#: ../../source/api_SnapshotAgent.md:32
msgid ""
"**shouldRecord** `Function` - Callback to determine if a request should "
"be recorded"
msgstr ""

#: ../../source/api_SnapshotAgent.md:33
msgid ""
"**shouldPlayback** `Function` - Callback to determine if a request should"
" be played back"
msgstr ""

#: ../../source/api_SnapshotAgent.md:34
msgid ""
"**excludeUrls** `Array` - URL patterns (strings or RegExp) to exclude "
"from recording/playback"
msgstr ""

