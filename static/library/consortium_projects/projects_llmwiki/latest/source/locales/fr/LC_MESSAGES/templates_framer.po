#: ../../source/templates_framer.md:218
msgid "Touch Targets"
msgstr ""

#: ../../source/templates_framer.md:219
msgid ""
"Pill buttons: minimum 40px height with 10px vertical padding — exceeds "
"44px WCAG minimum"
msgstr ""

#: ../../source/templates_framer.md:220
msgid "Nav links: 15px text with generous padding for touch accessibility"
msgstr ""

#: ../../source/templates_framer.md:221
msgid "Mobile CTA buttons: Full-width pills on mobile for easy thumb reach"
msgstr ""

#: ../../source/templates_framer.md:223
msgid "Collapsing Strategy"
msgstr ""

#: ../../source/templates_framer.md:224
msgid "**Navigation**: Full horizontal nav → hamburger menu at mobile breakpoint"
msgstr ""

#: ../../source/templates_framer.md:225
msgid ""
"**Hero text**: 110px display → 85px → 62px → ~40px across breakpoints, "
"maintaining extreme negative tracking proportionally"
msgstr ""

#: ../../source/templates_framer.md:226
msgid ""
"**Feature sections**: Side-by-side (text + screenshot) → stacked "
"vertically on mobile"
msgstr ""

#: ../../source/templates_framer.md:227
msgid ""
"**Product screenshots**: Scale responsively within containers, "
"maintaining aspect ratios"
msgstr ""

#: ../../source/templates_framer.md:228
msgid "**Section spacing**: Reduces proportionally — 120px desktop → 60px mobile"
msgstr ""

#: ../../source/templates_framer.md:230
msgid "Image Behavior"
msgstr ""

#: ../../source/templates_framer.md:231
msgid ""
"Product screenshots are responsive, scaling within their container "
"boundaries"
msgstr ""

#: ../../source/templates_framer.md:232
msgid "No art direction changes — same crops across breakpoints"
msgstr ""

#: ../../source/templates_framer.md:233
msgid "Dark background ensures screenshots maintain visual impact at any size"
msgstr ""

#: ../../source/templates_framer.md:234
msgid "Screenshots lazy-load as user scrolls into view"
msgstr ""

