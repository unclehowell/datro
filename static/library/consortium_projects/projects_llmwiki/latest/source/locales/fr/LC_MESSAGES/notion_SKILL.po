#: ../../source/notion_SKILL.md:143
msgid "Common property formats for database items:"
msgstr ""

#: ../../source/notion_SKILL.md:145
#, python-brace-format
msgid "**Title:** `{\"title\": [{\"text\": {\"content\": \"...\"}}]}`"
msgstr ""

#: ../../source/notion_SKILL.md:146
#, python-brace-format
msgid "**Rich text:** `{\"rich_text\": [{\"text\": {\"content\": \"...\"}}]}`"
msgstr ""

#: ../../source/notion_SKILL.md:147
#, python-brace-format
msgid "**Select:** `{\"select\": {\"name\": \"Option\"}}`"
msgstr ""

#: ../../source/notion_SKILL.md:148
#, python-brace-format
msgid ""
"**Multi-select:** `{\"multi_select\": [{\"name\": \"A\"}, {\"name\": "
"\"B\"}]}`"
msgstr ""

#: ../../source/notion_SKILL.md:149
#, python-brace-format
msgid ""
"**Date:** `{\"date\": {\"start\": \"2026-01-15\", \"end\": "
"\"2026-01-16\"}}`"
msgstr ""

#: ../../source/notion_SKILL.md:150
#, python-brace-format
msgid "**Checkbox:** `{\"checkbox\": true}`"
msgstr ""

#: ../../source/notion_SKILL.md:151
#, python-brace-format
msgid "**Number:** `{\"number\": 42}`"
msgstr ""

#: ../../source/notion_SKILL.md:152
#, python-brace-format
msgid "**URL:** `{\"url\": \"https://...\"}`"
msgstr ""

#: ../../source/notion_SKILL.md:153
#, python-brace-format
msgid "**Email:** `{\"email\": \"user@example.com\"}`"
msgstr ""

#: ../../source/notion_SKILL.md:154
#, python-brace-format
msgid "**Relation:** `{\"relation\": [{\"id\": \"page_id\"}]}`"
msgstr ""

#: ../../source/notion_SKILL.md:156
msgid "Key Differences in API Version 2025-09-03"
msgstr ""

#: ../../source/notion_SKILL.md:158
msgid ""
"**Databases → Data Sources:** Use `/data_sources/` endpoints for queries "
"and retrieval"
msgstr ""

#: ../../source/notion_SKILL.md:159
msgid "**Two IDs:** Each database has both a `database_id` and a `data_source_id`"
msgstr ""

#: ../../source/notion_SKILL.md:160
#, python-brace-format
msgid ""
"Use `database_id` when creating pages (`parent: {\"database_id\": "
"\"...\"}`)"
msgstr ""

#: ../../source/notion_SKILL.md:161
#, python-brace-format
msgid "Use `data_source_id` when querying (`POST /v1/data_sources/{id}/query`)"
msgstr ""

#: ../../source/notion_SKILL.md:162
msgid ""
"**Search results:** Databases return as `\"object\": \"data_source\"` "
"with their `data_source_id`"
msgstr ""

#: ../../source/notion_SKILL.md:164
msgid "Notes"
msgstr ""

#: ../../source/notion_SKILL.md:166
msgid "Page/database IDs are UUIDs (with or without dashes)"
msgstr ""

#: ../../source/notion_SKILL.md:167
msgid "Rate limit: ~3 requests/second average"
msgstr ""

#: ../../source/notion_SKILL.md:168
msgid "The API cannot set database view filters — that's UI-only"
msgstr ""

#: ../../source/notion_SKILL.md:169
msgid "Use `is_inline: true` when creating data sources to embed them in pages"
msgstr ""

#: ../../source/notion_SKILL.md:170
msgid ""
"Add `-s` flag to curl to suppress progress bars (cleaner output for "
"Hermes)"
msgstr ""

#: ../../source/notion_SKILL.md:171
msgid ""
"Pipe output through `jq` for readable JSON: `... | jq "
"'.results[0].properties'`"
msgstr ""

