#: ../../source/tmux_SKILL.md:7
msgid "tmux Skill"
msgstr ""

#: ../../source/tmux_SKILL.md:9
msgid ""
"Use tmux only when you need an interactive TTY. Prefer exec background "
"mode for long-running, non-interactive tasks."
msgstr ""

#: ../../source/tmux_SKILL.md:11
msgid "Quickstart (isolated socket, exec tool)"
msgstr ""

#: ../../source/tmux_SKILL.md:24
msgid "After starting a session, always print monitor commands:"
msgstr ""

#: ../../source/tmux_SKILL.md:32
msgid "Socket convention"
msgstr ""

#: ../../source/tmux_SKILL.md:34
msgid "Use `NANOBOT_TMUX_SOCKET_DIR` environment variable."
msgstr ""

#: ../../source/tmux_SKILL.md:35
msgid "Default socket path: `\"$NANOBOT_TMUX_SOCKET_DIR/nanobot.sock\"`."
msgstr ""

#: ../../source/tmux_SKILL.md:37
msgid "Targeting panes and naming"
msgstr ""

#: ../../source/tmux_SKILL.md:39
msgid "Target format: `session:window.pane` (defaults to `:0.0`)."
msgstr ""

#: ../../source/tmux_SKILL.md:40
msgid "Keep names short; avoid spaces."
msgstr ""

#: ../../source/tmux_SKILL.md:41
msgid ""
"Inspect: `tmux -S \"$SOCKET\" list-sessions`, `tmux -S \"$SOCKET\" list-"
"panes -a`."
msgstr ""

#: ../../source/tmux_SKILL.md:43
msgid "Finding sessions"
msgstr ""

#: ../../source/tmux_SKILL.md:45
#, python-brace-format
msgid ""
"List sessions on your socket: `{baseDir}/scripts/find-sessions.sh -S "
"\"$SOCKET\"`."
msgstr ""

#: ../../source/tmux_SKILL.md:46
#, python-brace-format
msgid ""
"Scan all sockets: `{baseDir}/scripts/find-sessions.sh --all` (uses "
"`NANOBOT_TMUX_SOCKET_DIR`)."
msgstr ""

#: ../../source/tmux_SKILL.md:48
msgid "Sending input safely"
msgstr ""

#: ../../source/tmux_SKILL.md:50
msgid ""
"Prefer literal sends: `tmux -S \"$SOCKET\" send-keys -t target -l -- "
"\"$cmd\"`."
msgstr ""

#: ../../source/tmux_SKILL.md:51
msgid "Control keys: `tmux -S \"$SOCKET\" send-keys -t target C-c`."
msgstr ""

#: ../../source/tmux_SKILL.md:53
msgid "Watching output"
msgstr ""

#: ../../source/tmux_SKILL.md:55
msgid ""
"Capture recent history: `tmux -S \"$SOCKET\" capture-pane -p -J -t target"
" -S -200`."
msgstr ""

#: ../../source/tmux_SKILL.md:56
#, python-brace-format
msgid ""
"Wait for prompts: `{baseDir}/scripts/wait-for-text.sh -t session:0.0 -p "
"'pattern'`."
msgstr ""

#: ../../source/tmux_SKILL.md:57
msgid "Attaching is OK; detach with `Ctrl+b d`."
msgstr ""

#: ../../source/tmux_SKILL.md:59
msgid "Spawning processes"
msgstr ""

#: ../../source/tmux_SKILL.md:61
msgid ""
"For python REPLs, set `PYTHON_BASIC_REPL=1` (non-basic REPL breaks send-"
"keys flows)."
msgstr ""

#: ../../source/tmux_SKILL.md:63
msgid "Windows / WSL"
msgstr ""

#: ../../source/tmux_SKILL.md:65
msgid ""
"tmux is supported on macOS/Linux. On Windows, use WSL and install tmux "
"inside WSL."
msgstr ""

#: ../../source/tmux_SKILL.md:66
msgid "This skill is gated to `darwin`/`linux` and requires `tmux` on PATH."
msgstr ""

#: ../../source/tmux_SKILL.md:68
msgid "Orchestrating Coding Agents (Codex, Claude Code)"
msgstr ""

#: ../../source/tmux_SKILL.md:70
msgid "tmux excels at running multiple coding agents in parallel:"
msgstr ""

#: ../../source/tmux_SKILL.md:97
msgid "**Tips:**"
msgstr ""

#: ../../source/tmux_SKILL.md:98
msgid "Use separate git worktrees for parallel fixes (no branch conflicts)"
msgstr ""

#: ../../source/tmux_SKILL.md:99
msgid "`pnpm install` first before running codex in fresh clones"
msgstr ""

#: ../../source/tmux_SKILL.md:100
msgid "Check for shell prompt (`❯` or `$`) to detect completion"
msgstr ""

#: ../../source/tmux_SKILL.md:101
msgid "Codex needs `--yolo` or `--full-auto` for non-interactive fixes"
msgstr ""

#: ../../source/tmux_SKILL.md:103
msgid "Cleanup"
msgstr ""

#: ../../source/tmux_SKILL.md:105
msgid "Kill a session: `tmux -S \"$SOCKET\" kill-session -t \"$SESSION\"`."
msgstr ""

#: ../../source/tmux_SKILL.md:106
#, python-brace-format
msgid ""
"Kill all sessions on a socket: `tmux -S \"$SOCKET\" list-sessions -F "
"'#{session_name}' | xargs -r -n1 tmux -S \"$SOCKET\" kill-session -t`."
msgstr ""

#: ../../source/tmux_SKILL.md:107
msgid ""
"Remove everything on the private socket: `tmux -S \"$SOCKET\" kill-"
"server`."
msgstr ""

#: ../../source/tmux_SKILL.md:109
msgid "Helper: wait-for-text.sh"
msgstr ""

#: ../../source/tmux_SKILL.md:111
#, python-brace-format
msgid ""
"`{baseDir}/scripts/wait-for-text.sh` polls a pane for a regex (or fixed "
"string) with a timeout."
msgstr ""

#: ../../source/tmux_SKILL.md:117
msgid "`-t`/`--target` pane target (required)"
msgstr ""

#: ../../source/tmux_SKILL.md:118
msgid "`-p`/`--pattern` regex to match (required); add `-F` for fixed string"
msgstr ""

#: ../../source/tmux_SKILL.md:119
msgid "`-T` timeout seconds (integer, default 15)"
msgstr ""

#: ../../source/tmux_SKILL.md:120
msgid "`-i` poll interval seconds (default 0.5)"
msgstr ""

#: ../../source/tmux_SKILL.md:121
msgid "`-l` history lines to search (integer, default 1000)"
msgstr ""

