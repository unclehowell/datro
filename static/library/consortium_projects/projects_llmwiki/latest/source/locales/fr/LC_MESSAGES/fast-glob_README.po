#: ../../source/fast-glob_README.md:86
msgid "Pattern syntax"
msgstr ""

#: ../../source/fast-glob_README.md:88
msgid ""
":warning: Always use forward-slashes in glob expressions (patterns and "
"[`ignore`](#ignore) option). Use backslashes for escaping characters."
msgstr ""

#: ../../source/fast-glob_README.md:90
msgid ""
"There is more than one form of syntax: basic and advanced. Below is a "
"brief overview of the supported features. Also pay attention to our "
"[FAQ](#faq)."
msgstr ""

#: ../../source/fast-glob_README.md:92
msgid ""
":book: This package uses [`micromatch`][micromatch] as a library for "
"pattern matching."
msgstr ""

#: ../../source/fast-glob_README.md:94
msgid "Basic syntax"
msgstr ""

#: ../../source/fast-glob_README.md:96
msgid ""
"An asterisk (`*`) — matches everything except slashes (path separators), "
"hidden files (names starting with `.`)."
msgstr ""

#: ../../source/fast-glob_README.md:97
msgid "A double star or globstar (`**`) — matches zero or more directories."
msgstr ""

#: ../../source/fast-glob_README.md:98
msgid ""
"Question mark (`?`) – matches any single character except slashes (path "
"separators)."
msgstr ""

#: ../../source/fast-glob_README.md:99
msgid "Sequence (`[seq]`) — matches any character in sequence."
msgstr ""

#: ../../source/fast-glob_README.md:101
msgid ""
":book: A few additional words about the [basic matching "
"behavior][picomatch_matching_behavior]."
msgstr ""

#: ../../source/fast-glob_README.md:103 ../../source/fast-glob_README.md:120
msgid "Some examples:"
msgstr ""

#: ../../source/fast-glob_README.md:105
msgid ""
"`src/**/*.js` — matches all files in the `src` directory (any level of "
"nesting) that have the `.js` extension."
msgstr ""

#: ../../source/fast-glob_README.md:106
msgid ""
"`src/*.??` — matches all files in the `src` directory (only first level "
"of nesting) that have a two-character extension."
msgstr ""

#: ../../source/fast-glob_README.md:107
msgid "`file-[01].js` — matches files: `file-0.js`, `file-1.js`."
msgstr ""

#: ../../source/fast-glob_README.md:109
msgid "Advanced syntax"
msgstr ""

#: ../../source/fast-glob_README.md:111
msgid ""
"[Escapes characters][micromatch_backslashes] (`\\\\`) — matching special "
"characters (`$^*+?()[]`) as literals."
msgstr ""

#: ../../source/fast-glob_README.md:112
msgid "[POSIX character classes][picomatch_posix_brackets] (`[[:digit:]]`)."
msgstr ""

#: ../../source/fast-glob_README.md:113
msgid "[Extended globs][micromatch_extglobs] (`?(pattern-list)`)."
msgstr ""

#: ../../source/fast-glob_README.md:114
#, python-brace-format
msgid "[Bash style brace expansions][micromatch_braces] (`{}`)."
msgstr ""

#: ../../source/fast-glob_README.md:115
msgid "[Regexp character classes][micromatch_regex_character_classes] (`[1-5]`)."
msgstr ""

#: ../../source/fast-glob_README.md:116
msgid "[Regex groups][regular_expressions_brackets] (`(a|b)`)."
msgstr ""

#: ../../source/fast-glob_README.md:118
msgid ""
":book: A few additional words about the [advanced matching "
"behavior][micromatch_extended_globbing]."
msgstr ""

#: ../../source/fast-glob_README.md:122
#, python-brace-format
msgid ""
"`src/**/*.{css,scss}` — matches all files in the `src` directory (any "
"level of nesting) that have the `.css` or `.scss` extension."
msgstr ""

#: ../../source/fast-glob_README.md:123
msgid ""
"`file-[[:digit:]].js` — matches files: `file-0.js`, `file-1.js`, …, "
"`file-9.js`."
msgstr ""

#: ../../source/fast-glob_README.md:124
#, python-brace-format
msgid "`file-{1..3}.js` — matches files: `file-1.js`, `file-2.js`, `file-3.js`."
msgstr ""

#: ../../source/fast-glob_README.md:125
msgid "`file-(1|2)` — matches files: `file-1.js`, `file-2.js`."
msgstr ""

