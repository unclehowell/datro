msgid "explorer.searchSync()"
msgstr ""

#: ../../source/cosmiconfig_README.md:172
msgid "Synchronous version of [`search()`]."
msgstr ""

#: ../../source/cosmiconfig_README.md:174
msgid "Returns a [result] or `null`."
msgstr ""

