msgid "**< 70%** — Normal operation, full precision"
msgstr ""

#: ../../source/claude-code_SKILL.md:690
msgid "**70-85%** — Precision starts dropping, consider `/compact`"
msgstr ""

#: ../../source/claude-code_SKILL.md:691
msgid ""
"**> 85%** — Hallucination risk spikes significantly, use `/compact` or "
"`/clear`"
msgstr ""

