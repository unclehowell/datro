#: ../../source/references_production-quality.md:76
msgid "A dimmed grid/axes behind the content"
msgstr ""

#: ../../source/references_production-quality.md:77
msgid "A title/subtitle at the top"
msgstr ""

#: ../../source/references_production-quality.md:78
msgid "A source citation at the bottom"
msgstr ""

#: ../../source/references_production-quality.md:79
msgid "Decorative geometry at low opacity"
msgstr ""

#: ../../source/references_production-quality.md:81
msgid "Maximum simultaneous elements"
msgstr ""

#: ../../source/references_production-quality.md:83
msgid ""
"**Hard limit: 6 actively visible elements.** Beyond that, the viewer "
