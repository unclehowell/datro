#: ../../source/references_production-quality.md:86
msgid "Split into two scenes"
msgstr ""

#: ../../source/references_production-quality.md:88
msgid "Animation Quality"
msgstr ""

#: ../../source/references_production-quality.md:90
msgid "Variety audit"
msgstr ""

#: ../../source/references_production-quality.md:92
msgid "Check that no two consecutive scenes use the exact same:"
msgstr ""

#: ../../source/references_production-quality.md:93
msgid ""
"Animation type (if Scene 3 uses Write for everything, Scene 4 should use "
"FadeIn or Create)"
msgstr ""

#: ../../source/references_production-quality.md:94
msgid "Color emphasis (rotate through palette colors)"
msgstr ""

#: ../../source/references_production-quality.md:95
msgid "Layout (center, left-right, grid — alternate)"
msgstr ""

#: ../../source/references_production-quality.md:96
msgid "Pacing (if Scene 2 was slow and deliberate, Scene 3 can be faster)"
msgstr ""

#: ../../source/references_production-quality.md:98
msgid "Tempo curve"
msgstr ""

#: ../../source/references_production-quality.md:100
msgid "A good video follows a tempo curve:"
msgstr ""

#: ../../source/references_production-quality.md:112
msgid "Transition quality"
msgstr ""

#: ../../source/references_production-quality.md:114
msgid "Between scenes:"
msgstr ""

#: ../../source/references_production-quality.md:115
msgid "**Clean exit**: `self.play(FadeOut(Group(*self.mobjects)), run_time=0.5)`"
msgstr ""

#: ../../source/references_production-quality.md:116
msgid ""
"**Brief pause**: `self.wait(0.3)` after fadeout, before next scene's "
"first animation"
msgstr ""

#: ../../source/references_production-quality.md:117
msgid "**Never hard-cut**: always animate the transition"
msgstr ""

#: ../../source/references_production-quality.md:119
msgid "Color Quality"
msgstr ""

#: ../../source/references_production-quality.md:121
msgid "Dimming on dark backgrounds"
msgstr ""

#: ../../source/references_production-quality.md:123
msgid ""
"Colors that look vibrant on white look muddy on dark backgrounds "
"(#0D1117, #1C1C1C). Test your palette:"
msgstr ""

#: ../../source/references_production-quality.md:135
msgid "Color meaning consistency"
msgstr ""

#: ../../source/references_production-quality.md:137
msgid ""
"Once a color is assigned a meaning, it keeps that meaning for the entire "
"video:"
msgstr ""

#: ../../source/references_production-quality.md:145
msgid "Data Visualization Quality"
msgstr ""

#: ../../source/references_production-quality.md:147
msgid "Minimum requirements for charts"
msgstr ""

#: ../../source/references_production-quality.md:149
msgid "Axis labels on every axis"
msgstr ""

#: ../../source/references_production-quality.md:150
msgid "Y-axis range starts at 0 (or has a clear break indicator)"
msgstr ""

#: ../../source/references_production-quality.md:151
msgid "Bar/line colors match the legend"
msgstr ""

#: ../../source/references_production-quality.md:152
msgid ""
"Numbers on notable data points (at least the maximum and the comparison "
"point)"
msgstr ""

#: ../../source/references_production-quality.md:154
msgid "Animated counters"
msgstr ""

#: ../../source/references_production-quality.md:156
msgid "When showing a number changing:"
msgstr ""

#: ../../source/references_production-quality.md:165
msgid "Pre-Render Checklist"
msgstr ""

#: ../../source/references_production-quality.md:167
msgid "Before running `manim -qh`:"
msgstr ""

#: ../../source/references_production-quality.md:169
msgid "[ ] All scenes render without errors at `-ql`"
msgstr ""

#: ../../source/references_production-quality.md:170
msgid "[ ] Preview stills at `-qm` for text-heavy scenes (check kerning)"
msgstr ""

#: ../../source/references_production-quality.md:171
msgid ""
"[ ] Background color set in every scene (`self.camera.background_color = "
"BG`)"
msgstr ""

#: ../../source/references_production-quality.md:172
msgid "[ ] `add_subcaption()` or `subcaption=` on every significant animation"
msgstr ""

#: ../../source/references_production-quality.md:173
msgid "[ ] No text smaller than font_size=18"
msgstr ""

#: ../../source/references_production-quality.md:174
msgid "[ ] No text using proportional fonts (use monospace)"
msgstr ""

#: ../../source/references_production-quality.md:175
msgid "[ ] buff >= 0.5 on all `.to_edge()` calls"
msgstr ""

#: ../../source/references_production-quality.md:176
msgid "[ ] Clean exit (FadeOut all) at end of every scene"
msgstr ""

#: ../../source/references_production-quality.md:177
msgid "[ ] `self.wait()` after every reveal"
msgstr ""

#: ../../source/references_production-quality.md:178
msgid "[ ] Color constants used (no hardcoded hex strings in scene code)"
msgstr ""

#: ../../source/references_production-quality.md:179
msgid "[ ] All scenes use the same quality flag (don't mix `-ql` and `-qh`)"
msgstr ""

#: ../../source/references_production-quality.md:181
msgid "Post-Render Checklist"
msgstr ""

#: ../../source/references_production-quality.md:183
msgid "After stitching the final video:"
msgstr ""

#: ../../source/references_production-quality.md:185
msgid "[ ] Watch the complete video at 1x speed — does it feel rushed anywhere?"
msgstr ""

#: ../../source/references_production-quality.md:186
msgid ""
"[ ] Is there a moment where two things animate simultaneously and it's "
"confusing?"
msgstr ""

#: ../../source/references_production-quality.md:187
msgid "[ ] Does every text label have enough time to be read?"
msgstr ""

#: ../../source/references_production-quality.md:188
msgid ""
"[ ] Are transitions between scenes smooth (no black frames, no jarring "
"cuts)?"
msgstr ""

#: ../../source/references_production-quality.md:189
msgid "[ ] Is the audio in sync with the visuals (if using voiceover)?"
msgstr ""

#: ../../source/references_production-quality.md:190
msgid ""
"[ ] Is the Gibbs-like \"first impression\" good? The first 5 seconds "
"determine if someone keeps watching"
msgstr ""

