msgstr ""

#: ../../source/find-nearby_SKILL.md:13
msgid ""
"Find restaurants, cafes, bars, pharmacies, and other places near any "
"location. Uses OpenStreetMap (free, no API keys). Works with:"
msgstr ""

#: ../../source/find-nearby_SKILL.md:15
msgid ""
"**Coordinates** from Telegram location pins (latitude/longitude in "
"conversation)"
msgstr ""

#: ../../source/find-nearby_SKILL.md:16
msgid "**Addresses** (\"near 123 Main St, Springfield\")"
msgstr ""

#: ../../source/find-nearby_SKILL.md:17
