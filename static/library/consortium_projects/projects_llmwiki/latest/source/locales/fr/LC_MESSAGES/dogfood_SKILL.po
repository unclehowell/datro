msgstr ""

#: ../../source/dogfood_SKILL.md:80
msgid "Scroll through content: `browser_scroll(direction=\"down\")`"
msgstr ""

#: ../../source/dogfood_SKILL.md:81
msgid "Test form validation with invalid inputs"
msgstr ""

#: ../../source/dogfood_SKILL.md:82
msgid "Test empty submissions"
msgstr ""

#: ../../source/dogfood_SKILL.md:84
msgid "**After each interaction**, check for:"
msgstr ""

#: ../../source/dogfood_SKILL.md:85
msgid "Console errors: `browser_console()`"
msgstr ""

#: ../../source/dogfood_SKILL.md:86
msgid ""
"Visual changes: `browser_vision(question=\"What changed after the "
"interaction?\")`"
msgstr ""

