msgid "Phase 1: Plan"
msgstr ""

#: ../../source/dogfood_SKILL.md:36
msgid "Create the output directory structure:"
msgstr ""

#: ../../source/dogfood_SKILL.md:42
msgid "Identify the testing scope based on user input."
msgstr ""

#: ../../source/dogfood_SKILL.md:43
msgid "Build a rough sitemap by planning which pages and features to test:"
msgstr ""

#: ../../source/dogfood_SKILL.md:44
msgid "Landing/home page"
msgstr ""

#: ../../source/dogfood_SKILL.md:45
msgid "Navigation links (header, footer, sidebar)"
msgstr ""

#: ../../source/dogfood_SKILL.md:46
msgid "Key user flows (sign up, login, search, checkout, etc.)"
msgstr ""

#: ../../source/dogfood_SKILL.md:47
msgid "Forms and interactive elements"
msgstr ""

#: ../../source/dogfood_SKILL.md:48
msgid "Edge cases (empty states, error pages, 404s)"
msgstr ""

