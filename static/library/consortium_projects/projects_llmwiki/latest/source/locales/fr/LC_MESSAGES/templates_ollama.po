msgid "Don't"
msgstr ""

#: ../../source/templates_ollama.md:216
msgid ""
"Don't introduce any chromatic color — no brand blue, no accent green, no "
"warm tones"
msgstr ""

#: ../../source/templates_ollama.md:217
msgid "Don't use border-radius between 12px and 9999px — the system is binary"
msgstr ""

#: ../../source/templates_ollama.md:218
msgid "Don't add shadows to any element — the flat aesthetic is intentional"
msgstr ""

#: ../../source/templates_ollama.md:219
msgid "Don't use font weights above 500 — no bold, no black weight"
msgstr ""

#: ../../source/templates_ollama.md:220
msgid "Don't add decorative illustrations beyond the llama mascot"
msgstr ""

#: ../../source/templates_ollama.md:221
msgid "Don't use gradients anywhere — flat blocks and borders only"
msgstr ""

#: ../../source/templates_ollama.md:222
msgid "Don't overcomplicate the layout — two columns maximum, no complex grids"
msgstr ""

#: ../../source/templates_ollama.md:223
msgid ""
"Don't use borders heavier than 1px — containment is always the lightest "
"possible touch"
msgstr ""

#: ../../source/templates_ollama.md:224
msgid ""
"Don't add hover animations or transitions — interactions should feel "
"instant and direct"
