#: ../../source/globby_readme.md:151
msgid "`*` matches any number of characters, but not `/`"
msgstr ""

#: ../../source/globby_readme.md:152
msgid "`?` matches a single character, but not `/`"
msgstr ""

#: ../../source/globby_readme.md:153
msgid ""
"`**` matches any number of characters, including `/`, as long as it's the"
" only thing in a path part"
msgstr ""

