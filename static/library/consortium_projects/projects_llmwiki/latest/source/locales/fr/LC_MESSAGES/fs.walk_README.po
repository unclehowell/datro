#: ../../source/fs.walk_README.md:3
msgid "A library for efficiently walking a directory recursively."
msgstr ""

#: ../../source/fs.walk_README.md:5
msgid ":bulb: Highlights"
msgstr ""

#: ../../source/fs.walk_README.md:7
msgid ""
":moneybag: Returns useful information: `name`, `path`, `dirent` and "
"`stats` (optional)."
msgstr ""

#: ../../source/fs.walk_README.md:8
msgid ""
":rocket: On Node.js 10.10+ uses the mechanism without additional calls to"
" determine the entry type for performance reasons. See [`old` and "
"`modern` "
"mode](https://github.com/nodelib/nodelib/blob/master/packages/fs/fs.scandir/README.md"
"#old-and-modern-mode)."
msgstr ""

#: ../../source/fs.walk_README.md:9
msgid ":gear: Built-in directories/files and error filtering system."
msgstr ""

#: ../../source/fs.walk_README.md:10
msgid ":link: Can safely work with broken symbolic links."
msgstr ""

