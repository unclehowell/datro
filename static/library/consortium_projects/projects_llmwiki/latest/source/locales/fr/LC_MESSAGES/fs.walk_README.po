#: ../../source/fs.walk_README.md:28
msgid ".walk(path, [optionsOrSettings], callback)"
msgstr ""

#: ../../source/fs.walk_README.md:30
msgid ""
"Reads the directory recursively and asynchronously. Requires a callback "
"function."
msgstr ""

#: ../../source/fs.walk_README.md:32
msgid ":book: If you want to use the Promise API, use `util.promisify`."
msgstr ""

#: ../../source/fs.walk_README.md:40
msgid ".walkStream(path, [optionsOrSettings])"
msgstr ""

#: ../../source/fs.walk_README.md:42
msgid ""
"Reads the directory recursively and asynchronously. [Readable "
"Stream](https://nodejs.org/dist/latest-v12.x/docs/api/stream.html#stream_readable_streams)"
" is used as a provider."
msgstr ""

#: ../../source/fs.walk_README.md:50
msgid ".walkSync(path, [optionsOrSettings])"
msgstr ""

#: ../../source/fs.walk_README.md:52
msgid ""
"Reads the directory recursively and synchronously. Returns an array of "
"entries."
msgstr ""

