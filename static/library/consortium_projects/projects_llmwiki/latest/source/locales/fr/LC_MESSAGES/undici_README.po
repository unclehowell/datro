msgstr ""

#: ../../source/undici_README.md:609
msgid "Returns a promise with the result of the `Dispatcher.upgrade` method."
msgstr ""

#: ../../source/undici_README.md:611
msgid "Calls `options.dispatcher.upgrade(options)`."
msgstr ""

#: ../../source/undici_README.md:613
msgid ""
"See [Dispatcher.upgrade](./docs/docs/api/Dispatcher.md"
"#dispatcherupgradeoptions-callback) for more details."
msgstr ""

