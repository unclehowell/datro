msgstr ""

#: ../../source/templates_pinterest.md:190
msgid "Don't"
msgstr ""

#: ../../source/templates_pinterest.md:191
msgid "Don't use cool gray neutrals — always warm/olive-toned"
msgstr ""

#: ../../source/templates_pinterest.md:192
msgid ""
"Don't use pure black (`#000000`) as primary text — use plum black "
"(`#211922`)"
msgstr ""

#: ../../source/templates_pinterest.md:193
msgid "Don't use pill-shaped buttons — 16px radius is rounded but not pill"
msgstr ""

#: ../../source/templates_pinterest.md:194
msgid "Don't add heavy shadows — Pinterest is flat by design, depth from content"
msgstr ""

#: ../../source/templates_pinterest.md:195
msgid ""
"Don't use small border-radius (<12px) on cards — the generous rounding is"
" core"
msgstr ""

#: ../../source/templates_pinterest.md:196
msgid ""
"Don't introduce additional brand colors — red + warm neutrals is the "
"complete palette"
