msgid "Default model is `google/gemini-3-flash-preview` if none is set."
msgstr ""

#: ../../source/summarize_SKILL.md:48
msgid "Useful flags"
msgstr ""

#: ../../source/summarize_SKILL.md:50
msgid "`--length short|medium|long|xl|xxl|<chars>`"
