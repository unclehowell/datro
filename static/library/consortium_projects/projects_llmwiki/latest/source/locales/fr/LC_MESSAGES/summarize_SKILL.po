msgid "Then run summarize on that rendered URL:"
msgstr ""

#: ../../source/summarize_SKILL.md:74
msgid "Notes:"
msgstr ""

#: ../../source/summarize_SKILL.md:75
msgid ""
"Prefer the `http://` form inside r.jina.ai even if the target is https; "
"the proxy handles it."
msgstr ""

#: ../../source/summarize_SKILL.md:76
msgid ""
"This is a pragmatic extraction fallback; don’t use it for "
"private/authenticated pages."
msgstr ""

