#: ../../source/execa_readme.md:97
msgid "execa(file, [arguments], [options])"
msgstr ""

#: ../../source/execa_readme.md:99
msgid "Execute a file."
msgstr ""

#: ../../source/execa_readme.md:101
msgid ""
"Think of this as a mix of `child_process.execFile` and "
"`child_process.spawn`."
msgstr ""

#: ../../source/execa_readme.md:103
msgid ""
"Returns a [`child_process` "
"instance](https://nodejs.org/api/child_process.html#child_process_class_childprocess),"
" which is enhanced to also be a `Promise` for a result `Object` with "
"`stdout` and `stderr` properties."
msgstr ""

#: ../../source/execa_readme.md:105
msgid "execa.stdout(file, [arguments], [options])"
msgstr ""

#: ../../source/execa_readme.md:107
msgid "Same as `execa()`, but returns only `stdout`."
msgstr ""

#: ../../source/execa_readme.md:109
msgid "execa.stderr(file, [arguments], [options])"
msgstr ""

#: ../../source/execa_readme.md:111
msgid "Same as `execa()`, but returns only `stderr`."
msgstr ""

#: ../../source/execa_readme.md:113
msgid "execa.shell(command, [options])"
msgstr ""

#: ../../source/execa_readme.md:115
msgid ""
"Execute a command through the system shell. Prefer `execa()` whenever "
"possible, as it's both faster and safer."
msgstr ""

#: ../../source/execa_readme.md:117
msgid ""
"Returns a [`child_process` "
"instance](https://nodejs.org/api/child_process.html#child_process_class_childprocess)."
msgstr ""

#: ../../source/execa_readme.md:119
msgid ""
"The `child_process` instance is enhanced to also be promise for a result "
"object with `stdout` and `stderr` properties."
msgstr ""

#: ../../source/execa_readme.md:121
msgid "execa.sync(file, [arguments], [options])"
msgstr ""

#: ../../source/execa_readme.md:123
msgid "Execute a file synchronously."
msgstr ""

#: ../../source/execa_readme.md:125 ../../source/execa_readme.md:133
msgid ""
"Returns the same result object as "
"[`child_process.spawnSync`](https://nodejs.org/api/child_process.html#child_process_child_process_spawnsync_command_args_options)."
msgstr ""

#: ../../source/execa_readme.md:127
msgid "This method throws an `Error` if the command fails."
msgstr ""

#: ../../source/execa_readme.md:129
msgid "execa.shellSync(file, [options])"
msgstr ""

#: ../../source/execa_readme.md:131
msgid "Execute a command synchronously through the system shell."
msgstr ""

#: ../../source/execa_readme.md:135
msgid "options"
msgstr ""

#: ../../source/execa_readme.md:137
msgid "Type: `Object`"
msgstr ""

#: ../../source/execa_readme.md:139
msgid "cwd"
msgstr ""

#: ../../source/execa_readme.md:141 ../../source/execa_readme.md:215
msgid "Type: `string`<br> Default: `process.cwd()`"
msgstr ""

#: ../../source/execa_readme.md:144
msgid "Current working directory of the child process."
msgstr ""

#: ../../source/execa_readme.md:146
msgid "env"
msgstr ""

#: ../../source/execa_readme.md:148
msgid "Type: `Object`<br> Default: `process.env`"
msgstr ""

#: ../../source/execa_readme.md:151
msgid ""
"Environment key-value pairs. Extends automatically from `process.env`. "
"Set `extendEnv` to `false` if you don't want this."
msgstr ""

#: ../../source/execa_readme.md:153
msgid "extendEnv"
msgstr ""

#: ../../source/execa_readme.md:155 ../../source/execa_readme.md:200
#: ../../source/execa_readme.md:207 ../../source/execa_readme.md:229
#: ../../source/execa_readme.md:236 ../../source/execa_readme.md:257
msgid "Type: `boolean`<br> Default: `true`"
msgstr ""

#: ../../source/execa_readme.md:158
msgid ""
"Set to `false` if you don't want to extend the environment variables when"
" providing the `env` property."
msgstr ""

#: ../../source/execa_readme.md:160
msgid "argv0"
msgstr ""

#: ../../source/execa_readme.md:162
msgid "Type: `string`"
msgstr ""

#: ../../source/execa_readme.md:164
msgid ""
"Explicitly set the value of `argv[0]` sent to the child process. This "
"will be set to `command` or `file` if not specified."
msgstr ""

#: ../../source/execa_readme.md:166
msgid "stdio"
msgstr ""

#: ../../source/execa_readme.md:168
msgid "Type: `string[]` `string`<br> Default: `pipe`"
msgstr ""

#: ../../source/execa_readme.md:171
msgid ""
"Child's "
"[stdio](https://nodejs.org/api/child_process.html#child_process_options_stdio)"
" configuration."
msgstr ""

#: ../../source/execa_readme.md:173
msgid "detached"
msgstr ""

#: ../../source/execa_readme.md:175
msgid "Type: `boolean`"
msgstr ""

#: ../../source/execa_readme.md:177
msgid ""
"Prepare child to run independently of its parent process. Specific "
"behavior [depends on the "
"platform](https://nodejs.org/api/child_process.html#child_process_options_detached)."
msgstr ""

#: ../../source/execa_readme.md:179
msgid "uid"
msgstr ""

#: ../../source/execa_readme.md:181 ../../source/execa_readme.md:187
msgid "Type: `number`"
msgstr ""

#: ../../source/execa_readme.md:183
msgid "Sets the user identity of the process."
msgstr ""

#: ../../source/execa_readme.md:185
msgid "gid"
msgstr ""

#: ../../source/execa_readme.md:189
msgid "Sets the group identity of the process."
msgstr ""

#: ../../source/execa_readme.md:191
msgid "shell"
msgstr ""

#: ../../source/execa_readme.md:193
msgid "Type: `boolean` `string`<br> Default: `false`"
msgstr ""

#: ../../source/execa_readme.md:196
msgid ""
"If `true`, runs `command` inside of a shell. Uses `/bin/sh` on UNIX and "
"`cmd.exe` on Windows. A different shell can be specified as a string. The"
" shell should understand the `-c` switch on UNIX or `/d /s /c` on "
"Windows."
msgstr ""

#: ../../source/execa_readme.md:198
msgid "stripEof"
msgstr ""

#: ../../source/execa_readme.md:203
msgid ""
"[Strip EOF](https://github.com/sindresorhus/strip-eof) (last newline) "
"from the output."
msgstr ""

#: ../../source/execa_readme.md:205
msgid "preferLocal"
msgstr ""

#: ../../source/execa_readme.md:210
msgid ""
"Prefer locally installed binaries when looking for a binary to "
"execute.<br> If you `$ npm install foo`, you can then `execa('foo')`."
msgstr ""

#: ../../source/execa_readme.md:213
msgid "localDir"
msgstr ""

#: ../../source/execa_readme.md:218
msgid ""
"Preferred path to find locally installed binaries in (use with "
"`preferLocal`)."
msgstr ""

#: ../../source/execa_readme.md:220
msgid "input"
msgstr ""

#: ../../source/execa_readme.md:222
msgid "Type: `string` `Buffer` `stream.Readable`"
msgstr ""

#: ../../source/execa_readme.md:224
msgid ""
"Write some input to the `stdin` of your binary.<br> Streams are not "
"allowed when using the synchronous methods."
msgstr ""

#: ../../source/execa_readme.md:227
msgid "reject"
msgstr ""

#: ../../source/execa_readme.md:232
msgid ""
"Setting this to `false` resolves the promise with the error instead of "
"rejecting it."
msgstr ""

#: ../../source/execa_readme.md:234
msgid "cleanup"
msgstr ""

#: ../../source/execa_readme.md:239
msgid ""
"Keep track of the spawned process and `kill` it when the parent process "
"exits."
msgstr ""

#: ../../source/execa_readme.md:241
msgid "encoding"
msgstr ""

#: ../../source/execa_readme.md:243
msgid "Type: `string`<br> Default: `utf8`"
msgstr ""

#: ../../source/execa_readme.md:246
msgid ""
"Specify the character encoding used to decode the `stdout` and `stderr` "
"output."
msgstr ""

#: ../../source/execa_readme.md:248
msgid "timeout"
msgstr ""

#: ../../source/execa_readme.md:250
msgid "Type: `number`<br> Default: `0`"
msgstr ""

#: ../../source/execa_readme.md:253
msgid ""
"If timeout is greater than `0`, the parent will send the signal "
"identified by the `killSignal` property (the default is `SIGTERM`) if the"
" child runs longer than timeout milliseconds."
msgstr ""

#: ../../source/execa_readme.md:255
msgid "buffer"
msgstr ""

#: ../../source/execa_readme.md:260
msgid ""
"Buffer the output from the spawned process. When buffering is disabled "
"you must consume the output of the `stdout` and `stderr` streams because "
"the promise will not be resolved/rejected until they have completed."
msgstr ""

#: ../../source/execa_readme.md:262
msgid "maxBuffer"
msgstr ""

#: ../../source/execa_readme.md:264
msgid "Type: `number`<br> Default: `10000000` (10MB)"
msgstr ""

#: ../../source/execa_readme.md:267
msgid "Largest amount of data in bytes allowed on `stdout` or `stderr`."
msgstr ""

#: ../../source/execa_readme.md:269
msgid "killSignal"
msgstr ""

#: ../../source/execa_readme.md:271
msgid "Type: `string` `number`<br> Default: `SIGTERM`"
msgstr ""

#: ../../source/execa_readme.md:274
msgid "Signal value to be used when the spawned process will be killed."
msgstr ""

#: ../../source/execa_readme.md:276
msgid "stdin"
msgstr ""

#: ../../source/execa_readme.md:278 ../../source/execa_readme.md:285
#: ../../source/execa_readme.md:292
msgid "Type: `string` `number` `Stream` `undefined` `null`<br> Default: `pipe`"
msgstr ""

#: ../../source/execa_readme.md:281 ../../source/execa_readme.md:288
#: ../../source/execa_readme.md:295
msgid ""
"Same options as "
"[`stdio`](https://nodejs.org/dist/latest-v6.x/docs/api/child_process.html#child_process_options_stdio)."
msgstr ""

#: ../../source/execa_readme.md:283
msgid "stdout"
msgstr ""

#: ../../source/execa_readme.md:290
msgid "stderr"
msgstr ""

#: ../../source/execa_readme.md:297
msgid "windowsVerbatimArguments"
msgstr ""

#: ../../source/execa_readme.md:299
msgid "Type: `boolean`<br> Default: `false`"
msgstr ""

#: ../../source/execa_readme.md:302
msgid ""
"If `true`, no quoting or escaping of arguments is done on Windows. "
"Ignored on other platforms. This is set to `true` automatically when the "
"`shell` option is `true`."
msgstr ""

