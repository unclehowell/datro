#: ../../source/references_writing-guide.md:324
msgid "Vocabulary Signaling"
msgstr ""

#: ../../source/references_writing-guide.md:326
msgid "**Avoid words signaling incremental work**:"
msgstr ""

#: ../../source/references_writing-guide.md:327
msgid "Never: \"combine,\" \"modify,\" \"expand,\" \"extend\""
msgstr ""

#: ../../source/references_writing-guide.md:328
msgid "Instead: \"develop,\" \"propose,\" \"introduce\""
msgstr ""

#: ../../source/references_writing-guide.md:330
msgid ""
"**Why**: \"We combine X and Y\" sounds like you stapled two existing "
"ideas together. \"We develop a method that leverages X for Y\" sounds "
"like genuine contribution."
msgstr ""

