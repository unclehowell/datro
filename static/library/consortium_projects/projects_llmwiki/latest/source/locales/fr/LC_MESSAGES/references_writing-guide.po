msgid "Word Choice and Precision"
msgstr ""

#: ../../source/references_writing-guide.md:294
msgid "From Zachary Lipton"
msgstr ""

#: ../../source/references_writing-guide.md:296
msgid "**Eliminate hedging** unless genuine uncertainty exists:"
