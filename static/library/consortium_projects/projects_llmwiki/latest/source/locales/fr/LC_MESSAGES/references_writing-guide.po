#: ../../source/references_writing-guide.md:272
msgid ""
"Excessive connectives (\"however,\" \"moreover,\" \"furthermore\" when "
"not needed)"
msgstr ""

#: ../../source/references_writing-guide.md:274
msgid "Sentence Construction Rules"
msgstr ""

#: ../../source/references_writing-guide.md:276
msgid ""
"**One idea per sentence** - If struggling to express an idea in one "
"sentence, it needs two"
msgstr ""

#: ../../source/references_writing-guide.md:277
msgid "**No repeated sounds** - Avoid similar-sounding words in the same sentence"
msgstr ""

#: ../../source/references_writing-guide.md:278
msgid "**Every sentence adds information** - Delete sentences that merely restate"
msgstr ""

#: ../../source/references_writing-guide.md:279
msgid ""
"**Active voice always** - Specify the actor (\"We find...\" not \"It is "
"found...\")"
msgstr ""

#: ../../source/references_writing-guide.md:280
msgid "**Expand contractions** - \"don't\" → \"do not\" for formality"
msgstr ""

#: ../../source/references_writing-guide.md:282
msgid "Paragraph Architecture"
msgstr ""

#: ../../source/references_writing-guide.md:284
msgid "**First sentence**: State the point clearly"
msgstr ""

#: ../../source/references_writing-guide.md:285
msgid "**Middle sentences**: Support with evidence"
msgstr ""

#: ../../source/references_writing-guide.md:286
msgid "**Last sentence**: Reinforce or transition"
msgstr ""

#: ../../source/references_writing-guide.md:288
msgid "Don't bury key information in the middle of paragraphs."
msgstr ""

