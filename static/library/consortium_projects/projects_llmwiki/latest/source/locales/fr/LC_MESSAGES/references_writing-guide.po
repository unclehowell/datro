msgstr ""

#: ../../source/references_writing-guide.md:76
msgid "**What evidence you have**"
msgstr ""

#: ../../source/references_writing-guide.md:77
msgid "**Your most remarkable number/result**"
msgstr ""

#: ../../source/references_writing-guide.md:79
msgid "Example (Good Abstract)"
msgstr ""

#: ../../source/references_writing-guide.md:95
msgid "What to Avoid"
msgstr ""

#: ../../source/references_writing-guide.md:97
msgid ""
"From Zachary Lipton: \"If the first sentence can be pre-pended to any ML "
"paper, delete it.\""
msgstr ""

#: ../../source/references_writing-guide.md:99
msgid "**Delete these openings**:"
msgstr ""

#: ../../source/references_writing-guide.md:100
msgid "\"Large language models have achieved remarkable success...\""
msgstr ""

#: ../../source/references_writing-guide.md:101
msgid "\"Deep learning has revolutionized...\""
msgstr ""

#: ../../source/references_writing-guide.md:102
msgid "\"In recent years, neural networks have...\""
msgstr ""

#: ../../source/references_writing-guide.md:104
msgid "**Start with your specific contribution instead.**"
msgstr ""

