#: ../../source/references_writing-guide.md:303
msgid "These words signal insecurity, not strength"
msgstr ""

#: ../../source/references_writing-guide.md:305
msgid "From Jacob Steinhardt"
msgstr ""

#: ../../source/references_writing-guide.md:307
msgid "**Precision over brevity**: Replace vague terms with specific ones."
msgstr ""

