msgstr ""

#: ../../source/which_README.md:48
msgid "You may pass an options object as the second argument."
msgstr ""

#: ../../source/which_README.md:50
msgid "`path`: Use instead of the `PATH` environment variable."
msgstr ""

#: ../../source/which_README.md:51
msgid "`pathExt`: Use instead of the `PATHEXT` environment variable."
msgstr ""

#: ../../source/which_README.md:52
msgid ""
"`all`: Return all matches, instead of just the first one.  Note that this"
" means the function returns an array of strings instead of a single "
"string."
msgstr ""

