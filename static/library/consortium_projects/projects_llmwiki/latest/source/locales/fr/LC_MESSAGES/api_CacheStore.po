msgid "Property `cachedAt`"
msgstr ""

#: ../../source/api_CacheStore.md:134
msgid "`number` - Time in millis that this value was cached."
msgstr ""

#: ../../source/api_CacheStore.md:136
msgid "Property `staleAt`"
msgstr ""

#: ../../source/api_CacheStore.md:138
msgid "`number` - Time in millis that this value is considered stale."
msgstr ""

#: ../../source/api_CacheStore.md:140
msgid "Property `deleteAt`"
msgstr ""

#: ../../source/api_CacheStore.md:142
msgid ""
"`number` - Time in millis that this value is to be deleted from the "
"cache. This is either the same sa staleAt or the `max-stale` caching "
"directive."
msgstr ""

#: ../../source/api_CacheStore.md:145
msgid ""
"The store must not return a response after the time defined in this "
"property."
msgstr ""

