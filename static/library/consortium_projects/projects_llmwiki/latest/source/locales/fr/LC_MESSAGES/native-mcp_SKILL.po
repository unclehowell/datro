#: ../../source/native-mcp_SKILL.md:21
msgid ""
"Add external capabilities (filesystem access, GitHub, databases, APIs) "
"via MCP"
msgstr ""

#: ../../source/native-mcp_SKILL.md:22
msgid "Run local stdio-based MCP servers (npx, uvx, or any command)"
