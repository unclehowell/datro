#: ../../source/uuid_README.md:96
msgid "Generate and return a RFC4122 v1 (timestamp-based) UUID."
msgstr ""

#: ../../source/uuid_README.md:98 ../../source/uuid_README.md:186
msgid "`options` - (Object) Optional uuid state to apply. Properties may include:"
msgstr ""

#: ../../source/uuid_README.md:100
msgid ""
"`node` - (Array) Node id as Array of 6 bytes (per 4.1.6). Default: "
"Randomly generated ID.  See note 1."
msgstr ""

#: ../../source/uuid_README.md:101
msgid ""
"`clockseq` - (Number between 0 - 0x3fff) RFC clock sequence.  Default: An"
" internally maintained clockseq is used."
msgstr ""

#: ../../source/uuid_README.md:102
msgid ""
"`msecs` - (Number) Time in milliseconds since unix Epoch.  Default: The "
"current time is used."
msgstr ""

#: ../../source/uuid_README.md:103
msgid ""
"`nsecs` - (Number between 0-9999) additional time, in 100-nanosecond "
"units. Ignored if `msecs` is unspecified. Default: internal uuid counter "
"is used, as per 4.2.1.2."
msgstr ""

#: ../../source/uuid_README.md:105 ../../source/uuid_README.md:161
#: ../../source/uuid_README.md:189 ../../source/uuid_README.md:243
msgid ""
"`buffer` - (Array | Buffer) Array or buffer where UUID bytes are to be "
"written."
msgstr ""

#: ../../source/uuid_README.md:106 ../../source/uuid_README.md:190
msgid "`offset` - (Number) Starting index in `buffer` at which to begin writing."
msgstr ""

#: ../../source/uuid_README.md:108 ../../source/uuid_README.md:164
#: ../../source/uuid_README.md:192 ../../source/uuid_README.md:246
msgid "Returns `buffer`, if specified, otherwise the string form of the UUID"
msgstr ""

#: ../../source/uuid_README.md:110
msgid ""
"Note: The default [node "
"id](https://tools.ietf.org/html/rfc4122#section-4.1.6) (the last 12 "
"digits in the UUID) is generated once, randomly, on process startup, and "
"then remains unchanged for the duration of the process."
msgstr ""

