#: ../../source/api_Util.md:5
msgid "`parseHeaders(headers, [obj])`"
msgstr ""

#: ../../source/api_Util.md:7
msgid "Receives a header object and returns the parsed value."
msgstr ""

#: ../../source/api_Util.md:9 ../../source/api_Util.md:21
msgid "Arguments:"
msgstr ""

#: ../../source/api_Util.md:11
msgid ""
"**headers** `(Buffer | string | (Buffer | string)[])[]` (required) - "
"Header object."
msgstr ""

#: ../../source/api_Util.md:13
msgid ""
"**obj** `Record<string, string | string[]>` (optional) - Object to "
"specify a proxy object. The parsed value is assigned to this object. But,"
" if **headers** is an object, it is not used."
msgstr ""

#: ../../source/api_Util.md:15
msgid ""
"Returns: `Record<string, string | string[]>` If **obj** is specified, it "
"is equivalent to **obj**."
msgstr ""

#: ../../source/api_Util.md:17
msgid "`headerNameToString(value)`"
msgstr ""

#: ../../source/api_Util.md:19
msgid "Retrieves a header name and returns its lowercase value."
msgstr ""

#: ../../source/api_Util.md:23
msgid "**value** `string | Buffer` (required) - Header name."
msgstr ""

#: ../../source/api_Util.md:25
msgid "Returns: `string`"
msgstr ""

