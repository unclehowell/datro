#: ../../source/references_reviewer-guidelines.md:47
msgid "Use consistent terminology throughout"
msgstr ""

#: ../../source/references_reviewer-guidelines.md:48
msgid "Define all notation at first use"
msgstr ""

#: ../../source/references_reviewer-guidelines.md:49
msgid "Include reproducibility details (appendix acceptable)"
msgstr ""

#: ../../source/references_reviewer-guidelines.md:50
msgid "Have non-authors read before submission"
msgstr ""

#: ../../source/references_reviewer-guidelines.md:52
msgid "3. Significance (Impact & Importance)"
