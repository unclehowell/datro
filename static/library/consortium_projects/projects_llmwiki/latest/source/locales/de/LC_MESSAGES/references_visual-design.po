#: ../../source/references_visual-design.md:1
msgid "Visual Design Principles"
msgstr ""

#: ../../source/references_visual-design.md:3
msgid "12 Core Principles"
msgstr ""

#: ../../source/references_visual-design.md:5
msgid "**Geometry Before Algebra** — Show the shape first, the equation second."
msgstr ""

#: ../../source/references_visual-design.md:6
msgid ""
"**Opacity Layering** — PRIMARY=1.0, CONTEXT=0.4, GRID=0.15. Direct "
"attention through brightness."
msgstr ""

#: ../../source/references_visual-design.md:7
msgid "**One New Idea Per Scene** — Each scene introduces exactly one concept."
msgstr ""

#: ../../source/references_visual-design.md:8
msgid ""
"**Spatial Consistency** — Same concept occupies the same screen region "
"throughout."
msgstr ""

#: ../../source/references_visual-design.md:9
msgid ""
"**Color = Meaning** — Assign colors to concepts, not mobjects. If "
"velocity is blue, it stays blue."
msgstr ""

#: ../../source/references_visual-design.md:10
msgid ""
"**Progressive Disclosure** — Show simplest version first, add complexity "
"incrementally."
msgstr ""

#: ../../source/references_visual-design.md:11
msgid ""
"**Transform, Don't Replace** — Use Transform/ReplacementTransform to show"
" connections."
msgstr ""

#: ../../source/references_visual-design.md:12
msgid "**Breathing Room** — `self.wait(1.5)` minimum after showing something new."
msgstr ""

#: ../../source/references_visual-design.md:13
msgid "**Visual Weight Balance** — Don't cluster everything on one side."
msgstr ""

#: ../../source/references_visual-design.md:14
msgid ""
"**Consistent Motion Vocabulary** — Pick a small set of animation types "
"and reuse them."
msgstr ""

#: ../../source/references_visual-design.md:15
msgid ""
"**Dark Background, Light Content** — #1C1C1C to #2D2B55 backgrounds "
"maximize contrast."
msgstr ""

#: ../../source/references_visual-design.md:16
#, python-format
msgid "**Intentional Empty Space** — Leave at least 15% of the frame empty."
msgstr ""

#: ../../source/references_visual-design.md:18
msgid "Layout Templates"
msgstr ""

#: ../../source/references_visual-design.md:20
msgid "FULL_CENTER"
msgstr ""

#: ../../source/references_visual-design.md:21
msgid ""
"One main element centered, title above, note below. Best for: single "
"equations, single diagrams, title cards."
msgstr ""

#: ../../source/references_visual-design.md:24
msgid "LEFT_RIGHT"
msgstr ""

#: ../../source/references_visual-design.md:25
msgid ""
"Two elements side by side at x=-3.5 and x=3.5. Best for: equation + "
"visual, before/after, comparison."
msgstr ""

#: ../../source/references_visual-design.md:28
msgid "TOP_BOTTOM"
msgstr ""

#: ../../source/references_visual-design.md:29
msgid ""
"Main element at y=1.5, supporting content at y=-1.5. Best for: concept + "
"examples, theorem + cases."
msgstr ""

#: ../../source/references_visual-design.md:32
msgid "GRID"
msgstr ""

#: ../../source/references_visual-design.md:33
msgid ""
"Multiple elements via `arrange_in_grid()`. Best for: comparison matrices,"
" multi-step processes."
msgstr ""

#: ../../source/references_visual-design.md:36
msgid "PROGRESSIVE"
msgstr ""

#: ../../source/references_visual-design.md:37
msgid ""
"Elements appear one at a time, arranged DOWN with aligned_edge=LEFT. Best"
" for: algorithms, proofs, step-by-step processes."
msgstr ""

#: ../../source/references_visual-design.md:40
msgid "ANNOTATED_DIAGRAM"
msgstr ""

#: ../../source/references_visual-design.md:41
msgid ""
"Central diagram with floating labels connected by arrows. Best for: "
"architecture diagrams, annotated figures."
msgstr ""

