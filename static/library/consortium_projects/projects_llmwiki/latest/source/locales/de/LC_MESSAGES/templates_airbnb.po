#: ../../source/templates_airbnb.md:175
msgid ""
"**Shadow Philosophy**: Airbnb's three-layer shadow system creates a warm,"
" natural lift. Layer 1 (`0px 0px 0px 1px` at 0.02 opacity) is an ultra-"
"subtle border. Layer 2 (`0px 2px 6px` at 0.04) provides soft ambient "
"shadow. Layer 3 (`0px 4px 8px` at 0.1) adds the primary lift. This "
"graduated approach creates shadows that feel like natural light rather "
"than CSS effects."
msgstr ""

#: ../../source/templates_airbnb.md:177
msgid "7. Do's and Don'ts"
msgstr ""

#: ../../source/templates_airbnb.md:179
msgid "Do"
msgstr ""

#: ../../source/templates_airbnb.md:180
msgid "Use `#222222` (warm near-black) for text — never pure `#000000`"
msgstr ""

#: ../../source/templates_airbnb.md:181
msgid ""
"Apply Rausch Red (`#ff385c`) only for primary CTAs and brand moments — "
"it's the singular accent"
msgstr ""

#: ../../source/templates_airbnb.md:182
msgid ""
"Use Airbnb Cereal VF at weight 500–700 — the warm weight range is "
"intentional"
msgstr ""

#: ../../source/templates_airbnb.md:183
msgid "Apply the three-layer card shadow for all elevated surfaces"
msgstr ""

#: ../../source/templates_airbnb.md:184
#, python-format
msgid ""
"Use generous border-radius: 8px for buttons, 20px for cards, 50% for "
"controls"
msgstr ""

#: ../../source/templates_airbnb.md:185
msgid "Use photography as the primary visual content — listings are image-first"
msgstr ""

#: ../../source/templates_airbnb.md:186
msgid ""
"Apply negative letter-spacing (-0.18px to -0.44px) on headings for "
"intimacy"
msgstr ""

#: ../../source/templates_airbnb.md:187
msgid "Use circular (50%) buttons for carousel/navigation controls"
msgstr ""

#: ../../source/templates_airbnb.md:189
msgid "Don't"
msgstr ""

#: ../../source/templates_airbnb.md:190
msgid "Don't use pure black (`#000000`) for text — always `#222222` (warm)"
msgstr ""

#: ../../source/templates_airbnb.md:191
msgid ""
"Don't apply Rausch Red to backgrounds or large surfaces — it's an accent "
"only"
