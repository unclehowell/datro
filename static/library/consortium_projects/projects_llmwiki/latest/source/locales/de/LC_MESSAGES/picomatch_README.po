msgstr ""

#: ../../source/picomatch_README.md:548
msgid ""
"POSIX classes are disabled by default. Enable this feature by setting the"
" `posix` option to true."
msgstr ""

#: ../../source/picomatch_README.md:550
msgid "**Enable POSIX bracket support**"
msgstr ""

#: ../../source/picomatch_README.md:557
msgid "**Supported POSIX classes**"
msgstr ""

#: ../../source/picomatch_README.md:559
msgid "The following named POSIX bracket expressions are supported:"
msgstr ""

#: ../../source/picomatch_README.md:561
msgid "`[:alnum:]` - Alphanumeric characters, equ `[a-zA-Z0-9]`"
msgstr ""

#: ../../source/picomatch_README.md:562
msgid "`[:alpha:]` - Alphabetical characters, equivalent to `[a-zA-Z]`."
msgstr ""

#: ../../source/picomatch_README.md:563
msgid "`[:ascii:]` - ASCII characters, equivalent to `[\\\\x00-\\\\x7F]`."
msgstr ""

#: ../../source/picomatch_README.md:564
msgid "`[:blank:]` - Space and tab characters, equivalent to `[ \\\\t]`."
msgstr ""

#: ../../source/picomatch_README.md:565
msgid ""
"`[:cntrl:]` - Control characters, equivalent to "
"`[\\\\x00-\\\\x1F\\\\x7F]`."
msgstr ""

#: ../../source/picomatch_README.md:566
msgid "`[:digit:]` - Numerical digits, equivalent to `[0-9]`."
msgstr ""

#: ../../source/picomatch_README.md:567
msgid "`[:graph:]` - Graph characters, equivalent to `[\\\\x21-\\\\x7E]`."
msgstr ""

#: ../../source/picomatch_README.md:568
msgid "`[:lower:]` - Lowercase letters, equivalent to `[a-z]`."
msgstr ""

#: ../../source/picomatch_README.md:569
msgid "`[:print:]` - Print characters, equivalent to `[\\\\x20-\\\\x7E ]`."
msgstr ""

#: ../../source/picomatch_README.md:570
#, python-brace-format
msgid ""
"`[:punct:]` - Punctuation and symbols, equivalent to "
"`[\\\\-!\"#$%&\\'()\\\\*+,./:;<=>?@[\\\\]^_`{|}~]`."
msgstr ""

#: ../../source/picomatch_README.md:571
msgid ""
"`[:space:]` - Extended space characters, equivalent to `[ "
"\\\\t\\\\r\\\\n\\\\v\\\\f]`."
msgstr ""

#: ../../source/picomatch_README.md:572
msgid "`[:upper:]` - Uppercase letters, equivalent to `[A-Z]`."
msgstr ""

#: ../../source/picomatch_README.md:573
msgid ""
"`[:word:]` -  Word characters (letters, numbers and underscores), "
"equivalent to `[A-Za-z0-9_]`."
msgstr ""

#: ../../source/picomatch_README.md:574
msgid "`[:xdigit:]` - Hexadecimal digits, equivalent to `[A-Fa-f0-9]`."
msgstr ""

#: ../../source/picomatch_README.md:576
msgid ""
"See the [Bash Reference "
"Manual](https://www.gnu.org/software/bash/manual/html_node/Pattern-"
"Matching.html) for more information."
msgstr ""

