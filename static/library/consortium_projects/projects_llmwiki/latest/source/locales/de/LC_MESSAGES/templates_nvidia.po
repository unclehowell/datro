msgid "**Key Characteristics:**"
msgstr ""

#: ../../source/templates_nvidia.md:25
msgid ""
"NVIDIA Green (`#76b900`) as pure accent -- borders, underlines, and "
"interactive highlights only"
msgstr ""

#: ../../source/templates_nvidia.md:26
msgid ""
"Black (`#000000`) dominant background with white (`#ffffff`) text on dark"
" sections"
msgstr ""

#: ../../source/templates_nvidia.md:27
msgid ""
"NVIDIA-EMEA custom font with Arial/Helvetica fallback -- industrial, "
"European, clean"
msgstr ""

#: ../../source/templates_nvidia.md:28
msgid ""
"Tight line-heights (1.25 for headings) creating dense, authoritative text"
" blocks"
msgstr ""

#: ../../source/templates_nvidia.md:29
msgid "Minimal border radius (1-2px) -- sharp, engineered corners throughout"
msgstr ""

#: ../../source/templates_nvidia.md:30
msgid ""
"Green-bordered buttons (`2px solid #76b900`) as primary interactive "
"pattern"
msgstr ""

#: ../../source/templates_nvidia.md:31
