msgstr ""

#: ../../source/templates_stripe.md:252
msgid "7. Do's and Don'ts"
msgstr ""

#: ../../source/templates_stripe.md:254
msgid "Do"
msgstr ""

#: ../../source/templates_stripe.md:255
msgid ""
"Use sohne-var with `\"ss01\"` on every text element -- the stylistic set "
"IS the brand"
msgstr ""

#: ../../source/templates_stripe.md:256
msgid ""
"Use weight 300 for all headlines and body text -- lightness is the "
"signature"
msgstr ""

#: ../../source/templates_stripe.md:257
msgid ""
"Apply blue-tinted shadows (`rgba(50,50,93,0.25)`) for all elevated "
"elements"
msgstr ""

#: ../../source/templates_stripe.md:258
msgid ""
"Use `#061b31` (deep navy) for headings instead of `#000000` -- the warmth"
" matters"
msgstr ""

#: ../../source/templates_stripe.md:259
msgid "Keep border-radius between 4px-8px -- conservative rounding is intentional"
msgstr ""

#: ../../source/templates_stripe.md:260
msgid "Use `\"tnum\"` for any tabular/financial number display"
msgstr ""

#: ../../source/templates_stripe.md:261
msgid "Layer shadows: blue-tinted far + neutral close for depth parallax"
msgstr ""

#: ../../source/templates_stripe.md:262
msgid "Use `#533afd` purple as the primary interactive/CTA color"
msgstr ""

#: ../../source/templates_stripe.md:264
msgid "Don't"
msgstr ""

#: ../../source/templates_stripe.md:265
msgid ""
"Don't use weight 600-700 for sohne-var headlines -- weight 300 is the "
"brand voice"
msgstr ""

#: ../../source/templates_stripe.md:266
msgid ""
"Don't use large border-radius (12px+, pill shapes) on cards or buttons --"
" Stripe is conservative"
msgstr ""

#: ../../source/templates_stripe.md:267
msgid ""
"Don't use neutral gray shadows -- always tint with blue "
"(`rgba(50,50,93,...)`)"
msgstr ""

#: ../../source/templates_stripe.md:268
msgid ""
"Don't skip `\"ss01\"` on any sohne-var text -- the alternate glyphs "
"define the personality"
msgstr ""

#: ../../source/templates_stripe.md:269
msgid ""
"Don't use pure black (`#000000`) for headings -- always `#061b31` deep "
"navy"
msgstr ""

#: ../../source/templates_stripe.md:270
msgid ""
"Don't use warm accent colors (orange, yellow) for interactive elements --"
" purple is primary"
msgstr ""

#: ../../source/templates_stripe.md:271
msgid ""
"Don't apply positive letter-spacing at display sizes -- Stripe tracks "
"tight"
msgstr ""

#: ../../source/templates_stripe.md:272
msgid ""
"Don't use the magenta/ruby accents for buttons or links -- they're "
"decorative/gradient only"
msgstr ""

