msgid "Buffer Alloc"
msgstr ""

#: ../../source/buffer-alloc_readme.md:3
msgid "A [ponyfill](https://ponyfill.com) for `Buffer.alloc`."
msgstr ""

#: ../../source/buffer-alloc_readme.md:5
msgid "Works as Node.js: `v7.0.0` <br> Works on Node.js: `v0.10.0`"
msgstr ""

#: ../../source/buffer-alloc_readme.md:8
msgid "Installation"
msgstr ""

