msgid "When Stuck"
msgstr ""

#: ../../source/test-driven-development_SKILL.md
msgid "Problem"
msgstr ""

#: ../../source/test-driven-development_SKILL.md
msgid "Solution"
msgstr ""

#: ../../source/test-driven-development_SKILL.md
msgid "Don't know how to test"
msgstr ""

#: ../../source/test-driven-development_SKILL.md
msgid "Write the wished-for API. Write the assertion first. Ask the user."
msgstr ""

#: ../../source/test-driven-development_SKILL.md
msgid "Test too complicated"
msgstr ""

#: ../../source/test-driven-development_SKILL.md
msgid "Design too complicated. Simplify the interface."
msgstr ""

#: ../../source/test-driven-development_SKILL.md
msgid "Must mock everything"
msgstr ""

#: ../../source/test-driven-development_SKILL.md
msgid "Code too coupled. Use dependency injection."
msgstr ""

#: ../../source/test-driven-development_SKILL.md
msgid "Test setup huge"
msgstr ""

#: ../../source/test-driven-development_SKILL.md
msgid "Extract helpers. Still complex? Simplify the design."
msgstr ""

