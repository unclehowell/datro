#: ../../source/templates_x.ai.md:183
msgid ""
"**Elevation Philosophy**: xAI rejects the conventional shadow-based "
"elevation system entirely. There are no box-shadows anywhere on the site."
" Instead, depth is communicated through three mechanisms: (1) opacity-"
"based borders that brighten on interaction, creating a sense of elements "
"\"activating\" rather than lifting; (2) extremely subtle background "
"opacity shifts (`0.03` to `0.08`) that create barely-perceptible surface "
"differentiation; and (3) the massive scale contrast between the 320px "
"display type and 16px body text, which creates typographic depth. This is"
" elevation through contrast and opacity, not through simulated light and "
"shadow."
msgstr ""

#: ../../source/templates_x.ai.md:185
msgid "7. Do's and Don'ts"
msgstr ""

#: ../../source/templates_x.ai.md:187
msgid "Do"
msgstr ""

#: ../../source/templates_x.ai.md:188
msgid "Use `#1f2228` as the universal background -- never pure black `#000000`"
msgstr ""

#: ../../source/templates_x.ai.md:189
msgid ""
"Use GeistMono for all display headlines and button text -- monospace IS "
"the brand"
msgstr ""

#: ../../source/templates_x.ai.md:190
msgid "Apply uppercase + 1.4px letter-spacing to all button labels"
msgstr ""

#: ../../source/templates_x.ai.md:191
msgid "Use weight 300 for the massive display headline (320px)"
msgstr ""

#: ../../source/templates_x.ai.md:192
msgid "Keep borders at `rgba(255, 255, 255, 0.1)` -- barely visible, not absent"
msgstr ""

#: ../../source/templates_x.ai.md:193
msgid ""
"Dim interactive elements on hover to `rgba(255, 255, 255, 0.5)` -- the "
"reverse of convention"
msgstr ""

#: ../../source/templates_x.ai.md:194
msgid "Maintain sharp corners (0px radius) as the default -- brutalist precision"
msgstr ""

#: ../../source/templates_x.ai.md:195
msgid "Use universalSans for all body and reading text at 16px/1.5"
msgstr ""

#: ../../source/templates_x.ai.md:197
msgid "Don't"
msgstr ""

#: ../../source/templates_x.ai.md:198
msgid "Don't use box-shadows -- xAI has zero shadow elevation"
msgstr ""

#: ../../source/templates_x.ai.md:199
msgid ""
"Don't introduce color accents beyond white and the dark background -- the"
" monochromatic palette is sacred"
msgstr ""

#: ../../source/templates_x.ai.md:200
msgid ""
"Don't use large border-radius (8px+, pill shapes) -- the sharp edge is "
"intentional"
msgstr ""

#: ../../source/templates_x.ai.md:201
msgid "Don't use bold weights (600-700) for headlines -- weight 300-400 only"
msgstr ""

#: ../../source/templates_x.ai.md:202
msgid "Don't brighten elements on hover -- xAI dims to `0.5` opacity instead"
msgstr ""

#: ../../source/templates_x.ai.md:203
msgid "Don't add decorative gradients, illustrations, or color blocks"
msgstr ""

#: ../../source/templates_x.ai.md:204
msgid ""
