msgid "Example Component Prompts"
msgstr ""

#: ../../source/templates_x.ai.md:254
msgid ""
"\"Create a hero section on #1f2228 background. Headline in GeistMono at "
"72px weight 300, color #ffffff, centered. Subtitle in universalSans 18px "
"weight 400, rgba(255,255,255,0.7), max-width 600px centered. Two buttons:"
" primary (white bg, #1f2228 text, 0px radius, GeistMono 14px uppercase, "
"1.4px letter-spacing, 12px 24px padding) and ghost (transparent bg, 1px "
"solid rgba(255,255,255,0.2), white text, same font treatment).\""
msgstr ""

#: ../../source/templates_x.ai.md:255
msgid ""
"\"Design a card: transparent or rgba(255,255,255,0.03) background, 1px "
"solid rgba(255,255,255,0.1) border, 0px radius, 24px padding. No shadow. "
"Title in universalSans 22px weight 400, #ffffff. Body in universalSans "
"16px weight 400, rgba(255,255,255,0.7), line-height 1.5. Hover: border "
"changes to rgba(255,255,255,0.2).\""
msgstr ""

#: ../../source/templates_x.ai.md:256
msgid ""
"\"Build navigation: #1f2228 background, full-width. Brand text left "
"(GeistMono 14px uppercase). Links in universalSans 14px #ffffff with "
"hover to rgba(255,255,255,0.5). White primary button right-aligned "
"(GeistMono 14px uppercase, 1.4px letter-spacing).\""
msgstr ""

#: ../../source/templates_x.ai.md:257
msgid ""
"\"Create a form: dark background #1f2228. Label in universalSans 14px "
"rgba(255,255,255,0.7). Input with transparent bg, 1px solid "
"rgba(255,255,255,0.2) border, 0px radius, white text 16px universalSans. "
"Focus: blue ring rgb(59,130,246)/0.5. Placeholder: "
"rgba(255,255,255,0.3).\""
msgstr ""

#: ../../source/templates_x.ai.md:258
msgid ""
"\"Design a monospace tag/badge: transparent bg, 1px solid "
"rgba(255,255,255,0.2), 0px radius, GeistMono 12px uppercase, 1px letter-"
"spacing, white text, 4px 8px padding.\""
msgstr ""

#: ../../source/templates_x.ai.md:260
msgid "Iteration Guide"
msgstr ""

#: ../../source/templates_x.ai.md:261
msgid ""
"Always start with `#1f2228` background -- never use pure black or gray "
"backgrounds"
msgstr ""

#: ../../source/templates_x.ai.md:262
msgid ""
"GeistMono for display and buttons, universalSans for everything else -- "
"never mix these roles"
msgstr ""

#: ../../source/templates_x.ai.md:263
msgid ""
"All buttons must be GeistMono uppercase with 1.4px letter-spacing -- this"
" is non-negotiable"
msgstr ""

#: ../../source/templates_x.ai.md:264
msgid ""
"No shadows, ever -- depth comes from border opacity and background "
"opacity only"
msgstr ""

#: ../../source/templates_x.ai.md:265
msgid "Borders are always white with low opacity (0.1 default, 0.2 for emphasis)"
msgstr ""

#: ../../source/templates_x.ai.md:266
msgid ""
"Hover behavior dims to 0.5 opacity rather than brightening -- the reverse"
" of most systems"
msgstr ""

#: ../../source/templates_x.ai.md:267
msgid ""
"Sharp corners (0px) by default -- only use 4px for specific secondary "
"containers"
msgstr ""

#: ../../source/templates_x.ai.md:268
msgid ""
"Body text at 16px universalSans with 1.5 line-height for comfortable "
"reading"
msgstr ""

#: ../../source/templates_x.ai.md:269
msgid ""
"Generous section padding (48px-96px) -- let content breathe in the "
"darkness"
msgstr ""

#: ../../source/templates_x.ai.md:270
msgid ""
"The monochromatic white-on-dark palette is absolute -- resist adding "
"color unless critical for function"
msgstr ""

