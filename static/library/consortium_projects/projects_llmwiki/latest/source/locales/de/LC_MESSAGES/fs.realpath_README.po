#: ../../source/fs.realpath_README.md:1
msgid "fs.realpath"
msgstr ""

#: ../../source/fs.realpath_README.md:3
msgid "A backwards-compatible fs.realpath for Node v6 and above"
msgstr ""

#: ../../source/fs.realpath_README.md:5
msgid ""
"In Node v6, the JavaScript implementation of fs.realpath was replaced "
"with a faster (but less resilient) native implementation.  That raises "
"new and platform-specific errors and cannot handle long or excessively "
"symlink-looping paths."
msgstr ""

#: ../../source/fs.realpath_README.md:10
msgid ""
"This module handles those cases by detecting the new errors and falling "
"back to the JavaScript implementation.  On versions of Node prior to v6, "
"it has no effect."
msgstr ""

