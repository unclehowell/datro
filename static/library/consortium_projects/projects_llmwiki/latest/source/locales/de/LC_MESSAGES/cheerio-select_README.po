"CSS selector engine supporting jQuery selectors, based on [`css-"
"select`](https://github.com/fb55/css-select)."
msgstr ""

#: ../../source/cheerio-select_README.md:5
msgid "Supports all jQuery positional pseudo-selectors:"
msgstr ""

#: ../../source/cheerio-select_README.md:7
msgid "`:first`"
msgstr ""

#: ../../source/cheerio-select_README.md:8
msgid "`:last`"
msgstr ""

#: ../../source/cheerio-select_README.md:9
msgid "`:eq`"
msgstr ""

#: ../../source/cheerio-select_README.md:10
msgid "`:nth`"
msgstr ""

#: ../../source/cheerio-select_README.md:11
msgid "`:gt`"
msgstr ""

#: ../../source/cheerio-select_README.md:12
msgid "`:lt`"
msgstr ""

#: ../../source/cheerio-select_README.md:13
msgid "`:even`"
msgstr ""

#: ../../source/cheerio-select_README.md:14
msgid "`:odd`"
msgstr ""

#: ../../source/cheerio-select_README.md:15
msgid "`:not(:positional)`, where `:positional` is any of the above."
msgstr ""

#: ../../source/cheerio-select_README.md:17
msgid ""
"This library is a thin wrapper around [`css-"
"select`](https://github.com/fb55/css-select). Only use this module if you"
" will actually use jQuery positional selectors."
msgstr ""

