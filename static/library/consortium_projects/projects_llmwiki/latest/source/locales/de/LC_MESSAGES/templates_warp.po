msgid "Iteration Guide"
msgstr ""

#: ../../source/templates_warp.md:261
msgid "When refining existing screens generated with this design system:"
msgstr ""

#: ../../source/templates_warp.md:262
msgid ""
"Verify text color is warm parchment (#faf9f6) not pure white — the warmth"
" is subtle but essential"
msgstr ""

#: ../../source/templates_warp.md:263
msgid ""
"Ensure all buttons use the restrained dark palette (#353534) — no bright "
"or colorful CTAs"
