#: ../../source/templates_ibm.md:337
msgid "Iteration Guide"
msgstr ""

#: ../../source/templates_ibm.md:338
msgid ""
"Always use 0px border-radius on buttons, inputs, and cards — this is non-"
"negotiable in Carbon"
msgstr ""

#: ../../source/templates_ibm.md:339
msgid ""
"Letter-spacing only at small sizes: 0.16px at 14px, 0.32px at 12px — "
"never on display text"
msgstr ""

#: ../../source/templates_ibm.md:340
msgid "Three weights: 300 (display), 400 (body), 600 (emphasis) — no bold"
msgstr ""

#: ../../source/templates_ibm.md:341
msgid "Blue 60 is the only accent color — do not introduce secondary accent hues"
msgstr ""

#: ../../source/templates_ibm.md:342
msgid ""
"Depth comes from background-color layering (white → #f4f4f4 → #e0e0e0), "
"not shadows"
msgstr ""

#: ../../source/templates_ibm.md:343
msgid "Inputs have bottom-border only, never fully boxed"
msgstr ""

#: ../../source/templates_ibm.md:344
msgid "Use `--cds-` prefix for token naming to stay Carbon-compatible"
msgstr ""

