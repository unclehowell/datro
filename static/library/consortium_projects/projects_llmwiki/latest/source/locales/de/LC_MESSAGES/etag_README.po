#: ../../source/etag_README.md:24
msgid "API"
msgstr ""

#: ../../source/etag_README.md:32
msgid "etag(entity, [options])"
msgstr ""

#: ../../source/etag_README.md:34
msgid ""
"Generate a strong ETag for the given entity. This should be the complete "
"body of the entity. Strings, `Buffer`s, and `fs.Stats` are accepted. By "
"default, a strong ETag is generated except for `fs.Stats`, which will "
"generate a weak ETag (this can be overwritten by `options.weak`)."
msgstr ""

#: ../../source/etag_README.md:45
msgid "Options"
msgstr ""

#: ../../source/etag_README.md:47
msgid "`etag` accepts these properties in the options object."
msgstr ""

#: ../../source/etag_README.md:49
msgid "weak"
msgstr ""

#: ../../source/etag_README.md:51
msgid ""
"Specifies if the generated ETag will include the weak validator mark "
"(that is, the leading `W/`). The actual entity tag is the same. The "
"default value is `false`, unless the `entity` is `fs.Stats`, in which "
"case it is `true`."
msgstr ""

