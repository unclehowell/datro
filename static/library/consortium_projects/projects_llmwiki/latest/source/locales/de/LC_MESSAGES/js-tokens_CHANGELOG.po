msgid "Version 1.0.3 (2016-03-27)"
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:83
msgid "Improved: Made the regex ever so slightly smaller."
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:84
msgid "Updated: The readme."
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:87
msgid "Version 1.0.2 (2015-10-18)"
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:89
msgid ""
"Improved: Limited npm package contents for a smaller download. Thanks to "
"@zertosh!"
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:93
msgid "Version 1.0.1 (2015-06-20)"
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:95
msgid "Fixed: Declared an undeclared variable."
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:98
msgid "Version 1.0.0 (2015-02-26)"
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:100
msgid ""
"Changed: Merged the 'operator' and 'punctuation' types into 'punctuator'."
" That type is now equivalent to the Punctuator token in the ECMAScript "
"specification. (Backwards-incompatible change.)"
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:103
msgid ""
"Fixed: A `-` followed by a number is now correctly matched as a "
"punctuator followed by a number. It used to be matched as just a number, "
"but there is no such thing as negative number literals. (Possibly "
"backwards-incompatible change.)"
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:109
msgid "Version 0.4.1 (2015-02-21)"
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:111
msgid "Added: Support for the regex `u` flag."
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:114
msgid "Version 0.4.0 (2015-02-21)"
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:116
msgid "Improved: `jsTokens.matchToToken` performance."
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:117
msgid "Added: Support for octal and binary number literals."
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:118
msgid "Added: Support for template strings."
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:121
msgid "Version 0.3.1 (2015-01-06)"
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:123
msgid ""
"Fixed: Support for unicode spaces. They used to be allowed in names "
"(which is very confusing), and some unicode newlines were wrongly allowed"
" in strings and regexes."
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:128
msgid "Version 0.3.0 (2014-12-19)"
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:130
msgid ""
"Changed: The `jsTokens.names` array has been replaced with the "
"`jsTokens.matchToToken` function. The capturing groups of `jsTokens` are "
"no longer part of the public API; instead use said function. See this "
"[gist] for an example. (Backwards-incompatible change.)"
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:134
msgid ""
"Changed: The empty string is now considered an “invalid” token, instead "
"an “empty” token (its own group). (Backwards-incompatible change.)"
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:136
msgid "Removed: component support. (Backwards-incompatible change.)"
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:141
msgid "Version 0.2.0 (2014-06-19)"
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:143
msgid ""
"Changed: Match ES6 function arrows (`=>`) as an operator, instead of its "
"own category (“functionArrow”), for simplicity. (Backwards-incompatible "
"change.)"
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:145
msgid ""
"Added: ES6 splats (`...`) are now matched as an operator (instead of "
"three punctuations). (Backwards-incompatible change.)"
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:149
msgid "Version 0.1.0 (2014-03-08)"
msgstr ""

