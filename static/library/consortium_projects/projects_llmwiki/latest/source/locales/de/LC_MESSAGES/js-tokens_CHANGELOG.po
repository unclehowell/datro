#: ../../source/js-tokens_CHANGELOG.md:70
msgid "Version 2.0.0 (2016-06-19)"
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:72
msgid ""
"Added: Support for ES2016. In other words, support for the `**` "
"exponentiation operator."
msgstr ""

#: ../../source/js-tokens_CHANGELOG.md:77
msgid "`'**'.match(jsTokens)` no longer returns `['*', '*']`, but `['**']`."
msgstr ""

