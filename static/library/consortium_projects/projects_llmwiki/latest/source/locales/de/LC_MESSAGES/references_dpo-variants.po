#: ../../source/references_dpo-variants.md:11
msgid "1. Sigmoid (Standard DPO)"
msgstr ""

#: ../../source/references_dpo-variants.md:13
msgid "**Formula**: `-log(sigmoid(β * logits))`"
msgstr ""

#: ../../source/references_dpo-variants.md:15
msgid "**When to use**: Default choice, general preference alignment"
msgstr ""

