#: ../../source/references_dpo-variants.md:27
msgid "2. IPO (Identity Policy Optimization)"
msgstr ""

#: ../../source/references_dpo-variants.md:29
msgid "**Formula**: `(logits - 1/(2β))²`"
msgstr ""

#: ../../source/references_dpo-variants.md:31
msgid "**When to use**: Better theoretical foundation, reduce overfitting"
msgstr ""

#: ../../source/references_dpo-variants.md:43
msgid "3. Hinge (SLiC)"
msgstr ""

#: ../../source/references_dpo-variants.md:45
msgid "**Formula**: `ReLU(1 - β * logits)`"
msgstr ""

#: ../../source/references_dpo-variants.md:47
msgid "**When to use**: Margin-based objective"
msgstr ""

#: ../../source/references_dpo-variants.md:59
msgid "4. Robust DPO"
msgstr ""

#: ../../source/references_dpo-variants.md:61
msgid "**Formula**: Sigmoid with label smoothing for noise robustness"
msgstr ""

#: ../../source/references_dpo-variants.md:63
msgid "**When to use**: Noisy preference labels"
msgstr ""

#: ../../source/references_dpo-variants.md:78
msgid "5. BCO Pair (Binary Classification)"
msgstr ""

#: ../../source/references_dpo-variants.md:80
msgid "**Formula**: Train binary classifier (chosen=1, rejected=0)"
msgstr ""

#: ../../source/references_dpo-variants.md:82
msgid "**When to use**: Pairwise preference data"
msgstr ""

#: ../../source/references_dpo-variants.md:96
msgid "6. SPPO Hard"
msgstr ""

#: ../../source/references_dpo-variants.md:98
msgid "**Formula**: Push chosen→0.5, rejected→-0.5"
msgstr ""

#: ../../source/references_dpo-variants.md:100
msgid "**When to use**: Nash equilibrium, sparse data"
msgstr ""

#: ../../source/references_dpo-variants.md:110
msgid "7. DiscoPOP"
msgstr ""

#: ../../source/references_dpo-variants.md:112
msgid "**Formula**: Log-Ratio Modulated Loss"
msgstr ""

#: ../../source/references_dpo-variants.md:114
msgid "**When to use**: Automated loss discovery"
msgstr ""

#: ../../source/references_dpo-variants.md:127
msgid "8. APO Zero"
msgstr ""

#: ../../source/references_dpo-variants.md:129
msgid "**Formula**: Increase chosen, decrease rejected likelihood"
msgstr ""

#: ../../source/references_dpo-variants.md:131
msgid "**When to use**: Model worse than winning outputs"
msgstr ""

#: ../../source/references_dpo-variants.md:145
msgid "9. APO Down"
msgstr ""

#: ../../source/references_dpo-variants.md:147
msgid "**Formula**: Decrease both, emphasize rejected reduction"
msgstr ""

#: ../../source/references_dpo-variants.md:149
msgid "**When to use**: Model better than winning outputs"
msgstr ""

