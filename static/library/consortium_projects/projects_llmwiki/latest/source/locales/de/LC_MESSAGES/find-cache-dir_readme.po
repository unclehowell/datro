msgstr ""

#: ../../source/find-cache-dir_readme.md:56
msgid "*Required*<br> Type: `string`"
msgstr ""

#: ../../source/find-cache-dir_readme.md:59
msgid "Should be the same as your project name in `package.json`."
msgstr ""

#: ../../source/find-cache-dir_readme.md:61
msgid "files"
msgstr ""

#: ../../source/find-cache-dir_readme.md:63
msgid "Type: `string[]` `string`"
msgstr ""

#: ../../source/find-cache-dir_readme.md:65
msgid ""
"An array of files that will be searched for a common parent directory. "
"This common parent directory will be used in lieu of the `cwd` option "
"below."
msgstr ""

