#: ../../source/minimist_README.md:57
#, python-brace-format
msgid "var argv = parseArgs(args, opts={})"
msgstr ""

#: ../../source/minimist_README.md:59
msgid ""
"Return an argument object `argv` populated with the array arguments from "
"`args`."
msgstr ""

#: ../../source/minimist_README.md:61
msgid ""
"`argv._` contains all the arguments that didn't have an option associated"
" with them."
msgstr ""

#: ../../source/minimist_README.md:64
msgid ""
"Numeric-looking arguments will be returned as numbers unless "
"`opts.string` or `opts.boolean` is set for that argument name."
msgstr ""

#: ../../source/minimist_README.md:67
msgid "Any arguments after `'--'` will not be parsed and will end up in `argv._`."
msgstr ""

#: ../../source/minimist_README.md:69
msgid "options can be:"
msgstr ""

#: ../../source/minimist_README.md:71
msgid ""
"`opts.string` - a string or array of strings argument names to always "
"treat as strings"
msgstr ""

#: ../../source/minimist_README.md:73
msgid ""
"`opts.boolean` - a boolean, string or array of strings to always treat as"
" booleans. if `true` will treat all double hyphenated arguments without "
"equal signs as boolean (e.g. affects `--foo`, not `-f` or `--foo=bar`)"
msgstr ""

#: ../../source/minimist_README.md:76
msgid ""
"`opts.alias` - an object mapping string names to strings or arrays of "
"string argument names to use as aliases"
msgstr ""

#: ../../source/minimist_README.md:78
msgid "`opts.default` - an object mapping string argument names to default values"
msgstr ""

#: ../../source/minimist_README.md:79
msgid ""
"`opts.stopEarly` - when true, populate `argv._` with everything after the"
" first non-option"
msgstr ""

#: ../../source/minimist_README.md:81
msgid ""
"`opts['--']` - when true, populate `argv._` with everything before the "
"`--` and `argv['--']` with everything after the `--`. Here's an example:"
msgstr ""

#: ../../source/minimist_README.md:92
msgid ""
"Note that with `opts['--']` set, parsing for arguments still stops after "
"the `--`."
msgstr ""

#: ../../source/minimist_README.md:95
msgid ""
"`opts.unknown` - a function which is invoked with a command line "
"parameter not defined in the `opts` configuration object. If the function"
" returns `false`, the unknown option is not added to `argv`."
msgstr ""

