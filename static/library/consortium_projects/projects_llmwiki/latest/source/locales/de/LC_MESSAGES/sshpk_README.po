#: ../../source/sshpk_README.md:745
msgid "`InvalidAlgorithmError`"
msgstr ""

#: ../../source/sshpk_README.md:747
msgid ""
"The specified algorithm is not valid, either because it is not supported,"
" or because it was not included on a list of allowed algorithms."
msgstr ""

#: ../../source/sshpk_README.md:750
msgid "Thrown by `Fingerprint.parse`, `Key#fingerprint`."
msgstr ""

#: ../../source/sshpk_README.md:752 ../../source/sshpk_README.md:763
#: ../../source/sshpk_README.md:772 ../../source/sshpk_README.md:783
#: ../../source/sshpk_README.md:793
msgid "Properties"
msgstr ""

#: ../../source/sshpk_README.md:754
msgid "`algorithm` -- the algorithm that could not be validated"
msgstr ""

#: ../../source/sshpk_README.md:756
msgid "`FingerprintFormatError`"
msgstr ""

#: ../../source/sshpk_README.md:758
msgid ""
"The fingerprint string given could not be parsed as a supported "
"fingerprint format, or the specified fingerprint format is invalid."
msgstr ""

#: ../../source/sshpk_README.md:761
msgid "Thrown by `Fingerprint.parse`, `Fingerprint#toString`."
msgstr ""

#: ../../source/sshpk_README.md:765
msgid "`fingerprint` -- if caused by a fingerprint, the string value given"
msgstr ""

#: ../../source/sshpk_README.md:766
msgid ""
"`format` -- if caused by an invalid format specification, the string "
"value given"
msgstr ""

#: ../../source/sshpk_README.md:768
msgid "`KeyParseError`"
msgstr ""

#: ../../source/sshpk_README.md:770
msgid "The key data given could not be parsed as a valid key."
msgstr ""

#: ../../source/sshpk_README.md:774 ../../source/sshpk_README.md:785
msgid "`keyName` -- `filename` that was given to `parseKey`"
msgstr ""

#: ../../source/sshpk_README.md:775
msgid "`format` -- the `format` that was trying to parse the key (see `parseKey`)"
msgstr ""

#: ../../source/sshpk_README.md:776 ../../source/sshpk_README.md:798
msgid "`innerErr` -- the inner Error thrown by the format parser"
msgstr ""

#: ../../source/sshpk_README.md:778
msgid "`KeyEncryptedError`"
msgstr ""

#: ../../source/sshpk_README.md:780
msgid ""
"The key is encrypted with a symmetric key (ie, it is password protected)."
" The parsing operation would succeed if it was given the `passphrase` "
"option."
msgstr ""

#: ../../source/sshpk_README.md:786
msgid ""
"`format` -- the `format` that was trying to parse the key (currently can "
"only             be `\"pem\"`)"
msgstr ""

#: ../../source/sshpk_README.md:789
msgid "`CertificateParseError`"
msgstr ""

#: ../../source/sshpk_README.md:791
msgid "The certificate data given could not be parsed as a valid certificate."
msgstr ""

#: ../../source/sshpk_README.md:795
msgid "`certName` -- `filename` that was given to `parseCertificate`"
msgstr ""

#: ../../source/sshpk_README.md:796
msgid ""
"`format` -- the `format` that was trying to parse the key             "
"(see `parseCertificate`)"
msgstr ""

