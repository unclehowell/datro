msgid "As the second argument, like this:"
msgstr ""

#: ../../source/aws4_README.md:178
msgid "From `process.env`, such as this:"
msgstr ""

#: ../../source/aws4_README.md:186
msgid "(will also use `AWS_ACCESS_KEY` and `AWS_SECRET_KEY` if available)"
msgstr ""

#: ../../source/aws4_README.md:188
msgid ""
"The `sessionToken` property and `AWS_SESSION_TOKEN` environment variable "
"are optional for signing with [IAM STS temporary "
"credentials](https://docs.aws.amazon.com/IAM/latest/UserGuide"
"/id_credentials_temp_use-resources.html)."
msgstr ""

