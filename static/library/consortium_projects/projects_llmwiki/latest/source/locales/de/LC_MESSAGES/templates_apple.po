msgid ""
"Max content width: approximately 980px (the recurring \"980px radius\" in"
" pill buttons echoes this width)"
msgstr ""

#: ../../source/templates_apple.md:204
msgid "Hero: full-viewport-width sections with centered content block"
msgstr ""

#: ../../source/templates_apple.md:205
msgid "Product grids: 2-3 column layouts within centered container"
msgstr ""

#: ../../source/templates_apple.md:206
msgid "Single-column for hero moments — one product, one message, full attention"
msgstr ""

#: ../../source/templates_apple.md:207
msgid "No visible grid lines or gutters — spacing creates implied structure"
msgstr ""

#: ../../source/templates_apple.md:209
msgid "Whitespace Philosophy"
msgstr ""

#: ../../source/templates_apple.md:210
msgid ""
"**Cinematic breathing room**: Each product section occupies a full "
"viewport height (or close to it). The whitespace between products is not "
"empty — it is the pause between scenes in a film."
msgstr ""

#: ../../source/templates_apple.md:211
msgid ""
"**Vertical rhythm through color blocks**: Rather than using spacing alone"
" to separate sections, Apple uses alternating background colors (black, "
"`#f5f5f7`, white). Each color change signals a new \"scene.\""
msgstr ""

#: ../../source/templates_apple.md:212
msgid ""
"**Compression within, expansion between**: Text blocks are tightly set "
"(negative letter-spacing, tight line-heights) while the space surrounding"
" them is vast. This creates a tension between density and openness."
msgstr ""

#: ../../source/templates_apple.md:214
msgid "Border Radius Scale"
msgstr ""

#: ../../source/templates_apple.md:215
msgid "Micro (5px): Small containers, link tags"
msgstr ""

#: ../../source/templates_apple.md:216
msgid "Standard (8px): Buttons, product cards, image containers"
msgstr ""

#: ../../source/templates_apple.md:217
msgid "Comfortable (11px): Search inputs, filter buttons"
msgstr ""

#: ../../source/templates_apple.md:218
msgid "Large (12px): Feature panels, lifestyle image containers"
msgstr ""

#: ../../source/templates_apple.md:219
msgid "Full Pill (980px): CTA links (\"Learn more\", \"Shop\"), navigation pills"
msgstr ""

#: ../../source/templates_apple.md:220
msgid "Circle (50%): Media controls (play/pause, arrows)"
msgstr ""

