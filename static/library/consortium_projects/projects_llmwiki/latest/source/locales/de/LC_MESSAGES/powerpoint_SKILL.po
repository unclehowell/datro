#: ../../source/powerpoint_SKILL.md:79
msgid "For Each Slide"
msgstr ""

#: ../../source/powerpoint_SKILL.md:81
msgid ""
"**Every slide needs a visual element** — image, chart, icon, or shape. "
"Text-only slides are forgettable."
msgstr ""

#: ../../source/powerpoint_SKILL.md:83
msgid "**Layout options:**"
msgstr ""

#: ../../source/powerpoint_SKILL.md:84
msgid "Two-column (text left, illustration on right)"
msgstr ""

#: ../../source/powerpoint_SKILL.md:85
msgid "Icon + text rows (icon in colored circle, bold header, description below)"
msgstr ""

#: ../../source/powerpoint_SKILL.md:86
msgid "2x2 or 2x3 grid (image on one side, grid of content blocks on other)"
msgstr ""

#: ../../source/powerpoint_SKILL.md:87
msgid "Half-bleed image (full left or right side) with content overlay"
msgstr ""

#: ../../source/powerpoint_SKILL.md:89
msgid "**Data display:**"
msgstr ""

#: ../../source/powerpoint_SKILL.md:90
msgid "Large stat callouts (big numbers 60-72pt with small labels below)"
msgstr ""

#: ../../source/powerpoint_SKILL.md:91
msgid "Comparison columns (before/after, pros/cons, side-by-side options)"
msgstr ""

#: ../../source/powerpoint_SKILL.md:92
msgid "Timeline or process flow (numbered steps, arrows)"
msgstr ""

#: ../../source/powerpoint_SKILL.md:94
msgid "**Visual polish:**"
msgstr ""

#: ../../source/powerpoint_SKILL.md:95
msgid "Icons in small colored circles next to section headers"
msgstr ""

#: ../../source/powerpoint_SKILL.md:96
msgid "Italic accent text for key stats or taglines"
msgstr ""

