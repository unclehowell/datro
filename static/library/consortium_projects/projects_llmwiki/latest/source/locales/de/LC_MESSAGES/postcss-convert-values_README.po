#: ../../source/postcss-convert-values_README.md:15
msgid ""
"This plugin reduces CSS size by converting values to use different units "
"where possible; for example, `500ms` can be represented as `.5s`. You can"
" read more about these units in [this article][csstricks]."
msgstr ""

#: ../../source/postcss-convert-values_README.md:19
msgid "Input"
msgstr ""

#: ../../source/postcss-convert-values_README.md:28
msgid "Output"
msgstr ""

#: ../../source/postcss-convert-values_README.md:37
msgid ""
"Note that this plugin only covers conversions for duration and absolute "
"length values. For color conversions, use [postcss-colormin][colormin]."
msgstr ""

#: ../../source/postcss-convert-values_README.md:40
msgid "API"
msgstr ""

#: ../../source/postcss-convert-values_README.md:42
msgid "convertValues([options])"
msgstr ""

