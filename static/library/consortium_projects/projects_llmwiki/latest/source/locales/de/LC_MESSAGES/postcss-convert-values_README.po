msgid "options"
msgstr ""

#: ../../source/postcss-convert-values_README.md:46
msgid "length"
msgstr ""

#: ../../source/postcss-convert-values_README.md:48
#: ../../source/postcss-convert-values_README.md:56
#: ../../source/postcss-convert-values_README.md:63
msgid "Type: `boolean` Default: `true`"
msgstr ""

#: ../../source/postcss-convert-values_README.md:51
msgid ""
"Pass `false` to disable conversion from `px` to other absolute length "
"units, such as `pc` & `pt` & vice versa."
msgstr ""

#: ../../source/postcss-convert-values_README.md:54
msgid "time"
msgstr ""

#: ../../source/postcss-convert-values_README.md:59
msgid "Pass `false` to disable conversion from `ms` to `s` & vice versa."
msgstr ""

#: ../../source/postcss-convert-values_README.md:61
msgid "angle"
msgstr ""

#: ../../source/postcss-convert-values_README.md:66
msgid "Pass `false` to disable conversion from `deg` to `turn` & vice versa."
msgstr ""

#: ../../source/postcss-convert-values_README.md:68
msgid "precision"
msgstr ""

#: ../../source/postcss-convert-values_README.md:70
msgid "Type: `boolean|number` Default: `false`"
msgstr ""

#: ../../source/postcss-convert-values_README.md:73
#, python-brace-format
msgid ""
"Specify any numeric value here to round `px` values to that many decimal "
"places; for example, using `{precision: 2}` will round `6.66667px` to "
"`6.67px`, and `{precision: 0}` will round it to `7px`. Passing `false` "
"(the default) will leave these values as is."
msgstr ""

#: ../../source/postcss-convert-values_README.md:78
msgid "It is recommended for most use cases to set this option to `2`."
msgstr ""

