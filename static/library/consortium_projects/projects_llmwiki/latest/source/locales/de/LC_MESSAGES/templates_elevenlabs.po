#: ../../source/templates_elevenlabs.md:205
msgid ""
"**Shadow Philosophy**: ElevenLabs uses the most refined shadow system of "
"any design system analyzed. Every shadow is at sub-0.1 opacity, many "
"include both outward cast AND inward inset components, and the warm CTA "
"shadows use an actual warm color (`rgba(78,50,23,...)`) rather than "
"neutral black. The inset half-pixel borders (`0px 0px 0px 0.5px inset`) "
"create edges so subtle they're felt rather than seen — surfaces define "
"themselves through the lightest possible touch."
msgstr ""

#: ../../source/templates_elevenlabs.md:207
msgid "7. Do's and Don'ts"
msgstr ""

#: ../../source/templates_elevenlabs.md:209
msgid "Do"
msgstr ""

#: ../../source/templates_elevenlabs.md:210
msgid ""
"Use Waldenburg weight 300 for all display headings — the lightness IS the"
" brand"
msgstr ""

#: ../../source/templates_elevenlabs.md:211
msgid "Apply multi-layer shadows (inset + outline + elevation) at sub-0.1 opacity"
msgstr ""

#: ../../source/templates_elevenlabs.md:212
msgid ""
"Use warm stone tints (`#f5f2ef`, `rgba(245,242,239,0.8)`) for featured "
"elements"
msgstr ""

#: ../../source/templates_elevenlabs.md:213
msgid "Apply positive letter-spacing (+0.14px to +0.18px) on Inter body text"
msgstr ""

#: ../../source/templates_elevenlabs.md:214
msgid "Use 9999px radius for primary buttons — pill shape is standard"
msgstr ""

#: ../../source/templates_elevenlabs.md:215
msgid "Use warm-tinted shadows (`rgba(78,50,23,0.04)`) on featured CTAs"
msgstr ""

#: ../../source/templates_elevenlabs.md:216
msgid "Keep the page predominantly white with subtle gray section differentiation"
msgstr ""

#: ../../source/templates_elevenlabs.md:217
msgid "Use WaldenburgFH bold uppercase ONLY for specific CTA button labels"
msgstr ""

#: ../../source/templates_elevenlabs.md:219
msgid "Don't"
msgstr ""

#: ../../source/templates_elevenlabs.md:220
msgid ""
"Don't use bold (700) Waldenburg for headings — weight 300 is non-"
"negotiable"
msgstr ""

#: ../../source/templates_elevenlabs.md:221
msgid ""
"Don't use heavy shadows (>0.1 opacity) — the ethereal quality requires "
"whisper-level depth"
msgstr ""

#: ../../source/templates_elevenlabs.md:222
msgid "Don't use cool gray borders — the system is warm-tinted throughout"
msgstr ""

#: ../../source/templates_elevenlabs.md:223
msgid ""
"Don't skip the inset shadow component — half-pixel inset borders define "
"edges"
msgstr ""

#: ../../source/templates_elevenlabs.md:224
msgid ""
"Don't apply negative letter-spacing to body text — Inter uses positive "
"tracking"
msgstr ""

#: ../../source/templates_elevenlabs.md:225
msgid ""
"Don't use sharp corners (<8px) on cards — the generous radius is "
"structural"
msgstr ""

#: ../../source/templates_elevenlabs.md:226
msgid ""
"Don't introduce brand colors — the palette is intentionally achromatic "
"with warm undertones"
msgstr ""

#: ../../source/templates_elevenlabs.md:227
msgid ""
"Don't make buttons opaque and heavy — the warm translucent stone "
"treatment is the signature"
msgstr ""

