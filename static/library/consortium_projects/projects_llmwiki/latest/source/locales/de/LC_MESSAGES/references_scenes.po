#: ../../source/references_scenes.md:590
msgid "Scene Design Checklist"
msgstr ""

#: ../../source/references_scenes.md:592
msgid "For each scene:"
msgstr ""

#: ../../source/references_scenes.md:594
msgid "**Choose 2-3 grid sizes** — different scales create interference"
msgstr ""

#: ../../source/references_scenes.md:595
msgid ""
"**Choose different value fields** per layer — don't use the same effect "
"on every grid"
msgstr ""

#: ../../source/references_scenes.md:596
msgid ""
"**Choose different hue fields** per layer — or at minimum different hue "
"offsets"
msgstr ""

#: ../../source/references_scenes.md:597
msgid ""
"**Choose different palettes** per layer — mixing PAL_RUNE with PAL_BLOCKS"
" looks different from PAL_RUNE with PAL_DENSE"
msgstr ""

#: ../../source/references_scenes.md:598
msgid ""
"**Choose a blend mode** that matches the energy — screen for bright, "
"difference for psychedelic, exclusion for subtle"
msgstr ""

#: ../../source/references_scenes.md:599
msgid "**Add conditional effects** on beat — kaleidoscope, mirror, glitch"
msgstr ""

#: ../../source/references_scenes.md:600
msgid ""
"**Configure feedback** for trailing/recursive looks — or None for clean "
"cuts"
msgstr ""

#: ../../source/references_scenes.md:601
msgid "**Set gamma** if using destructive shaders (solarize, posterize)"
msgstr ""

#: ../../source/references_scenes.md:602
msgid "**Test with --test-frame** at the scene's midpoint before full render"
msgstr ""

