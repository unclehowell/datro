msgid "Installation"
msgstr ""

#: ../../source/combined-stream_Readme.md:17
msgid "Usage"
msgstr ""

#: ../../source/combined-stream_Readme.md:19
msgid ""
"Here is a simple example that shows how you can use combined-stream to "
"combine two files into one:"
msgstr ""

