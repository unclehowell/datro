msgstr ""

#: ../../source/templates_vercel.md:27
msgid ""
"Shadow-as-border technique: `box-shadow 0px 0px 0px 1px` replaces "
"traditional borders throughout"
msgstr ""

#: ../../source/templates_vercel.md:28
