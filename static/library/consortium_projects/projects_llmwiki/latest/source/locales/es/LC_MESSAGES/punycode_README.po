#: ../../source/punycode_README.md:35
msgid "API"
msgstr ""

#: ../../source/punycode_README.md:37
msgid "`punycode.decode(string)`"
msgstr ""

#: ../../source/punycode_README.md:39
msgid ""
"Converts a Punycode string of ASCII symbols to a string of Unicode "
"symbols."
msgstr ""

#: ../../source/punycode_README.md:47
msgid "`punycode.encode(string)`"
msgstr ""

#: ../../source/punycode_README.md:49
msgid ""
"Converts a string of Unicode symbols to a Punycode string of ASCII "
"symbols."
msgstr ""

#: ../../source/punycode_README.md:57
msgid "`punycode.toUnicode(input)`"
msgstr ""

#: ../../source/punycode_README.md:59
msgid ""
"Converts a Punycode string representing a domain name or an email address"
" to Unicode. Only the Punycoded parts of the input will be converted, "
"i.e. it doesn’t matter if you call it on a string that has already been "
"converted to Unicode."
msgstr ""

#: ../../source/punycode_README.md:73
msgid "`punycode.toASCII(input)`"
msgstr ""

#: ../../source/punycode_README.md:75
msgid ""
"Converts a lowercased Unicode string representing a domain name or an "
"email address to Punycode. Only the non-ASCII parts of the input will be "
"converted, i.e. it doesn’t matter if you call it with a domain that’s "
"already in ASCII."
msgstr ""

#: ../../source/punycode_README.md:89
msgid "`punycode.ucs2`"
msgstr ""

#: ../../source/punycode_README.md:91
msgid "`punycode.ucs2.decode(string)`"
msgstr ""

#: ../../source/punycode_README.md:93
msgid ""
"Creates an array containing the numeric code point values of each Unicode"
" symbol in the string. While [JavaScript uses UCS-2 "
"internally](https://mathiasbynens.be/notes/javascript-encoding), this "
"function will convert a pair of surrogate halves (each of which UCS-2 "
"exposes as separate characters) into a single code point, matching "
"UTF-16."
msgstr ""

#: ../../source/punycode_README.md:103
msgid "`punycode.ucs2.encode(codePoints)`"
msgstr ""

#: ../../source/punycode_README.md:105
msgid "Creates a string based on an array of numeric code point values."
msgstr ""

