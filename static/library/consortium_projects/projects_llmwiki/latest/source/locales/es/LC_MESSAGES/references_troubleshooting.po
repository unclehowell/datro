#: ../../source/references_troubleshooting.md:107
msgid "Rendering Issues"
msgstr ""

#: ../../source/references_troubleshooting.md:109
msgid "**Blurry output**: Using -ql (480p). Switch to -qm/-qh for final."
msgstr ""

#: ../../source/references_troubleshooting.md:111
msgid ""
"**Slow render**: Use -ql during development. Reduce Surface resolution. "
"Shorter self.wait()."
msgstr ""

#: ../../source/references_troubleshooting.md:113
msgid "**Stale output**: `manim -ql --disable_caching script.py Scene`"
msgstr ""

#: ../../source/references_troubleshooting.md:115
msgid "**ffmpeg concat fails**: All clips must match resolution/FPS/codec."
msgstr ""

#: ../../source/references_troubleshooting.md:117
msgid "Common Mistakes"
msgstr ""

#: ../../source/references_troubleshooting.md:119
msgid "**Text clips at edge**: `buff >= 0.5` for `.to_edge()`"
msgstr ""

#: ../../source/references_troubleshooting.md:121
msgid ""
"**Overlapping text**: Use `ReplacementTransform(old, new)`, not "
"`Write(new)` on top."
msgstr ""

#: ../../source/references_troubleshooting.md:123
msgid ""
"**Too crowded**: Max 5-6 elements visible. Split into scenes or use "
"opacity layering."
msgstr ""

#: ../../source/references_troubleshooting.md:125
msgid ""
"**No breathing room**: `self.wait(1.5)` minimum after reveals, "
"`self.wait(2.0)` for key moments."
msgstr ""

#: ../../source/references_troubleshooting.md:127
msgid ""
"**Missing background color**: Set `self.camera.background_color = BG` in "
"every scene."
msgstr ""

