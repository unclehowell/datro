#: ../../source/templates_hashicorp.md:205
msgid "Whitespace Philosophy"
msgstr ""

#: ../../source/templates_hashicorp.md:206
msgid ""
"**Enterprise breathing room**: Generous vertical spacing between sections"
" (48px–80px+) communicates stability and seriousness."
msgstr ""

#: ../../source/templates_hashicorp.md:207
msgid ""
"**Dense headings, spacious body**: Tight line-height headings sit above "
"relaxed body text, creating visual \"weight at the top\" of each section."
msgstr ""

#: ../../source/templates_hashicorp.md:208
msgid ""
"**Dark as canvas**: Dark hero sections use extra vertical padding to let "
"3D illustrations and gradients breathe."
msgstr ""

#: ../../source/templates_hashicorp.md:210
msgid "Border Radius Scale"
msgstr ""

#: ../../source/templates_hashicorp.md:211
msgid "Minimal (2px): Links, small inline elements"
msgstr ""

#: ../../source/templates_hashicorp.md:212
msgid "Subtle (3px): Checkboxes, small inputs"
msgstr ""

#: ../../source/templates_hashicorp.md:213
msgid "Standard (4px): Secondary buttons"
msgstr ""

#: ../../source/templates_hashicorp.md:214
msgid "Comfortable (5px): Primary buttons, badges, inputs"
msgstr ""

#: ../../source/templates_hashicorp.md:215
msgid "Card (8px): Cards, containers, images"
msgstr ""

