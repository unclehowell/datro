msgstr ""

#: ../../source/is-resolvable_README.md:30
msgid "API"
msgstr ""

#: ../../source/is-resolvable_README.md:36
msgid "isResolvable(*moduleId* [, *options*])"
msgstr ""

#: ../../source/is-resolvable_README.md:38
msgid ""
"*moduleId*: `string` (module ID)   *options*: `Object` "
"([`require.resolve`](https://nodejs.org/api/modules.html#modules_require_resolve_request_options)"
" options)   Return: `boolean`"
msgstr ""

#: ../../source/is-resolvable_README.md:42
msgid ""
"It returns `true` if `require()` can load a file form a given module ID, "
"otherwise `false`."
msgstr ""

#: ../../source/is-resolvable_README.md:62
msgid "The second argument accepts an options object for `require.resolve()`."
msgstr ""

