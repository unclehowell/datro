#: ../../source/code-review_SKILL.md:10
msgid "Review Checklist"
msgstr ""

#: ../../source/code-review_SKILL.md:12
msgid "1. Security First"
msgstr ""

#: ../../source/code-review_SKILL.md:13
msgid "[ ] No hardcoded secrets, API keys, or credentials"
msgstr ""

#: ../../source/code-review_SKILL.md:14
msgid "[ ] Input validation on all user-provided data"
msgstr ""

#: ../../source/code-review_SKILL.md:15
msgid "[ ] SQL queries use parameterized statements (no string concatenation)"
msgstr ""

#: ../../source/code-review_SKILL.md:16
msgid "[ ] File operations validate paths (no path traversal)"
msgstr ""

#: ../../source/code-review_SKILL.md:17
msgid "[ ] Authentication/authorization checks present where needed"
msgstr ""

#: ../../source/code-review_SKILL.md:19
msgid "2. Error Handling"
msgstr ""

#: ../../source/code-review_SKILL.md:20
msgid "[ ] All external calls (API, DB, file) have try/catch"
msgstr ""

#: ../../source/code-review_SKILL.md:21
msgid "[ ] Errors are logged with context (but no sensitive data)"
msgstr ""

#: ../../source/code-review_SKILL.md:22
msgid "[ ] User-facing errors are helpful but don't leak internals"
msgstr ""

#: ../../source/code-review_SKILL.md:23
msgid "[ ] Resources are cleaned up in finally blocks or context managers"
msgstr ""

#: ../../source/code-review_SKILL.md:25
msgid "3. Code Quality"
msgstr ""

#: ../../source/code-review_SKILL.md:26
msgid "[ ] Functions do one thing and are reasonably sized (<50 lines ideal)"
msgstr ""

#: ../../source/code-review_SKILL.md:27
msgid "[ ] Variable names are descriptive (no single letters except loops)"
msgstr ""

#: ../../source/code-review_SKILL.md:28
msgid "[ ] No commented-out code left behind"
msgstr ""

#: ../../source/code-review_SKILL.md:29
msgid "[ ] Complex logic has explanatory comments"
msgstr ""

#: ../../source/code-review_SKILL.md:30
msgid "[ ] No duplicate code (DRY principle)"
msgstr ""

#: ../../source/code-review_SKILL.md:32
msgid "4. Testing Considerations"
msgstr ""

#: ../../source/code-review_SKILL.md:33
msgid "[ ] Edge cases handled (empty inputs, nulls, boundaries)"
msgstr ""

#: ../../source/code-review_SKILL.md:34
msgid "[ ] Happy path and error paths both work"
msgstr ""

#: ../../source/code-review_SKILL.md:35
msgid "[ ] New code has corresponding tests (if test suite exists)"
msgstr ""

