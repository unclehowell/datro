#: ../../source/heartmula_SKILL.md:26
msgid "Hardware Requirements"
msgstr ""

#: ../../source/heartmula_SKILL.md:27
msgid ""
"**Minimum**: 8GB VRAM with `--lazy_load true` (loads/unloads models "
"sequentially)"
msgstr ""

#: ../../source/heartmula_SKILL.md:28
msgid "**Recommended**: 16GB+ VRAM for comfortable single-GPU usage"
msgstr ""

#: ../../source/heartmula_SKILL.md:29
msgid ""
"**Multi-GPU**: Use `--mula_device cuda:0 --codec_device cuda:1` to split "
"across GPUs"
msgstr ""

#: ../../source/heartmula_SKILL.md:30
msgid "3B model with lazy_load peaks at ~6.2GB VRAM"
msgstr ""

