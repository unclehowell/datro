#: ../../source/blogwatcher_SKILL.md:54
msgid "Common Commands"
msgstr ""

#: ../../source/blogwatcher_SKILL.md:56
msgid "Managing blogs"
msgstr ""

#: ../../source/blogwatcher_SKILL.md:58
msgid "Add a blog: `blogwatcher-cli add \"My Blog\" https://example.com`"
msgstr ""

#: ../../source/blogwatcher_SKILL.md:59
msgid ""
"Add with explicit feed: `blogwatcher-cli add \"My Blog\" "
"https://example.com --feed-url https://example.com/feed.xml`"
msgstr ""

#: ../../source/blogwatcher_SKILL.md:60
msgid ""
"Add with HTML scraping: `blogwatcher-cli add \"My Blog\" "
"https://example.com --scrape-selector \"article h2 a\"`"
msgstr ""

#: ../../source/blogwatcher_SKILL.md:61
msgid "List tracked blogs: `blogwatcher-cli blogs`"
msgstr ""

#: ../../source/blogwatcher_SKILL.md:62
msgid "Remove a blog: `blogwatcher-cli remove \"My Blog\" --yes`"
msgstr ""

#: ../../source/blogwatcher_SKILL.md:63
msgid "Import from OPML: `blogwatcher-cli import subscriptions.opml`"
msgstr ""

#: ../../source/blogwatcher_SKILL.md:65
msgid "Scanning and reading"
msgstr ""

#: ../../source/blogwatcher_SKILL.md:67
msgid "Scan all blogs: `blogwatcher-cli scan`"
msgstr ""

#: ../../source/blogwatcher_SKILL.md:68
msgid "Scan one blog: `blogwatcher-cli scan \"My Blog\"`"
msgstr ""

#: ../../source/blogwatcher_SKILL.md:69
msgid "List unread articles: `blogwatcher-cli articles`"
msgstr ""

#: ../../source/blogwatcher_SKILL.md:70
msgid "List all articles: `blogwatcher-cli articles --all`"
msgstr ""

#: ../../source/blogwatcher_SKILL.md:71
msgid "Filter by blog: `blogwatcher-cli articles --blog \"My Blog\"`"
msgstr ""

#: ../../source/blogwatcher_SKILL.md:72
msgid "Filter by category: `blogwatcher-cli articles --category \"Engineering\"`"
msgstr ""

#: ../../source/blogwatcher_SKILL.md:73
msgid "Mark article read: `blogwatcher-cli read 1`"
msgstr ""

#: ../../source/blogwatcher_SKILL.md:74
msgid "Mark article unread: `blogwatcher-cli unread 1`"
msgstr ""

#: ../../source/blogwatcher_SKILL.md:75
msgid "Mark all read: `blogwatcher-cli read-all`"
msgstr ""

#: ../../source/blogwatcher_SKILL.md:76
msgid ""
"Mark all read for a blog: `blogwatcher-cli read-all --blog \"My Blog\" "
"--yes`"
msgstr ""

