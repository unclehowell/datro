#: ../../source/urix_readme.md:6
msgid ""
"Makes Windows-style paths more unix and URI friendly. Useful if you work "
"with paths that eventually will be used in URLs."
msgstr ""

#: ../../source/urix_readme.md:22
msgid "Installation"
msgstr ""

#: ../../source/urix_readme.md:25
msgid "`npm install urix`"
msgstr ""

#: ../../source/urix_readme.md:32
msgid "Usage"
msgstr ""

#: ../../source/urix_readme.md:35
msgid "`urix(path)`"
msgstr ""

#: ../../source/urix_readme.md:37
msgid ""
"On Windows, replaces all backslashes with slashes and uses a slash "
"instead of a drive letter and a colon for absolute paths."
msgstr ""

#: ../../source/urix_readme.md:40
msgid "On unix-like systems it is a no-op."
msgstr ""

