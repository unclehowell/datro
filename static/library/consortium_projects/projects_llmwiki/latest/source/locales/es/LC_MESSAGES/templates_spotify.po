msgid ""
"**Shadow Philosophy**: Spotify uses notably heavy shadows for a dark-"
"themed app. The 0.5 opacity shadow at 24px blur creates a dramatic "
"\"floating in darkness\" effect for dialogs and menus, while the 0.3 "
"opacity at 8px blur provides a more subtle card lift. The unique inset "
"border-shadow combination on inputs creates a recessed, tactile quality."
msgstr ""

#: ../../source/templates_spotify.md:195
msgid "7. Do's and Don'ts"
msgstr ""

#: ../../source/templates_spotify.md:197
msgid "Do"
msgstr ""

#: ../../source/templates_spotify.md:198
msgid ""
"Use near-black backgrounds (`#121212`–`#1f1f1f`) — depth through shade "
"variation"
msgstr ""

#: ../../source/templates_spotify.md:199
msgid ""
"Apply Spotify Green (`#1ed760`) only for play controls, active states, "
"and primary CTAs"
msgstr ""

#: ../../source/templates_spotify.md:200
msgid ""
"Use pill shape (500px–9999px) for all buttons — circular (50%) for play "
"controls"
msgstr ""

#: ../../source/templates_spotify.md:201
msgid "Apply uppercase + wide letter-spacing (1.4px–2px) on button labels"
msgstr ""

#: ../../source/templates_spotify.md:202
msgid "Keep typography compact (10px–24px range) — this is an app, not a magazine"
msgstr ""

#: ../../source/templates_spotify.md:203
msgid ""
"Use heavy shadows (`0.3–0.5 opacity`) for elevated elements on dark "
"backgrounds"
msgstr ""

#: ../../source/templates_spotify.md:204
msgid "Let album art provide color — the UI itself is achromatic"
msgstr ""

#: ../../source/templates_spotify.md:206
msgid "Don't"
msgstr ""

#: ../../source/templates_spotify.md:207
msgid ""
"Don't use Spotify Green decoratively or on backgrounds — it's functional "
"only"
msgstr ""

#: ../../source/templates_spotify.md:208
msgid ""
"Don't use light backgrounds for primary surfaces — the dark immersion is "
"core"
msgstr ""

#: ../../source/templates_spotify.md:209
msgid ""
"Don't skip the pill/circle geometry on buttons — square buttons break the"
" identity"
msgstr ""

#: ../../source/templates_spotify.md:210
msgid ""
"Don't use thin/subtle shadows — on dark backgrounds, shadows need to be "
"heavy to be visible"
msgstr ""

