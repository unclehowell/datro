#: ../../source/templates_resend.md:223
msgid "6. Depth & Elevation"
msgstr ""

#: ../../source/templates_resend.md
msgid "Level"
msgstr ""

#: ../../source/templates_resend.md
msgid "Treatment"
msgstr ""

#: ../../source/templates_resend.md
msgid "Use"
msgstr ""

#: ../../source/templates_resend.md
msgid "Flat (Level 0)"
msgstr ""

#: ../../source/templates_resend.md
msgid "No shadow, transparent background"
msgstr ""

#: ../../source/templates_resend.md
msgid "Default — most elements on dark void"
msgstr ""

#: ../../source/templates_resend.md
msgid "Ring (Level 1)"
msgstr ""

#: ../../source/templates_resend.md
msgid "`rgba(176, 199, 217, 0.145) 0px 0px 0px 1px`"
msgstr ""

#: ../../source/templates_resend.md
msgid "Shadow-as-border for cards, containers"
msgstr ""

#: ../../source/templates_resend.md
msgid "Frost Border (Level 1b)"
msgstr ""

#: ../../source/templates_resend.md
msgid "`1px solid rgba(214, 235, 253, 0.19)`"
msgstr ""

#: ../../source/templates_resend.md
msgid "Explicit borders — buttons, dividers, tabs"
msgstr ""

#: ../../source/templates_resend.md
msgid "Subtle (Level 2)"
msgstr ""

#: ../../source/templates_resend.md
msgid "`rgba(0, 0, 0, 0.1) 0px 1px 3px, rgba(0, 0, 0, 0.1) 0px 1px 2px -1px`"
msgstr ""

#: ../../source/templates_resend.md
msgid "Light card elevation"
msgstr ""

#: ../../source/templates_resend.md
msgid "Focus (Level 3)"
msgstr ""

#: ../../source/templates_resend.md
msgid "`rgb(0, 0, 0) 0px 0px 0px 8px`"
msgstr ""

#: ../../source/templates_resend.md
msgid "Heavy black focus ring — accessibility"
msgstr ""

#: ../../source/templates_resend.md:233
msgid ""
"**Shadow Philosophy**: Resend barely uses shadows at all. On a pure black"
" background, traditional shadows are invisible — you can't cast a shadow "
"into the void. Instead, Resend creates depth through its signature frost "
"borders (`rgba(214, 235, 253, 0.19)`) — thin, icy blue-tinted lines that "
"catch light against the darkness. This creates a \"glass panel floating "
"in space\" aesthetic where borders are the primary depth mechanism."
msgstr ""

#: ../../source/templates_resend.md:235
msgid "Decorative Depth"
msgstr ""

#: ../../source/templates_resend.md:236
msgid "Subtle warm gradient glows behind hero content (orange/amber tints)"
msgstr ""

#: ../../source/templates_resend.md:237
msgid "Product screenshots create visual depth through their own internal UI"
msgstr ""

#: ../../source/templates_resend.md:238
msgid ""
"No gradient backgrounds — depth comes from border luminance and content "
"contrast"
msgstr ""

#: ../../source/templates_resend.md:240
msgid "7. Do's and Don'ts"
msgstr ""

#: ../../source/templates_resend.md:242
msgid "Do"
msgstr ""

#: ../../source/templates_resend.md:243
msgid "Use pure black (`#000000`) as the page background — the void is the canvas"
msgstr ""

#: ../../source/templates_resend.md:244
msgid ""
"Apply frost borders (`rgba(214, 235, 253, 0.19)`) for all structural "
"lines — they're the blue-tinted signature"
msgstr ""

#: ../../source/templates_resend.md:245
msgid ""
"Use Domaine Display ONLY for hero headings (96px), ABC Favorit for "
"section headings, Inter for everything else"
msgstr ""

#: ../../source/templates_resend.md:246
msgid ""
"Enable OpenType `\"ss01\"`, `\"ss04\"`, `\"ss11\"` on Domaine and ABC "
"Favorit text"
msgstr ""

#: ../../source/templates_resend.md:247
msgid "Apply pill radius (9999px) to primary CTAs and tags"
msgstr ""

#: ../../source/templates_resend.md:248
msgid ""
"Use the multi-color accent scale (orange/green/blue/yellow/red) with "
"opacity variants for context-specific highlighting"
msgstr ""

#: ../../source/templates_resend.md:249
msgid ""
"Keep shadows at ring level (`0px 0px 0px 1px`) — on black, traditional "
"shadows don't work"
msgstr ""

#: ../../source/templates_resend.md:250
msgid ""
"Use +0.35px letter-spacing on ABC Favorit nav links — the only positive "
"tracking"
msgstr ""

#: ../../source/templates_resend.md:252
msgid "Don't"
msgstr ""

#: ../../source/templates_resend.md:253
msgid ""
"Don't lighten the background above `#000000` — the pure black void is "
"non-negotiable"
msgstr ""

#: ../../source/templates_resend.md:254
msgid "Don't use neutral gray borders — all borders must have the frost blue tint"
msgstr ""

#: ../../source/templates_resend.md:255
msgid "Don't apply Domaine Display to body text — it's a display-only serif"
msgstr ""

#: ../../source/templates_resend.md:256
msgid ""
"Don't mix accent colors in the same component — each feature gets one "
"accent color"
msgstr ""

#: ../../source/templates_resend.md:257
msgid ""
"Don't use box-shadow for elevation on the dark background — use frost "
"borders instead"
msgstr ""

#: ../../source/templates_resend.md:258
msgid ""
"Don't skip the OpenType stylistic sets — they define the typographic "
"character"
msgstr ""

#: ../../source/templates_resend.md:259
msgid ""
"Don't use negative letter-spacing on nav links — ABC Favorit nav uses "
"positive +0.35px"
msgstr ""

#: ../../source/templates_resend.md:260
msgid ""
"Don't make buttons opaque on dark — transparency with frost border is the"
" pattern"
msgstr ""

