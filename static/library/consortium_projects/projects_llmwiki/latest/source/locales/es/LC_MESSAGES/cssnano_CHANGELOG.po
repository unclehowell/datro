#: ../../source/cssnano_CHANGELOG.md:342
msgid ""
"Resolves an issue where the semicolon was being incorrectly stripped from"
" CSS mixins."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:345
msgid "3.7.5"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:347
msgid ""
"Resolves an issue where the `safe` flag was not being persisted across "
"multiple files (thanks to @techmatt101)."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:350
msgid "3.7.4"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:352
msgid ""
"Improves performance of the reducePositions transform by testing against "
"`hasOwnProperty` instead of using an array of object keys."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:354
msgid "Removes the redundant `indexes-of` dependency."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:356
msgid "3.7.3"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:358
msgid ""
"Unpins postcss-filter-plugins from `2.0.0` as a fix has landed in the new"
" version of uniqid."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:361
msgid "3.7.2"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:363
msgid ""
"Temporarily pins postcss-filter-plugins to version `2.0.0` in order to "
"mitigate an issue with uniqid `3.0.0`."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:366
msgid "3.7.1"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:368
msgid ""
"Enabling safe mode now turns off both postcss-merge-idents & postcss-"
"normalize-url's `stripWWW` option."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:371
msgid "3.7.0"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:373
msgid ""
"Added: Reduce `background-repeat` definitions; works with both this "
"property & the `background` shorthand, and aims to compress the extended "
"two value syntax into the single value syntax."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:376
msgid ""
"Added: Reduce `initial` values for properties when the *actual* initial "
"value is shorter; for example, `min-width: initial` becomes `min-width: "
"0`."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:379
msgid "3.6.2"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:381
msgid "Fixed an issue where cssnano would crash on `steps(1)`."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:383
msgid "3.6.1"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:385
msgid ""
"Fixed an issue where cssnano would crash on `steps` functions with a "
"single argument."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:388
msgid "3.6.0"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:390
msgid ""
"Added `postcss-discard-overridden` to safely discard overridden rules "
"with the same identifier (thanks to @Justineo)."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:392
msgid ""
"Added: Reduce animation/transition timing functions. Detects `cubic-"
"bezier` functions that are equivalent to the timing keywords and "
"compresses, as well as normalizing the `steps` timing function."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:395
msgid ""
"Added the `perspective-origin` property to the list of supported "
"properties transformed by the `reduce-positions` transform."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:398
msgid "3.5.2"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:400
msgid ""
"Resolves an issue where the 3 or 4 value syntax for `background-position`"
" were being incorrectly converted."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:403
msgid "3.5.1"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:405
msgid ""
"Improves checking for `background-position` values in the `background` "
"shorthand property."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:408
msgid "3.5.0"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:410
msgid ""
"Adds a new optimisation path which can minimise keyword values for "
"`background-position` and the `background` shorthand."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:412
msgid "Tweaks to performance in the `core` module, now performs less AST passes."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:413
msgid "Now compiled with Babel 6."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:415
msgid "3.4.0"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:417
msgid ""
"Adds a new optimisation path which can minimise gradient parameters "
"automatically."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:420
msgid "3.3.2"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:422
msgid ""
"Fixes an issue where using `options.safe` threw an error when cssnano was"
" not used as part of a PostCSS instance, but standalone (such as in "
"modules like gulp-cssnano). cssnano now renames `safe` internally to "
"`isSafe`."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:426
msgid "3.3.1"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:428
msgid ""
"Unpins postcss-colormin from `2.1.2`, as the `2.1.3` & `2.1.4` patches "
"had optimization regressions that are now resolved in `2.1.5`."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:431
msgid "3.3.0"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:433
msgid ""
"Updated modules to use postcss-value-parser version 3 (thanks to "
"@TrySound)."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:434
msgid ""
"Now converts between transform functions with postcss-reduce-transforms. "
"e.g. `translate3d(0, 0, 0)` becomes `translateZ(0)`."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:437
msgid "3.2.0"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:439
msgid ""
"cssnano no longer converts `outline: none` to `outline: 0`, as there are "
"some cases where the values are not equivalent (thanks to @TrySound)."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:441
#, python-brace-format
msgid ""
"cssnano no longer converts for example `16px` to `1pc` *by default*. "
"Length optimisations can be turned on via `{convertValues: {length: "
"true}}`."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:443
msgid "Improved minimization of css functions (thanks to @TrySound)."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:445
msgid "3.1.0"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:447
msgid ""
"This release swaps postcss-single-charset for postcss-normalize-charset, "
"which can detect encoding to determine whether a charset is necessary. "
"Optionally, you can set the `add` option to `true` to prepend a UTF-8 "
"charset to the output automatically (thanks to @TrySound)."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:451
msgid ""
"A `safe` option was added, which disables more aggressive optimisations, "
"as a convenient preset configuration (thanks to @TrySound)."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:453
msgid ""
"Added an option to convert from `deg` to `turn` & vice versa, & improved "
"minification performance in functions (thanks to @TrySound)."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:456
msgid "3.0.3"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:458
msgid ""
"Fixes an issue where cssnano was removing spaces around forward slashes "
"in string literals (thanks to @TrySound)."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:461
msgid "3.0.2"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:463
msgid ""
"Fixes an issue where cssnano was removing spaces around forward slashes "
"in calc functions."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:466
msgid "3.0.1"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:468
msgid ""
"Replaced css-list & balanced-match with postcss-value-parser, reducing "
"the module's overall size (thanks to @TrySound)."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:471
msgid "3.0.0"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:473
msgid ""
"All cssnano plugins and cssnano itself have migrated to PostCSS 5.x. "
"Please make sure that when using the 3.x releases that you use a 5.x "
"compatible PostCSS runner."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:476
msgid ""
"cssnano will now compress inline SVG through SVGO. Because of this "
"change, interfacing with cssnano must now be done through an asynchronous"
" API. The main `process` method has the same signature as a PostCSS "
"processor instance."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:479
msgid ""
"The old options such as `merge` & `fonts` that were deprecated in release"
" `2.5.0` were removed. The new architecture allows you to specify any "
"module name to disable it."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:482
msgid ""
"postcss-minify-selectors' at-rule compression was extracted out into "
"postcss-minify-params (thanks to @TrySound)."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:484
msgid ""
"Overall performance of the module has improved dramatically, thanks to "
"work by @TrySound and input from the community."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:486
msgid "Improved selector merging/deduplication in certain use cases."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:487
msgid ""
"cssnano no longer compresses hex colours in filter properties, to better "
"support old versions of Internet Explorer (thanks to @faddee)."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:489
msgid "cssnano will not merge properties together that have an `inherit` keyword."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:490
msgid ""
"postcss-minify-font-weight & postcss-font-family were consolidated into "
"postcss-minify-font-values. Using the old options will print deprecation "
"warnings (thanks to @TrySound)."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:493
msgid ""
"The cssnano CLI was extracted into a separate module, so that dependent "
"modules such as gulp-cssnano don't download unnecessary extras."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:496
msgid "2.6.1"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:498
msgid "Improved performance of the core module `functionOptimiser`."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:500
msgid "2.6.0"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:502
msgid ""
"Adds a new optimisation which re-orders properties that accept values in "
"an arbitrary order. This can lead to improved merging behaviour in "
"certain cases."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:506
msgid "2.5.0"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:508
msgid ""
"Adds support for disabling modules of the user's choosing, with new "
"option names. The old options (such as `merge` & `fonts`) will be removed"
" in `3.0`."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:511
msgid "2.4.0"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:513
msgid ""
"postcss-minify-selectors was extended to add support for conversion of "
"`::before` to `:before`; this release removes the dedicated postcss-"
"pseudoelements module."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:517
msgid "2.3.0"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:519
msgid ""
"Consolidated postcss-minify-trbl & two integrated modules into postcss-"
"merge-longhand."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:522
msgid "2.2.0"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:524
msgid "Replaced integrated plugin filter with postcss-filter-plugins."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:525
msgid "Improved rule merging logic."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:526
msgid ""
"Improved performance across the board by reducing AST iterations where it"
" was possible to do so."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:528
msgid ""
"cssnano will now perform better whitespace compression when used with "
"other PostCSS plugins."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:531
msgid "2.1.1"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:533
msgid "Fixes an issue where options were not passed to normalize-url."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:535
msgid "2.1.0"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:537
msgid "Allow `postcss-font-family` to be disabled."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:539
msgid "2.0.3"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:541
msgid ""
"cssnano can now be consumed with the parentheses-less method in PostCSS; "
"e.g. `postcss([ cssnano ])`."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:543
msgid ""
"Fixes an issue where 'Din' was being picked up by the logic as a numeric "
"value, causing the full font name to be incorrectly rearranged."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:546
msgid "2.0.2"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:548
msgid "Extract trbl value reducing into a separate module."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:549
msgid "Refactor core longhand optimiser to not rely on trbl cache."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:550
msgid "Adds support for `ch` units; previously they were removed."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:551
msgid "Fixes parsing of some selector hacks."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:552
msgid ""
"Fixes an issue where embedded base 64 data was being converted as if it "
"were a URL."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:555
msgid "2.0.1"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:557
msgid "Add `postcss-plugin` keyword to package.json."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:558
msgid "Wraps all core processors with the PostCSS 4.1 plugin API."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:560
msgid "2.0.0"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:562
msgid "Adds removal of outdated vendor prefixes based on browser support."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:563
msgid ""
"Addresses an issue where relative path separators were converted to "
"backslashes on Windows."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:565
msgid ""
"cssnano will now detect previous plugins and silently disable them when "
"the functionality overlaps. This is to enable faster interoperation with "
"cssnext."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:567
msgid ""
"cssnano now exports as a PostCSS plugin. The simple interface is exposed "
"at `cssnano.process(css, opts)` instead of `cssnano(css, opts)`."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:569
msgid "Improved URL detection when using two or more in the same declaration."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:570
msgid "node 0.10 is no longer officially supported."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:572
msgid "1.4.3"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:574
msgid "Fixes incorrect minification of `background:none` to `background:0 0`."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:576
msgid "1.4.2"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:578
msgid "Fixes an issue with nested URLs inside `url()` functions."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:580
msgid "1.4.1"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:582
msgid ""
"Addresses an issue where whitespace removal after a CSS function would "
"cause rendering issues in Internet Explorer."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:585
msgid "1.4.0"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:587
msgid ""
"Adds support for removal of unused `@keyframes` and `@counter-style` at-"
"rules."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:588
msgid ""
"comments: adds support for user-directed removal of comments, with the "
"`remove` option (thanks to @dmitrykiselyov)."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:590
msgid ""
"comments: `removeAllButFirst` now operates on each CSS tree, rather than "
"the first one passed to cssnano."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:593
msgid "1.3.3"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:595
msgid "Fixes incorrect minification of `border:none` to `border:0 0`."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:597
msgid "1.3.2"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:599
msgid ""
"Improved selector minifying logic, leading to better compression of "
"attribute selectors."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:601
msgid "Improved comment discarding logic."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:603
msgid "1.3.1"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:605
msgid "Fixes crash on undefined `decl.before` from prior AST."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:607
msgid "1.3.0"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:609
msgid "Added support for bundling cssnano using webpack (thanks to @MoOx)."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:611
msgid "1.2.1"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:613
msgid ""
"Fixed a bug where a CSS function keyword inside its value would throw an "
"error."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:616
msgid "1.2.0"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:618
msgid ""
"Better support for merging properties without the existance of a "
"shorthand override."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:620
msgid ""
"Can now 'merge forward' adjacent rules as well as the previous 'merge "
"behind' behaviour, leading to better compression."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:622
msgid ""
"Selector re-ordering now happens last in the chain of plugins, to help "
"clean up merged selectors."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:625
msgid "1.1.0"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:627
msgid ""
"Now can merge identifiers such as `@keyframes` and `@counter-style` if "
"they have duplicated properties but are named differently."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:629
msgid ""
"Fixes an issue where duplicated keyframes with the same name would cause "
"an infinite loop."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:632
msgid "1.0.2"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:634
msgid "Improve module loading logic (thanks to @tunnckoCore)."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:635
msgid ""
"Improve minification of numeric values, with better support for `rem`, "
"trailing zeroes and slash/comma separated values (thanks to @TrySound & "
"@tunnckoCore)."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:638
msgid ""
"Fixed an issue where `-webkit-tap-highlight-color` values were being "
"incorrectly transformed to `transparent`. This is not supported in "
"Safari."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:640
msgid "Added support for viewport units (thanks to @TrySound)."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:641
msgid "Add MIT license file."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:643
msgid "1.0.1"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:645
msgid "Add repository/author links to package.json."
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:647
msgid "1.0.0"
msgstr ""

#: ../../source/cssnano_CHANGELOG.md:649
msgid "Initial release."
msgstr ""

