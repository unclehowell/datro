#: ../../source/man_marked.1.md:1
msgid "marked(1) -- a javascript markdown parser"
msgstr ""

#: ../../source/man_marked.1.md:3
msgid "SYNOPSIS"
msgstr ""

#: ../../source/man_marked.1.md:5
msgid ""
"`marked` [`-o` <output file>] [`-i` <input file>] [`-s` <markdown "
"string>] [`-c` <config file>] [`--help`] [`--version`] [`--tokens`] "
"[`--no-clobber`] [`--pedantic`] [`--gfm`] [`--breaks`] [`--no-etc...`] "
"[`--silent`] [filename]"
msgstr ""

#: ../../source/man_marked.1.md:7
msgid "DESCRIPTION"
msgstr ""

#: ../../source/man_marked.1.md:9
msgid ""
"marked is a full-featured javascript markdown parser, built for speed. It"
" also includes multiple GFM features."
msgstr ""

#: ../../source/man_marked.1.md:12
msgid "EXAMPLES"
msgstr ""

#: ../../source/man_marked.1.md:30
msgid "OPTIONS"
msgstr ""

#: ../../source/man_marked.1.md:32
msgid ""
"-o, --output [output file] Specify file output. If none is specified, "
"write to stdout."
msgstr ""

#: ../../source/man_marked.1.md:35
msgid ""
"-i, --input [input file] Specify file input, otherwise use last argument "
"as input file. If no input file is specified, read from stdin."
msgstr ""

#: ../../source/man_marked.1.md:39
msgid "-s, --string [markdown string] Specify string input instead of a file."
msgstr ""

#: ../../source/man_marked.1.md:42
msgid ""
"-c, --config [config file] Specify config file to use instead of the "
"default `~/.marked.json` or `~/.marked.js` or `~/.marked/index.js`."
msgstr ""

#: ../../source/man_marked.1.md:45
msgid "-t, --tokens Output a token list instead of html."
msgstr ""

#: ../../source/man_marked.1.md:48
msgid "-n, --no-clobber Do not overwrite `output` if it exists."
msgstr ""

#: ../../source/man_marked.1.md:51
msgid ""
"--pedantic Conform to obscure parts of markdown.pl as much as possible. "
"Don't fix original markdown bugs."
msgstr ""

#: ../../source/man_marked.1.md:55
msgid "--gfm Enable github flavored markdown."
msgstr ""

#: ../../source/man_marked.1.md:58
msgid "--breaks Enable GFM line breaks. Only works with the gfm option."
msgstr ""

#: ../../source/man_marked.1.md:61
msgid "--no-breaks, -no-etc... The inverse of any of the marked options above."
msgstr ""

#: ../../source/man_marked.1.md:64
msgid "--silent Silence error output."
msgstr ""

#: ../../source/man_marked.1.md:67
msgid "-h, --help Display help information."
msgstr ""

#: ../../source/man_marked.1.md:70
msgid "CONFIGURATION"
msgstr ""

#: ../../source/man_marked.1.md:72
msgid "For configuring and running programmatically."
msgstr ""

