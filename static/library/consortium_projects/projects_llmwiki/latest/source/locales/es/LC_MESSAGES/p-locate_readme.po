#: ../../source/p-locate_readme.md:40
msgid "API"
msgstr ""

#: ../../source/p-locate_readme.md:42
msgid "pLocate(input, tester, [options])"
msgstr ""

#: ../../source/p-locate_readme.md:44
msgid ""
"Returns a `Promise` that is fulfilled when `tester` resolves to `true` or"
" the iterable is done, or rejects if any of the promises reject. The "
"fulfilled value is the current iterable value or `undefined` if `tester` "
"never resolved to `true`."
msgstr ""

#: ../../source/p-locate_readme.md:46
msgid "input"
msgstr ""

#: ../../source/p-locate_readme.md:48
msgid "Type: `Iterable<Promise | unknown>`"
msgstr ""

#: ../../source/p-locate_readme.md:50
msgid "An iterable of promises/values to test."
msgstr ""

#: ../../source/p-locate_readme.md:52
msgid "tester(element)"
msgstr ""

#: ../../source/p-locate_readme.md:54
msgid "Type: `Function`"
msgstr ""

#: ../../source/p-locate_readme.md:56
msgid ""
"This function will receive resolved values from `input` and is expected "
"to return a `Promise<boolean>` or `boolean`."
msgstr ""

#: ../../source/p-locate_readme.md:58
msgid "options"
msgstr ""

#: ../../source/p-locate_readme.md:60
msgid "Type: `Object`"
msgstr ""

#: ../../source/p-locate_readme.md:62
msgid "concurrency"
msgstr ""

#: ../../source/p-locate_readme.md:64
msgid "Type: `number`<br> Default: `Infinity`<br> Minimum: `1`"
msgstr ""

#: ../../source/p-locate_readme.md:68
msgid "Number of concurrently pending promises returned by `tester`."
msgstr ""

#: ../../source/p-locate_readme.md:70
msgid "preserveOrder"
msgstr ""

#: ../../source/p-locate_readme.md:72
msgid "Type: `boolean`<br> Default: `true`"
msgstr ""

#: ../../source/p-locate_readme.md:75
msgid "Preserve `input` order when searching."
msgstr ""

#: ../../source/p-locate_readme.md:77
msgid "Disable this to improve performance if you don't care about the order."
msgstr ""

