msgid "`scripts/setup.py` — OAuth2 setup (run once to authorize)"
msgstr ""

#: ../../source/google-workspace_SKILL.md:41
msgid "`scripts/gws_bridge.py` — Token refresh bridge to gws CLI"
msgstr ""

#: ../../source/google-workspace_SKILL.md:42
