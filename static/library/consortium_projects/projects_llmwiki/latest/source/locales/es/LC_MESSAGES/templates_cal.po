msgid ""
"**UI Medium**: `Cal Sans UI Medium` — medium-weight variant (500) for "
"emphasized captions"
msgstr ""

#: ../../source/templates_cal.md:74
msgid "**Mono**: `Roboto Mono` — for code blocks and technical content"
msgstr ""

#: ../../source/templates_cal.md:75
msgid ""
"**Tertiary**: `Matter Regular` / `Matter SemiBold` / `Matter Medium` — "
"additional body fonts for specific contexts"
