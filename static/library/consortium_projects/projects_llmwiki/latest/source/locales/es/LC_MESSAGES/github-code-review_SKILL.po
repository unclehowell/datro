#: ../../source/github-code-review_SKILL.md:279
msgid "3. Review Checklist"
msgstr ""

#: ../../source/github-code-review_SKILL.md:281
msgid "When performing a code review (local or PR), systematically check:"
msgstr ""

#: ../../source/github-code-review_SKILL.md:283
msgid "Correctness"
msgstr ""

#: ../../source/github-code-review_SKILL.md:284
msgid "Does the code do what it claims?"
msgstr ""

#: ../../source/github-code-review_SKILL.md:285
msgid "Edge cases handled (empty inputs, nulls, large data, concurrent access)?"
msgstr ""

#: ../../source/github-code-review_SKILL.md:286
msgid "Error paths handled gracefully?"
msgstr ""

#: ../../source/github-code-review_SKILL.md:288
msgid "Security"
msgstr ""

#: ../../source/github-code-review_SKILL.md:289
msgid "No hardcoded secrets, credentials, or API keys"
msgstr ""

#: ../../source/github-code-review_SKILL.md:290
msgid "Input validation on user-facing inputs"
msgstr ""

#: ../../source/github-code-review_SKILL.md:291
msgid "No SQL injection, XSS, or path traversal"
msgstr ""

#: ../../source/github-code-review_SKILL.md:292
msgid "Auth/authz checks where needed"
msgstr ""

#: ../../source/github-code-review_SKILL.md:294
msgid "Code Quality"
msgstr ""

#: ../../source/github-code-review_SKILL.md:295
msgid "Clear naming (variables, functions, classes)"
msgstr ""

#: ../../source/github-code-review_SKILL.md:296
msgid "No unnecessary complexity or premature abstraction"
msgstr ""

#: ../../source/github-code-review_SKILL.md:297
msgid "DRY — no duplicated logic that should be extracted"
msgstr ""

#: ../../source/github-code-review_SKILL.md:298
msgid "Functions are focused (single responsibility)"
msgstr ""

#: ../../source/github-code-review_SKILL.md:300
msgid "Testing"
msgstr ""

#: ../../source/github-code-review_SKILL.md:301
msgid "New code paths tested?"
msgstr ""

#: ../../source/github-code-review_SKILL.md:302
msgid "Happy path and error cases covered?"
msgstr ""

#: ../../source/github-code-review_SKILL.md:303
msgid "Tests readable and maintainable?"
msgstr ""

#: ../../source/github-code-review_SKILL.md:305
msgid "Performance"
msgstr ""

#: ../../source/github-code-review_SKILL.md:306
msgid "No N+1 queries or unnecessary loops"
msgstr ""

#: ../../source/github-code-review_SKILL.md:307
msgid "Appropriate caching where beneficial"
msgstr ""

#: ../../source/github-code-review_SKILL.md:308
msgid "No blocking operations in async code paths"
msgstr ""

#: ../../source/github-code-review_SKILL.md:310
msgid "Documentation"
msgstr ""

#: ../../source/github-code-review_SKILL.md:311
msgid "Public APIs documented"
msgstr ""

#: ../../source/github-code-review_SKILL.md:312
msgid "Non-obvious logic has comments explaining \"why\""
msgstr ""

#: ../../source/github-code-review_SKILL.md:313
msgid "README updated if behavior changed"
msgstr ""

