#: ../../source/codex_SKILL.md:33
msgid "Minimal harness example (run in your repo):"
msgstr ""

#: ../../source/codex_SKILL.md:35
msgid "Create worktree:"
msgstr ""

#: ../../source/codex_SKILL.md:36
msgid "`git worktree add -b codex/<task> /tmp/codex-<task> origin/main`"
msgstr ""

#: ../../source/codex_SKILL.md:37
msgid "Run Codex in that worktree:"
msgstr ""

#: ../../source/codex_SKILL.md:38
msgid "`codex exec '<task instructions> (run tests; commit when done)'`"
msgstr ""

#: ../../source/codex_SKILL.md:39
msgid "Verify:"
msgstr ""

#: ../../source/codex_SKILL.md:40
msgid "`git -C /tmp/codex-<task> status -sb`"
msgstr ""

#: ../../source/codex_SKILL.md:41
msgid "run `pytest`/`npm test`/etc."
msgstr ""

#: ../../source/codex_SKILL.md:42
msgid "Push + PR:"
msgstr ""

#: ../../source/codex_SKILL.md:43
msgid "`git -C /tmp/codex-<task> push -u origin codex/<task>`"
msgstr ""

#: ../../source/codex_SKILL.md:44
msgid "`gh pr create ...`"
msgstr ""

#: ../../source/codex_SKILL.md:46
msgid ""
"This harness pattern prevents “dirty working tree” issues, makes "
