msgstr ""

#: ../../source/codex_SKILL.md:22
msgid "Use `pty=true` in terminal calls — Codex is an interactive terminal app"
msgstr ""

#: ../../source/codex_SKILL.md:24
msgid "Harness (recommended “Codex harness” pattern)"
msgstr ""

#: ../../source/codex_SKILL.md:26
msgid "For reliable, repeatable Codex runs, wrap Codex in a *harness* that:"
msgstr ""

#: ../../source/codex_SKILL.md:28
msgid ""
"Creates an isolated git worktree/clone (so Codex doesn’t clobber your "
"main tree)"
msgstr ""

#: ../../source/codex_SKILL.md:29
msgid "Pins a clear base branch and working branch name"
msgstr ""

#: ../../source/codex_SKILL.md:30
msgid "Runs tests/formatters before declaring success"
msgstr ""

#: ../../source/codex_SKILL.md:31
msgid "Writes an artifact (log) you can inspect later"
