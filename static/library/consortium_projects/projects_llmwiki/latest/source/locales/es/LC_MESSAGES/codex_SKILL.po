msgid ""
"Delegate coding tasks to [Codex](https://github.com/openai/codex) via the"
" Hermes terminal. Codex is OpenAI's autonomous coding agent CLI."
msgstr ""

#: ../../source/codex_SKILL.md:17
msgid "Prerequisites"
msgstr ""

#: ../../source/codex_SKILL.md:19
msgid "Codex installed: `npm install -g @openai/codex`"
msgstr ""

