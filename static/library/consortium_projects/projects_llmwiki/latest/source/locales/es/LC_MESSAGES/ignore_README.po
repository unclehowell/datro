#: ../../source/ignore_README.md:99
msgid "'`/*.js`' should only match '`a.js`', but not '`abc/a.js`'."
msgstr ""

#: ../../source/ignore_README.md:100
msgid "'`**/foo`' should match '`foo`' anywhere."
msgstr ""

#: ../../source/ignore_README.md:101
msgid ""
"Prevent re-including a file if a parent directory of that file is "
"excluded."
