msgid "tr46.js"
msgstr ""

#: ../../source/tr46_README.md:3
msgid ""
"An implementation of the [Unicode TR46 "
"specification](http://unicode.org/reports/tr46/)."
msgstr ""

#: ../../source/tr46_README.md:6
msgid "Installation"
msgstr ""

#: ../../source/tr46_README.md:8
msgid ""
"[Node.js](http://nodejs.org) `>= 6` is required. To install, type this at"
" the command line:"
msgstr ""

#: ../../source/tr46_README.md:14
msgid "API"
msgstr ""

#: ../../source/tr46_README.md:16
msgid "`toASCII(domainName[, options])`"
msgstr ""

#: ../../source/tr46_README.md:18
msgid ""
"Converts a string of Unicode symbols to a case-folded Punycode string of "
"ASCII symbols."
msgstr ""

#: ../../source/tr46_README.md:20 ../../source/tr46_README.md:32
msgid "Available options:"
msgstr ""

#: ../../source/tr46_README.md:21 ../../source/tr46_README.md:33
msgid "[`checkBidi`](#checkBidi)"
msgstr ""

#: ../../source/tr46_README.md:22 ../../source/tr46_README.md:34
msgid "[`checkHyphens`](#checkHyphens)"
msgstr ""

#: ../../source/tr46_README.md:23 ../../source/tr46_README.md:35
msgid "[`checkJoiners`](#checkJoiners)"
msgstr ""

#: ../../source/tr46_README.md:24
msgid "[`processingOption`](#processingOption)"
msgstr ""

#: ../../source/tr46_README.md:25 ../../source/tr46_README.md:36
msgid "[`useSTD3ASCIIRules`](#useSTD3ASCIIRules)"
msgstr ""

#: ../../source/tr46_README.md:26
msgid "[`verifyDNSLength`](#verifyDNSLength)"
msgstr ""

#: ../../source/tr46_README.md:28
msgid "`toUnicode(domainName[, options])`"
msgstr ""

#: ../../source/tr46_README.md:30
msgid ""
"Converts a case-folded Punycode string of ASCII symbols to a string of "
"Unicode symbols."
msgstr ""

#: ../../source/tr46_README.md:39
msgid "Options"
msgstr ""

#: ../../source/tr46_README.md:41
msgid "`checkBidi`"
msgstr ""

#: ../../source/tr46_README.md:42
msgid ""
"Type: `Boolean`   Default value: `false`   When set to `true`, any bi-"
"directional text within the input will be checked for validation."
msgstr ""

#: ../../source/tr46_README.md:46
msgid "`checkHyphens`"
msgstr ""

#: ../../source/tr46_README.md:47
msgid ""
"Type: `Boolean`   Default value: `false`   When set to `true`, the "
"positions of any hyphen characters within the input will be checked for "
"validation."
msgstr ""

#: ../../source/tr46_README.md:51
msgid "`checkJoiners`"
msgstr ""

#: ../../source/tr46_README.md:52
msgid ""
"Type: `Boolean`   Default value: `false`   When set to `true`, any word "
"joiner characters within the input will be checked for validation."
msgstr ""

#: ../../source/tr46_README.md:56
msgid "`processingOption`"
msgstr ""

#: ../../source/tr46_README.md:57
msgid ""
"Type: `String`   Default value: `\"nontransitional\"`   When set to "
"`\"transitional\"`, symbols within the input will be validated according "
"to the older IDNA2003 protocol. When set to `\"nontransitional\"`, the "
"current IDNA2008 protocol will be used."
msgstr ""

#: ../../source/tr46_README.md:61
msgid "`useSTD3ASCIIRules`"
msgstr ""

#: ../../source/tr46_README.md:62
msgid ""
"Type: `Boolean`   Default value: `false`   When set to `true`, input will"
" be validated according to [STD3 "
"Rules](http://unicode.org/reports/tr46/#STD3_Rules)."
msgstr ""

#: ../../source/tr46_README.md:66
msgid "`verifyDNSLength`"
msgstr ""

#: ../../source/tr46_README.md:67
msgid ""
"Type: `Boolean`   Default value: `false`   When set to `true`, the length"
" of each DNS label within the input will be checked for validation."
msgstr ""

