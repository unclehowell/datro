#: ../../source/xitter_SKILL.md:21
msgid "This skill is for:"
msgstr ""

#: ../../source/xitter_SKILL.md:22
msgid "posting tweets, replies, and quote tweets"
msgstr ""

#: ../../source/xitter_SKILL.md:23
msgid "searching tweets and reading timelines"
msgstr ""

#: ../../source/xitter_SKILL.md:24
msgid "looking up users, followers, and following"
