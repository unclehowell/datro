#: ../../source/media-typer_README.md:23
msgid "typer.parse(string)"
msgstr ""

#: ../../source/media-typer_README.md:29
msgid ""
"Parse a media type string. This will return an object with the following "
"properties (examples are shown for the string `'image/svg+xml; "
"charset=utf-8'`):"
msgstr ""

#: ../../source/media-typer_README.md:32
msgid "`type`: The type of the media type (always lower case). Example: `'image'`"
msgstr ""

#: ../../source/media-typer_README.md:34
msgid ""
"`subtype`: The subtype of the media type (always lower case). Example: "
"`'svg'`"
msgstr ""

#: ../../source/media-typer_README.md:36
msgid ""
"`suffix`: The suffix of the media type (always lower case). Example: "
"`'xml'`"
msgstr ""

#: ../../source/media-typer_README.md:38
#, python-brace-format
msgid ""
"`parameters`: An object of the parameters in the media type (name of "
"parameter always lower case). Example: `{charset: 'utf-8'}`"
msgstr ""

#: ../../source/media-typer_README.md:40
msgid "typer.parse(req)"
msgstr ""

#: ../../source/media-typer_README.md:46
msgid ""
"Parse the `content-type` header from the given `req`. Short-cut for "
"`typer.parse(req.headers['content-type'])`."
msgstr ""

#: ../../source/media-typer_README.md:49
msgid "typer.parse(res)"
msgstr ""

#: ../../source/media-typer_README.md:55
msgid ""
"Parse the `content-type` header set on the given `res`. Short-cut for "
"`typer.parse(res.getHeader('content-type'))`."
msgstr ""

#: ../../source/media-typer_README.md:58
msgid "typer.format(obj)"
msgstr ""

#: ../../source/media-typer_README.md:64
msgid ""
"Format an object into a media type string. This will return a string of "
"the mime type for the given object. For the properties of the object, see"
" the documentation for `typer.parse(string)`."
msgstr ""

