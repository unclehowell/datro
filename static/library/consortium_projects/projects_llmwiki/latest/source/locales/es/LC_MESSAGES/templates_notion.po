#: ../../source/templates_notion.md:308
msgid ""
"\"Create a hero section on white background. Headline at 64px NotionInter"
" weight 700, line-height 1.00, letter-spacing -2.125px, color "
"rgba(0,0,0,0.95). Subtitle at 20px weight 600, line-height 1.40, color "
"#615d59. Blue CTA button (#0075de, 4px radius, 8px 16px padding, white "
"text) and ghost button (transparent bg, near-black text, underline on "
"hover).\""
msgstr ""

#: ../../source/templates_notion.md:309
msgid ""
"\"Design a card: white background, 1px solid rgba(0,0,0,0.1) border, 12px"
" radius. Use shadow stack: rgba(0,0,0,0.04) 0px 4px 18px, "
"rgba(0,0,0,0.027) 0px 2.025px 7.85px, rgba(0,0,0,0.02) 0px 0.8px 2.93px, "
"rgba(0,0,0,0.01) 0px 0.175px 1.04px. Title at 22px NotionInter weight "
"700, letter-spacing -0.25px. Body at 16px weight 400, color #615d59.\""
msgstr ""

#: ../../source/templates_notion.md:310
msgid ""
"\"Build a pill badge: #f2f9ff background, #097fe8 text, 9999px radius, "
"4px 8px padding, 12px NotionInter weight 600, letter-spacing 0.125px.\""
msgstr ""

#: ../../source/templates_notion.md:311
msgid ""
"\"Create navigation: white header. NotionInter 15px weight 600 for links,"
" near-black text. Blue pill CTA 'Get Notion free' right-aligned (#0075de "
"bg, white text, 4px radius).\""
msgstr ""

#: ../../source/templates_notion.md:312
msgid ""
"\"Design an alternating section layout: white sections alternate with "
"warm white (#f6f5f4) sections. Each section has 64-80px vertical padding,"
" max-width 1200px centered. Section heading at 48px weight 700, line-"
"height 1.00, letter-spacing -1.5px.\""
msgstr ""

