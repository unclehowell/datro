#: ../../source/templates_runwayml.md:179
msgid "7. Do's and Don'ts"
msgstr ""

#: ../../source/templates_runwayml.md:181
msgid "Do"
msgstr ""

#: ../../source/templates_runwayml.md:182
msgid "Use full-bleed cinematic photography as the primary visual element"
msgstr ""

#: ../../source/templates_runwayml.md:183
msgid "Use abcNormal for all text — maintain the single-typeface commitment"
msgstr ""

#: ../../source/templates_runwayml.md:184
msgid ""
"Keep display line-heights at 1.0 with negative letter-spacing for film-"
"title density"
msgstr ""

#: ../../source/templates_runwayml.md:185
msgid "Use the cool-gray neutral palette (#767d88, #7d848e) for secondary text"
msgstr ""

#: ../../source/templates_runwayml.md:186
msgid ""
"Maintain zero shadows — depth comes from photography and section "
"backgrounds"
msgstr ""

#: ../../source/templates_runwayml.md:187
msgid ""
"Use uppercase with letter-spacing for navigational labels (14px, 0.35px "
"spacing)"
msgstr ""

#: ../../source/templates_runwayml.md:188
msgid "Apply small border-radius (4–8px) — the design is NOT pill-shaped"
msgstr ""

#: ../../source/templates_runwayml.md:189
msgid "Let visual content (photos, videos) dominate — the UI should be invisible"
msgstr ""

#: ../../source/templates_runwayml.md:190
msgid "Use weight 450 for micro labels — the precision matters"
msgstr ""

#: ../../source/templates_runwayml.md:192
msgid "Don't"
msgstr ""

#: ../../source/templates_runwayml.md:193
msgid ""
"Don't add decorative colors to the interface — the only color comes from "
"photography"
msgstr ""

#: ../../source/templates_runwayml.md:194
msgid ""
"Don't use heavy borders or shadows — the interface must be nearly "
"invisible"
msgstr ""

#: ../../source/templates_runwayml.md:195
msgid ""
"Don't use pill-shaped radius — Runway's geometry is subtly rounded, not "
"circular"
msgstr ""

#: ../../source/templates_runwayml.md:196
msgid ""
"Don't use bold (700+) weight — 400–600 is the full range, with 450 as a "
"precision tool"
msgstr ""

#: ../../source/templates_runwayml.md:197
msgid ""
"Don't compete with the visual content — text overlays should be minimal "
"and restrained"
msgstr ""

#: ../../source/templates_runwayml.md:198
msgid ""
"Don't use gradient backgrounds in the interface — gradients exist only in"
" photography"
msgstr ""

#: ../../source/templates_runwayml.md:199
msgid "Don't use more than one typeface — abcNormal handles everything"
msgstr ""

#: ../../source/templates_runwayml.md:200
msgid "Don't use body line-height above 1.50 — the tight, editorial feel is core"
msgstr ""

#: ../../source/templates_runwayml.md:201
msgid "Don't reduce image quality — cinematic photography IS the design"
msgstr ""

