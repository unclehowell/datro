#: ../../source/templates_runwayml.md:244
msgid "Example Component Prompts"
msgstr ""

#: ../../source/templates_runwayml.md:245
msgid ""
"\"Create a cinematic hero section: full-bleed dark background with a "
"cinematic image overlay. Headline at 48px abcNormal weight 400, line-"
"height 1.0, letter-spacing -1.2px in white. Minimal text below in Cool "
"Slate (#767d88) at 16px.\""
msgstr ""

#: ../../source/templates_runwayml.md:246
msgid ""
"\"Design a research article grid: one large card (50% width) with a "
"cinematic image and 24px title, next to two smaller cards stacked. All "
"images with 8px border-radius. Titles in white (dark bg) or Charcoal "
"(#404040, light bg).\""
msgstr ""

#: ../../source/templates_runwayml.md:247
msgid ""
"\"Build a section label: 14px abcNormal weight 500, uppercase, letter-"
"spacing 0.35px in Cool Slate (#767d88). No border, no background.\""
msgstr ""

#: ../../source/templates_runwayml.md:248
msgid ""
"\"Create a trust bar: company logos in monochrome, horizontal layout with"
" generous spacing. On dark background with white/gray logo treatments.\""
msgstr ""

#: ../../source/templates_runwayml.md:249
msgid ""
"\"Design a mission statement section: Runway Black background, white text"
" at 36px abcNormal, line-height 1.0, letter-spacing -0.9px. Centered, "
"with generous vertical padding.\""
msgstr ""

#: ../../source/templates_runwayml.md:251
msgid "Iteration Guide"
msgstr ""

#: ../../source/templates_runwayml.md:252
msgid "Visual content first — always include cinematic photography"
msgstr ""

#: ../../source/templates_runwayml.md:253
msgid ""
"Use abcNormal for everything — specify size and weight, never change the "
"font"
msgstr ""

#: ../../source/templates_runwayml.md:254
msgid ""
"Keep the interface invisible — no heavy borders, no shadows, no bright "
"colors"
msgstr ""

#: ../../source/templates_runwayml.md:255
msgid ""
"Use the cool slate grays (#767d88, #7d848e) for secondary text — not warm"
" grays"
msgstr ""

#: ../../source/templates_runwayml.md:256
msgid "Uppercase labels need letter-spacing (0.35px) — never tight uppercase"
msgstr ""

#: ../../source/templates_runwayml.md:257
msgid ""
"Dark sections should be truly dark (#000000 or #1a1a1a) — no medium grays"
" as surfaces"
msgstr ""

