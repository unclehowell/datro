msgstr ""

#: ../../source/templates_figma.md:185
msgid "Enable `\"kern\"` feature on all text"
msgstr ""

#: ../../source/templates_figma.md:186
msgid "Use figmaMono in uppercase with positive letter-spacing for labels"
msgstr ""

#: ../../source/templates_figma.md:187
msgid "Apply negative letter-spacing throughout (-0.1px to -1.72px)"
msgstr ""

#: ../../source/templates_figma.md:189
msgid "Don't"
msgstr ""

#: ../../source/templates_figma.md:190
msgid "Don't add interface colors — the monochrome palette is absolute"
msgstr ""

#: ../../source/templates_figma.md:191
msgid ""
"Don't use standard font weights (400, 500, 600, 700) — use the variable "
"font's unique stops (320, 330, 340, 450, 480, 540)"
