#: ../../source/templates_figma.md:193
msgid "Don't use solid focus outlines — dashed is the signature"
msgstr ""

#: ../../source/templates_figma.md:194
msgid ""
"Don't increase body font weight above 450 — the light-weight aesthetic is"
" core"
