#: ../../source/templates_figma.md:178
msgid "7. Do's and Don'ts"
msgstr ""

#: ../../source/templates_figma.md:180
msgid "Do"
msgstr ""

#: ../../source/templates_figma.md:181
msgid ""
"Use figmaSans with precise variable weights (320–540) — the granular "
"weight control IS the design"
msgstr ""

#: ../../source/templates_figma.md:182
msgid ""
"Keep the interface strictly black-and-white — color comes from product "
"content only"
msgstr ""

#: ../../source/templates_figma.md:183
msgid "Use pill (50px) and circular (50%) geometry for all interactive elements"
msgstr ""

#: ../../source/templates_figma.md:184
