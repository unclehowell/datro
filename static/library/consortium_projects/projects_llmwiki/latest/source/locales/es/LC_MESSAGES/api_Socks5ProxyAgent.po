msgstr ""

#: ../../source/api_Socks5ProxyAgent.md:255
msgid "Performance Considerations"
msgstr ""

#: ../../source/api_Socks5ProxyAgent.md:257
msgid ""
"**Connection Pooling**: Automatically pools connections through the "
"SOCKS5 tunnel for better performance"
msgstr ""

#: ../../source/api_Socks5ProxyAgent.md:258
msgid "**HTTP/1.1 Pipelining**: Supports pipelining when enabled"
msgstr ""

#: ../../source/api_Socks5ProxyAgent.md:259
msgid ""
"**DNS Resolution**: Domain names are resolved by the SOCKS5 proxy, "
"reducing local DNS queries"
msgstr ""

#: ../../source/api_Socks5ProxyAgent.md:260
msgid ""
"**TLS Termination**: HTTPS connections are encrypted end-to-end, with the"
" SOCKS5 proxy only handling the TCP tunnel"
msgstr ""

#: ../../source/api_Socks5ProxyAgent.md:262
msgid "Security Notes"
msgstr ""

#: ../../source/api_Socks5ProxyAgent.md:264
msgid ""
"**Authentication**: Credentials are sent to the SOCKS5 proxy in plaintext"
" unless using SOCKS5 over TLS"
msgstr ""

#: ../../source/api_Socks5ProxyAgent.md:265
msgid ""
"**DNS Leaks**: All DNS resolution happens on the proxy server, preventing"
" DNS leaks"
msgstr ""

#: ../../source/api_Socks5ProxyAgent.md:266
msgid ""
"**End-to-end Encryption**: HTTPS traffic remains encrypted between client"
" and final destination"
msgstr ""

#: ../../source/api_Socks5ProxyAgent.md:267
msgid ""
"**Connection Security**: Consider using authenticated proxies and secure "
"networks"
msgstr ""

#: ../../source/api_Socks5ProxyAgent.md:269
msgid "Compatibility"
msgstr ""

#: ../../source/api_Socks5ProxyAgent.md:271
msgid ""
"**Protocol**: SOCKS5 (RFC 1928) with Username/Password Authentication "
"(RFC 1929)"
msgstr ""

#: ../../source/api_Socks5ProxyAgent.md:272
msgid "**Transport**: TCP only (UDP support not implemented)"
msgstr ""

#: ../../source/api_Socks5ProxyAgent.md:273
msgid "**Node.js**: Compatible with all supported Node.js versions"
msgstr ""

#: ../../source/api_Socks5ProxyAgent.md:274
msgid "**HTTP Versions**: Works with HTTP/1.1 and HTTP/2 over the tunnel"
msgstr ""

