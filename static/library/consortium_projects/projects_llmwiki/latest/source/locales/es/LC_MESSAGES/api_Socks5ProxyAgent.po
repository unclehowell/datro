msgstr ""

#: ../../source/api_Socks5ProxyAgent.md:228
msgid "The Socks5ProxyAgent supports the following SOCKS5 features:"
msgstr ""

#: ../../source/api_Socks5ProxyAgent.md:230
msgid "Authentication Methods"
msgstr ""

#: ../../source/api_Socks5ProxyAgent.md:232
msgid "**No Authentication** (`0x00`) - For public or internal proxies"
msgstr ""

#: ../../source/api_Socks5ProxyAgent.md:233
msgid "**Username/Password** (`0x02`) - RFC 1929 authentication"
msgstr ""

#: ../../source/api_Socks5ProxyAgent.md:235
msgid "Address Types"
msgstr ""

#: ../../source/api_Socks5ProxyAgent.md:237
msgid "**IPv4** (`0x01`) - Standard IPv4 addresses"
msgstr ""

#: ../../source/api_Socks5ProxyAgent.md:238
msgid "**Domain Name** (`0x03`) - Domain names (recommended for flexibility)"
msgstr ""

#: ../../source/api_Socks5ProxyAgent.md:239
msgid ""
"**IPv6** (`0x04`) - IPv6 addresses (full support for standard and "
"compressed notation)"
msgstr ""

#: ../../source/api_Socks5ProxyAgent.md:241
msgid "Commands"
msgstr ""

#: ../../source/api_Socks5ProxyAgent.md:243
msgid ""
"**CONNECT** (`0x01`) - Establish TCP connection (primary use case for "
"HTTP)"
msgstr ""

