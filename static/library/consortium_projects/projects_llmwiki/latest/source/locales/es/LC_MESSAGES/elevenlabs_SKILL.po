msgid "Save to File"
msgstr ""

#: ../../source/elevenlabs_SKILL.md
msgid "`python scripts/tts.py \"Hello\" --output \"hello.mp3\"`"
msgstr ""

#: ../../source/elevenlabs_SKILL.md:34
msgid "Procedure"
msgstr ""

#: ../../source/elevenlabs_SKILL.md:35
msgid "**Authentication:** Ensure `ELEVENLABS_API_KEY` is set in the environment."
msgstr ""

#: ../../source/elevenlabs_SKILL.md:36
msgid "**Voice Identification:** Select a voice name or ID."
msgstr ""

#: ../../source/elevenlabs_SKILL.md:37
msgid "**Generation:** Call the ElevenLabs API via a helper script or `curl`."
msgstr ""

#: ../../source/elevenlabs_SKILL.md:38
msgid ""
"**Verification:** Check for the existence and size of the output audio "
"file."
msgstr ""

#: ../../source/elevenlabs_SKILL.md:40
msgid "Pitfalls"
msgstr ""

#: ../../source/elevenlabs_SKILL.md:41
msgid "**Credit Limits:** TTS generation consumes ElevenLabs characters/credits."
msgstr ""

#: ../../source/elevenlabs_SKILL.md:42
msgid "**Latency:** API calls may take a few seconds to process."
msgstr ""

#: ../../source/elevenlabs_SKILL.md:43
msgid "**Invalid Voice ID:** Using a non-existent voice ID will cause an error."
msgstr ""

