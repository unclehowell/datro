msgid ""
"This skill allows the agent to interact with the ElevenLabs API for high-"
"quality text-to-speech (TTS) generation."
msgstr ""

#: ../../source/elevenlabs_SKILL.md:22
msgid "When to Use"
msgstr ""

#: ../../source/elevenlabs_SKILL.md:23
msgid "Converting text into spoken audio files."
msgstr ""

#: ../../source/elevenlabs_SKILL.md:24
msgid "Creating voice responses for messages or stories."
msgstr ""

#: ../../source/elevenlabs_SKILL.md:25
msgid "Testing different voices or audio qualities."
msgstr ""

