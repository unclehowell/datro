msgid "Task"
msgstr ""

#: ../../source/elevenlabs_SKILL.md
msgid "Command"
msgstr ""

#: ../../source/elevenlabs_SKILL.md
msgid "Simple TTS"
msgstr ""

#: ../../source/elevenlabs_SKILL.md
msgid "`python scripts/tts.py \"Hello world\"`"
msgstr ""

#: ../../source/elevenlabs_SKILL.md
msgid "Select Voice"
msgstr ""

#: ../../source/elevenlabs_SKILL.md
msgid "`python scripts/tts.py \"Hello\" --voice \"Adam\"`"
msgstr ""

