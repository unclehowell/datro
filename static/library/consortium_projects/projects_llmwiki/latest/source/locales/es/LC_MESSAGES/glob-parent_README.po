#: ../../source/glob-parent_README.md:54
msgid ""
"The following characters have special significance in glob patterns and "
"must be escaped if you want them to be treated as regular path "
"characters:"
msgstr ""

#: ../../source/glob-parent_README.md:56
msgid "`?` (question mark) unless used as a path segment alone"
msgstr ""

#: ../../source/glob-parent_README.md:57
msgid "`*` (asterisk)"
msgstr ""

#: ../../source/glob-parent_README.md:58
msgid "`|` (pipe)"
msgstr ""

#: ../../source/glob-parent_README.md:59
msgid "`(` (opening parenthesis)"
msgstr ""

#: ../../source/glob-parent_README.md:60
msgid "`)` (closing parenthesis)"
msgstr ""

#: ../../source/glob-parent_README.md:61
msgid "`{` (opening curly brace)"
msgstr ""

#: ../../source/glob-parent_README.md:62
