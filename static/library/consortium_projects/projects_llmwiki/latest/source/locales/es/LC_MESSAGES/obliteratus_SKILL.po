#: ../../source/obliteratus_SKILL.md:111
msgid "9 CLI Methods"
msgstr ""

#: ../../source/obliteratus_SKILL.md:112
msgid ""
"**basic** — Single refusal direction via diff-in-means. Fast (~5-10 min "
"for 8B)."
msgstr ""

#: ../../source/obliteratus_SKILL.md:113
msgid ""
"**advanced** (DEFAULT, RECOMMENDED) — Multiple SVD directions, norm-"
"preserving projection, 2 refinement passes. Medium speed (~10-20 min)."
msgstr ""

#: ../../source/obliteratus_SKILL.md:114
msgid ""
"**aggressive** — Whitened SVD + jailbreak-contrastive + attention head "
"surgery. Higher risk of coherence damage."
msgstr ""

#: ../../source/obliteratus_SKILL.md:115
msgid ""
"**spectral_cascade** — DCT frequency-domain decomposition. Research/novel"
" approach."
msgstr ""

#: ../../source/obliteratus_SKILL.md:116
msgid ""
"**informed** — Runs analysis DURING abliteration to auto-configure. "
"Experimental — slower and less predictable than advanced."
msgstr ""

#: ../../source/obliteratus_SKILL.md:117
msgid ""
"**surgical** — SAE features + neuron masking + head surgery + per-expert."
" Very slow (~1-2 hrs). Best for reasoning models."
msgstr ""

#: ../../source/obliteratus_SKILL.md:118
msgid ""
"**optimized** — Bayesian hyperparameter search (Optuna TPE). Longest "
"runtime but finds optimal parameters."
msgstr ""

#: ../../source/obliteratus_SKILL.md:119
msgid ""
"**inverted** — Flips the refusal direction. Model becomes actively "
"willing."
msgstr ""

#: ../../source/obliteratus_SKILL.md:120
msgid ""
"**nuclear** — Maximum force combo for stubborn MoE models. Expert-"
"granular."
msgstr ""

#: ../../source/obliteratus_SKILL.md:122
msgid "Direction Extraction Methods (--direction-method flag)"
msgstr ""

#: ../../source/obliteratus_SKILL.md:123
msgid ""
"**diff_means** (default) — Simple difference-in-means between "
"refused/complied activations. Robust."
msgstr ""

#: ../../source/obliteratus_SKILL.md:124
msgid "**svd** — Multi-direction SVD extraction. Better for complex alignment."
msgstr ""

#: ../../source/obliteratus_SKILL.md:125
msgid ""
"**leace** — LEACE (Linear Erasure via Closed-form Estimation). Optimal "
"linear erasure."
msgstr ""

