#: ../../source/excalidraw_SKILL.md:164
msgid "Minimum `fontSize`: **20** for titles and headings"
msgstr ""

#: ../../source/excalidraw_SKILL.md:165
msgid "Minimum `fontSize`: **14** for secondary annotations only (sparingly)"
msgstr ""

#: ../../source/excalidraw_SKILL.md:166
msgid "NEVER use `fontSize` below 14"
msgstr ""

