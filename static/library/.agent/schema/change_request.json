{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DATRO Change Request",
  "type": "object",
  "required": ["id", "project_id", "client", "description"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid",
      "description": "Associated project"
    },
    "client": {
      "type": "string",
      "const": "unclehowell"
    },
    "type": {
      "type": "string",
      "enum": ["enhancement", "bug_fix", "new_feature", "scope_change", "priority_change"]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "justification": {
      "type": "string",
      "description": "Business case for the change"
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "pending", "approved", "rejected", "in_progress", "completed"],
      "default": "draft"
    },
    "requested_by": {
      "type": "string"
    },
    "requested": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed": {
      "type": "string",
      "format": "date-time"
    },
    "resolved": {
      "type": "string",
      "format": "date-time"
    },
    "impact": {
      "type": "object",
      "properties": {
        "schedule": {"type": "string"},
        "cost": {"type": "number"},
        "scope": {"type": "string"}
      }
    }
  }
}