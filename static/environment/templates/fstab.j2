# /etc/fstab: static file system information
# <device>                                 <mount point>           <type>          <options>                      <dump>  <pass>

# Root filesystem
UUID={{ sdcard_uuid.stdout | default('ROOT_UUID') }}    /               ext4    errors=remount-ro           0       1

# SD Card as home directory (configure with actual UUID)
{% if sdcard_uuid.stdout | length > 0 %}
UUID={{ sdcard_uuid.stdout }}    /home           ext4    defaults,nofail,x-systemd.requires MountTimeout=5    0       2
{% else %}
# SD Card UUID not detected - uncomment and configure manually:
# UUID=YOUR_SD_CARD_UUID    /home           ext4    defaults,nofail,x-systemd.requires MountTimeout=5    0       2
{% endif %}

# Swap
UUID=SWAP_UUID    none            swap    sw              0       0

# Boot
UUID=BOOT_UUID    /boot           ext4    defaults        0       2

# tmpfs
tmpfs             /tmp             tmpfs   defaults,noatime,mode=1777,size=2g    0       0
tmpfs             /var/tmp         tmpfs   defaults,noatime,mode=1777,size=1g    0       0
