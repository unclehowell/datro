[Unit]
Description=PicoClaw Service Background Monitor
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/llm-dashboard
Environment=NODE_ENV=production
EnvironmentFile=/etc/picoclaw/env

# Start the PicoClaw service
ExecStart=/usr/bin/node picoclaw-service.js
ExecReload=/bin/kill -HUP $MAINPID

# Restart policy
Restart=on-failure
RestartSec=3
StandardOutput=append:/var/log/llm-dashboard/picoclaw.log
StandardError=append:/var/log/llm-dashboard/picoclaw-error.log

# PicoClaw PID for monitoring
PIDFile=/run/picoclaw/picoclaw.pid
RuntimeDirectory=pico claw
RuntimeDirectoryMode=0755

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/run/pico claw /opt/llm-dashboard/logs

[Install]
WantedBy=multi-user.target