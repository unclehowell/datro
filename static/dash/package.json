{
  "name": "llm-dashboard",
  "version": "1.0.0",
  "description": "LLM Usage Dashboard with PicoClaw monitoring",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "systemctl:install": "sudo cp llm-dashboard.service /etc/systemd/system/ && sudo systemctl daemon-reload",
    "systemctl:start": "sudo systemctl start llm-dashboard",
    "systemctl:stop": "sudo systemctl stop llm-dashboard",
    "systemctl:status": "sudo systemctl status llm-dashboard",
    "systemctl:enable": "sudo systemctl enable llm-dashboard"
  },
  "keywords": ["llm", "dashboard", "monitoring", "picoclaw"],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}