Header always unset X-Frame-Options
Header always set X-Frame-Options "ALLOW-FROM https://www.carfinancecheque.uk https://carfinancecheque.uk"
Header always set Content-Security-Policy "frame-ancestors 'self' https://www.carfinancecheque.uk https://carfinancecheque.uk"

# Explicit MIME types for static assets behind CDN/proxy layers.
AddType text/css .css
AddType application/javascript .js
AddType font/ttf .ttf
AddType font/woff .woff
AddType font/woff2 .woff2
