import fs from 'fs';
import axios from 'axios';

axios.get("https://images.unsplash.com/photo-1516937941344-00b4ec277ec3?auto=format&fit=crop&q=80&w=2000")
  .then(response => {
    const fileBuffer = Buffer.from(response.data, 'binary');
    fs.writeFileSync('static/images/image1.jpg', fileBuffer);
  })
  .catch(error => {
    console.error(error);
  });

