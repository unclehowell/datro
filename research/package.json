{
  "name": "research-wiki-mirror",
  "version": "0.1.0",
  "private": true,
  "description": "Serverless WP-shaped mirror of Great House Farm wiki on Cloudflare Workers + D1",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute research-wp-d1 --file=./schema.sql --remote",
    "db:init:local": "wrangler d1 execute research-wp-d1 --file=./schema.sql --local"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
